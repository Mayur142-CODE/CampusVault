            <p style="font-size:var(--fs-sm);color:var(--cv-slate);margin-bottom:var(--space-5);">
                The academic workspace has been registered in the university catalog and is ready for student enrollment.
            </p>

            @* Code Box in Modal *@
            <div style="background:var(--cv-slate-50);border:1px solid var(--cv-border);border-radius:var(--radius-lg);padding:var(--space-4);margin-bottom:var(--space-5);text-align:center;">
                <div style="font-size:11px;color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.05em;font-weight:var(--fw-semibold);margin-bottom:4px;">
                    Student Join Code
                </div>
                <div style="font-family:var(--font-mono, monospace);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);letter-spacing:0.08em;margin-bottom:var(--space-2);" id="modalCodeDisplay">
                    DS-EC6-2026
                </div>
                <button type="button" class="cv-btn cv-btn-secondary cv-btn-sm" onclick="copyModalCode()" style="gap:4px;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:12px;height:12px;flex-shrink:0;"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    <span>Copy Code</span>
