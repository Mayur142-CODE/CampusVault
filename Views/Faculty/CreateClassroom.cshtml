                    @* Action Buttons Preview *@
                    <div class="cv-classroom-actions-row" style="pointer-events:none;opacity:0.85;">
                        <button class="cv-btn cv-btn-primary flex-1" style="justify-content:center;gap:6px;">
                            <span>Open</span>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;flex-shrink:0;"><polyline points="9 18 15 12 9 6"/></svg>
                        </button>
                        <button class="cv-btn cv-btn-secondary">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;flex-shrink:0;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            <span>Edit</span>
                        </button>
                        <button class="cv-btn cv-btn-archive">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;flex-shrink:0;"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* 3. Faculty Institutional Tips *@
        <div class="cv-card" style="padding:var(--space-4) var(--space-5);">
            <div class="d-flex items-center gap-2 mb-2" style="color:var(--cv-navy);font-weight:var(--fw-bold);font-size:var(--fs-xs);">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px;color:var(--cv-gold);flex-shrink:0;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                University Classroom Setup Rules
            </div>
            <ul style="font-size:11px;color:var(--cv-slate);margin:0;padding-left:var(--space-4);line-height:1.6;">
                <li>Classrooms represent unique laboratory practical batches or lecture cohorts.</li>
                <li>All students using the generated join code will automatically be assigned to division <strong><span id="tipDivision">EC6</span></strong>.</li>
                <li>Coursework rubrics and practical tasks can be published immediately after creation.</li>
            </ul>
        </div>

    </div>
</div>

@* ==================== 3. SUCCESS CELEBRATION MODAL ==================== *@
<div class="cv-modal-backdrop" id="creationSuccessModal">
    <div class="cv-modal-dialog" style="max-width:480px;">
        <div class="cv-success-dialog">
            <div class="cv-success-icon-wrap">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:34px;height:34px;flex-shrink:0;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>

            <h3 style="font-size:var(--fs-xl);font-weight:var(--fw-bold);color:var(--cv-navy);margin-bottom:var(--space-1);">
                Classroom Created Successfully!
