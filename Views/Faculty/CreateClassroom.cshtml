            @* Quick Summary *@
            <div style="text-align:left;background:#f8fafc;border:1px solid var(--cv-border-light);border-radius:var(--radius-md);padding:var(--space-3) var(--space-4);font-size:12px;color:var(--cv-slate-700);margin-bottom:var(--space-6);line-height:1.6;">
                <div><strong>Classroom:</strong> <span id="modalClassroomName">Data Structures</span></div>
                <div><strong>Cohort:</strong> <span id="modalCohort">EC6 &bull; Semester 3</span></div>
                <div><strong>Department:</strong> <span id="modalDept">Computer Engineering</span></div>
            </div>

            @* Action Buttons *@
            <div style="display:flex;align-items:center;gap:var(--space-3);justify-content:center;">
                <a href="@Url.Action("Classrooms", "Faculty")" class="cv-btn cv-btn-secondary flex-1" style="justify-content:center;">
                    View All Classrooms
                </a>
                <a href="@Url.Action("ClassroomDetails", "Faculty", new { id = 1 })" class="cv-btn cv-btn-primary flex-1" style="justify-content:center;gap:6px;">
                    <span>Open Workspace</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;flex-shrink:0;"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
            </div>
        </div>
    </div>
</div>

@* ==================== 4. TOAST NOTIFICATION ==================== *@
<div class="cv-toast" id="createToast">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;color:var(--cv-emerald);flex-shrink:0;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    <span id="createToastMsg">Notice message</span>
</div>

@* ==================== 5. CLIENT LOGIC & VALIDATION SCRIPTS ==================== *@
<script>
    // Motifs definitions for subjects
    var subjectMotifs = {
        "motif-ds": '<svg class="cv-classroom-motif-bg" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="3" style="width:130px;height:130px;flex-shrink:0;"><circle cx="50" cy="20" r="10"/><circle cx="25" cy="65" r="8"/><circle cx="75" cy="65" r="8"/><line x1="43" y1="28" x2="31" y2="58"/><line x1="57" y1="28" x2="69" y2="58"/><circle cx="15" cy="90" r="5"/><circle cx="35" cy="90" r="5"/><line x1="22" y1="72" x2="17" y2="85"/><line x1="28" y1="72" x2="33" y2="85"/></svg>',
        "motif-dbms": '<svg class="cv-classroom-motif-bg" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="3" style="width:130px;height:130px;flex-shrink:0;"><ellipse cx="50" cy="25" rx="35" ry="12"/><path d="M15 25v22c0 6.6 15.7 12 35 12s35-5.4 35-12V25"/><path d="M15 47v22c0 6.6 15.7 12 35 12s35-5.4 35-12V47"/><path d="M15 69v22c0 6.6 15.7 12 35 12s35-5.4 35-12V69"/></svg>',
        "motif-web": '<svg class="cv-classroom-motif-bg" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="3" style="width:130px;height:130px;flex-shrink:0;"><rect x="10" y="20" width="80" height="60" rx="6"/><line x1="10" y1="36" x2="90" y2="36"/><circle cx="22" cy="28" r="3"/><circle cx="32" cy="28" r="3"/><circle cx="42" cy="28" r="3"/><path d="M30 55l10 10-10 10M50 75h20"/></svg>',
        "motif-oop": '<svg class="cv-classroom-motif-bg" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="3" style="width:130px;height:130px;flex-shrink:0;"><rect x="25" y="15" width="50" height="35" rx="4"/><line x1="25" y1="30" x2="75" y2="30"/><rect x="10" y="60" width="35" height="30" rx="4"/><rect x="55" y="60" width="35" height="30" rx="4"/><line x1="50" y1="50" x2="50" y2="55"/><line x1="27" y1="55" x2="73" y2="55"/><line x1="27" y1="55" x2="27" y2="60"/><line x1="73" y1="55" x2="73" y2="60"/></svg>',
        "motif-os": '<svg class="cv-classroom-motif-bg" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="3" style="width:130px;height:130px;flex-shrink:0;"><circle cx="30" cy="30" r="10"/><circle cx="70" cy="30" r="10"/><circle cx="50" cy="70" r="10"/><line x1="38" y1="35" x2="44" y2="62"/><line x1="62" y1="35" x2="56" y2="62"/><line x1="40" y1="30" x2="60" y2="30"/></svg>',
        "motif-math": '<svg class="cv-classroom-motif-bg" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="3" style="width:130px;height:130px;flex-shrink:0;"><circle cx="25" cy="25" r="9"/><circle cx="75" cy="25" r="9"/><circle cx="75" cy="75" r="9"/><circle cx="25" cy="75" r="9"/><line x1="34" y1="25" x2="66" y2="25"/><line x1="75" y1="34" x2="75" y2="66"/><line x1="66" y1="75" x2="34" y2="75"/><line x1="25" y1="66" x2="25" y2="34"/><line x1="31" y1="31" x2="69" y2="69"/></svg>'
    };

    var currentRandomSuffix = "";

    // Toast Utility
    function showToast(msg) {
        var toast = document.getElementById('createToast');
        document.getElementById('createToastMsg').innerText = msg;
        toast.classList.add('show');
        setTimeout(function () {
            toast.classList.remove('show');
        }, 3200);
    }

    // Handle Subject Selection Change
    function handleSubjectChange() {
        var subjectSelect = document.getElementById('classroomSubject');
        var selectedOpt = subjectSelect.options[subjectSelect.selectedIndex];
        var code = selectedOpt.getAttribute('data-code');
        document.getElementById('courseCode').value = code;

        // Auto-update Classroom Name if default or empty
        var nameInput = document.getElementById('classroomName');
        if (!nameInput.value || nameInput.value === "Data Structures" || nameInput.value === "Database Management Systems" || nameInput.value === "Web Technology" || nameInput.value === "Object Oriented Programming" || nameInput.value === "Computer Networks" || nameInput.value === "Design & Analysis of Algorithms") {
            nameInput.value = selectedOpt.value;
        }

        updateGeneratedCode();
    }

    // Generate Classroom Code (e.g. DS-EC6-2026)
    function updateGeneratedCode() {
        var subjectSelect = document.getElementById('classroomSubject');
        var selectedOpt = subjectSelect.options[subjectSelect.selectedIndex];
        var prefix = selectedOpt.getAttribute('data-prefix') || "CRS";
        var division = document.getElementById('division').value || "EC6";

        var yearSelect = document.getElementById('academicYear');
        var selectedYearOpt = yearSelect.options[yearSelect.selectedIndex];
        var yearShort = selectedYearOpt.getAttribute('data-short') || "2026";

        var code = prefix + "-" + division + "-" + yearShort;
        if (currentRandomSuffix) {
            code += "-" + currentRandomSuffix;
        }

        document.getElementById('generatedCodeDisplay').innerText = code;
        document.getElementById('previewCodeBadgeText').innerText = code;
        document.getElementById('modalCodeDisplay').innerText = code;
    }

    function regenerateCodeSuffix() {
        var chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        var res = "";
        for (var i = 0; i < 2; i++) {
            res += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        currentRandomSuffix = res;
        updateGeneratedCode();
        showToast("Classroom code regenerated!");
    }

    // 1-Click Copy Generated Code
    function copyGeneratedCode() {
        var code = document.getElementById('generatedCodeDisplay').innerText;
        copyText(code);
    }

    function copyModalCode() {
        var code = document.getElementById('modalCodeDisplay').innerText;
        copyText(code);
    }

    function copyText(text) {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(function () {
                showToast('Classroom code "' + text + '" copied to clipboard!');
            });
        } else {
            showToast('Classroom code: ' + text);
        }
    }

    // Real-Time Live Card Preview Synchronizer
    function updatePreview() {
        var name = document.getElementById('classroomName').value || "Untitled Classroom";
        var code = document.getElementById('courseCode').value || "CS000";
        var division = document.getElementById('division').value || "EC6";
        var semester = document.getElementById('semester').value || "Semester 3";
        var schedule = document.getElementById('roomSchedule').value || "Schedule pending";

        // Update Title
        document.getElementById('previewTitle').innerText = name;
        document.getElementById('previewCodePill').innerText = code;
        document.getElementById('previewCohortPill').innerHTML = division + " &bull; " + semester;
        document.getElementById('previewSchedule').innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:12px;height:12px;flex-shrink:0;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> ' + schedule;
        document.getElementById('tipDivision').innerText = division;

        // Update Motif Banner Class and SVG
        var subjectSelect = document.getElementById('classroomSubject');
        var selectedOpt = subjectSelect.options[subjectSelect.selectedIndex];
        var motifClass = selectedOpt.getAttribute('data-motif') || "motif-ds";

        var banner = document.getElementById('previewBanner');
        banner.className = "cv-classroom-banner " + motifClass;

        var motifSvg = subjectMotifs[motifClass] || subjectMotifs["motif-ds"];
        document.getElementById('previewMotifContainer').innerHTML = motifSvg;
    }

    // Field-level Validation
    function validateField(fieldId) {
        var field = document.getElementById(fieldId);
        var errEl = null;

        if (fieldId === 'classroomName') {
            errEl = document.getElementById('errClassroomName');
            var val = (field.value || '').trim();
            if (val.length < 3) {
                field.classList.add('cv-input-error');
                errEl.classList.add('show');
                return false;
            } else {
                field.classList.remove('cv-input-error');
                errEl.classList.remove('show');
                return true;
            }
        }

        if (fieldId === 'classroomSubject') {
            errEl = document.getElementById('errClassroomSubject');
            if (!field.value) {
                field.classList.add('cv-input-error');
                errEl.classList.add('show');
                return false;
            } else {
                field.classList.remove('cv-input-error');
                errEl.classList.remove('show');
                return true;
            }
        }

        return true;
    }

    // Submit & Form Validation
    function submitCreateClassroom() {
        var isNameValid = validateField('classroomName');
        var isSubjectValid = validateField('classroomSubject');

        if (!isNameValid) {
            document.getElementById('classroomName').focus();
            showToast("Please enter a valid classroom name (min 3 characters).");
            return;
        }

        if (!isSubjectValid) {
            document.getElementById('classroomSubject').focus();
            showToast("Please select a subject.");
            return;
        }

        var code = document.getElementById('generatedCodeDisplay').innerText.trim();
        document.getElementById('joinCodeInput').value = code;

        var subjectSelect = document.getElementById('classroomSubject');
        var selectedOpt = subjectSelect.options[subjectSelect.selectedIndex];
        var motifClass = (selectedOpt && selectedOpt.getAttribute('data-motif')) || "motif-ds";
        var gradientMap = {
            "motif-ds": "linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%)",
            "motif-dbms": "linear-gradient(135deg, #065f46 0%, #10b981 100%)",
            "motif-web": "linear-gradient(135deg, #7c2d12 0%, #f97316 100%)",
            "motif-oop": "linear-gradient(135deg, #4c1d95 0%, #8b5cf6 100%)",
            "motif-os": "linear-gradient(135deg, #1f2937 0%, #4b5563 100%)",
            "motif-math": "linear-gradient(135deg, #831843 0%, #ec4899 100%)"
        };
        document.getElementById('themeGradientInput').value = gradientMap[motifClass] || "linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%)";

        document.getElementById('createClassroomForm').submit();
    }

    // Initialize on DOM load
    document.addEventListener("DOMContentLoaded", function () {
        updateGeneratedCode();
        updatePreview();
    });
</script>
