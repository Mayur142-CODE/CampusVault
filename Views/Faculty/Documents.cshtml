@* ==================== 5. JAVASCRIPT LOGIC ==================== *@
<script>
    function onClassroomChanged() {
        var cls = document.getElementById("docFilterClassroom").value;
        var subSelect = document.getElementById("docFilterSubject");
        
        if (cls.indexOf("Data Structures") > -1) subSelect.value = "Data Structures";
        else if (cls.indexOf("DBMS") > -1) subSelect.value = "DBMS";
        else if (cls.indexOf("Web Technology") > -1) subSelect.value = "Web Technology";
        else if (cls.indexOf("OOP") > -1) subSelect.value = "OOP";
        else if (cls.indexOf("Computer Networks") > -1) subSelect.value = "Computer Networks";
        else subSelect.value = "all";

        applyDocumentFilters();
    }

    function applyDocumentFilters() {
        var studentQuery = (document.getElementById("docFilterStudent").value || "").toLowerCase().trim();
        var selectedClassroom = document.getElementById("docFilterClassroom").value;
        var selectedSubject = document.getElementById("docFilterSubject").value;
        var selectedTask = document.getElementById("docFilterTask").value;
        var selectedStatus = document.getElementById("docFilterStatus").value;
        var selectedVersion = document.getElementById("docFilterVersion").value;

        var rows = document.querySelectorAll("#facDocsTableBody .doc-row");
        var visibleCount = 0;

        rows.forEach(function(row) {
            var filename = (row.getAttribute("data-filename") || "").toLowerCase();
            var student = (row.getAttribute("data-student") || "").toLowerCase();
            var classroom = row.getAttribute("data-classroom") || "";
            var subject = row.getAttribute("data-subject") || "";
            var task = row.getAttribute("data-task") || "";
            var status = row.getAttribute("data-status") || "";
            var version = row.getAttribute("data-version") || "";

            // 1. Student / Roll query
            var matchesStudent = true;
            if (studentQuery.length > 0) {
                matchesStudent = (student.indexOf(studentQuery) > -1 || filename.indexOf(studentQuery) > -1);
            }

            // 2. Classroom
            var matchesClassroom = true;
            if (selectedClassroom !== "all") {
                matchesClassroom = (classroom === selectedClassroom);
            }

            // 3. Subject
            var matchesSubject = true;
            if (selectedSubject !== "all") {
                matchesSubject = (subject === selectedSubject);
            }

            // 4. Task
            var matchesTask = true;
            if (selectedTask !== "all") {
                matchesTask = (task.indexOf(selectedTask) > -1);
            }

            // 5. Status
            var matchesStatus = true;
            if (selectedStatus !== "all") {
                matchesStatus = (status.indexOf(selectedStatus) > -1);
            }

            // 6. Version
            var matchesVersion = true;
            if (selectedVersion !== "all") {
                matchesVersion = (version === selectedVersion);
            }

            if (matchesStudent && matchesClassroom && matchesSubject && matchesTask && matchesStatus && matchesVersion) {
                row.style.display = "";
                visibleCount++;
            } else {
                row.style.display = "none";
            }
        });

        var countEl = document.getElementById("visibleDocCount");
        if (countEl) countEl.textContent = visibleCount;

        var emptyEl = document.getElementById("emptyFacDocsState");
        var tableEl = document.getElementById("facDocsMasterTable");
        if (emptyEl && tableEl) {
            if (visibleCount === 0) {
                emptyEl.style.display = "block";
                tableEl.style.display = "none";
            } else {
                emptyEl.style.display = "none";
                tableEl.style.display = "table";
            }
        }
    }

    function resetDocFilters() {
        document.getElementById("docFilterStudent").value = "";
        document.getElementById("docFilterClassroom").value = "all";
        document.getElementById("docFilterSubject").value = "all";
        document.getElementById("docFilterTask").value = "all";
        document.getElementById("docFilterStatus").value = "all";
        document.getElementById("docFilterVersion").value = "all";

        applyDocumentFilters();
    }

    // Quick Modal Preview
    var activeModalFilename = "";
    function previewDocModal(filename, student, task, version, status, size, date) {
        activeModalFilename = filename;
        document.getElementById("modalDocFilename").textContent = filename;
        document.getElementById("modalDocStudent").textContent = student;
        document.getElementById("modalDocTask").textContent = task;
        document.getElementById("modalDocVersion").textContent = version;
        document.getElementById("modalDocSize").textContent = "File Size: " + size + " • Submitted: " + date;
        
        var statusBadge = document.getElementById("modalDocStatus");
        statusBadge.textContent = status;
        if (status.indexOf("Approved") > -1) {
            statusBadge.className = "cv-status-badge status-approved";
        } else if (status.indexOf("Under Review") > -1) {
            statusBadge.className = "cv-status-badge status-under-review";
        } else if (status.indexOf("Revision") > -1) {
            statusBadge.className = "cv-status-badge status-revision-required";
        } else if (status.indexOf("Resubmitted") > -1) {
            statusBadge.className = "cv-status-badge status-resubmitted";
        } else {
            statusBadge.className = "cv-status-badge status-submitted";
        }

        document.getElementById("docPreviewModalBackdrop").classList.add("open");
    }

    function closeDocModal() {
        document.getElementById("docPreviewModalBackdrop").classList.remove("open");
    }

    function downloadModalDoc() {
        downloadFile(activeModalFilename);
    }

    function downloadFile(filename) {
        var content = "%PDF-1.4\n% CampusVault Faculty Document Archive\nDocument: " + filename + "\nDigitally Sealed & Verified\n";
        var blob = new Blob([content], { type: 'application/pdf' });
        var link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>
