@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewBag.Title = "Reset Password — CampusVault";
}

<div class="cv-auth-split">

    @* ==================== LEFT PANEL ==================== *@
    <div class="cv-auth-visual-panel">
        <div class="cv-auth-visual-content animate-fade-in">

            <a href="@Url.Action("Login", "Account")" class="cv-auth-brand" style="color:var(--cv-white);text-decoration:none;margin-bottom:var(--space-8);display:inline-flex;align-items:center;gap:var(--space-3);" title="CampusVault">
                <div style="width:42px;height:42px;background:var(--cv-gold);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(217,164,65,0.35);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:22px;height:22px;color:var(--cv-navy);"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
                <div>
                    <span style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-white);">CampusVault</span>
                    <div style="font-size:11px;color:var(--cv-gold);text-transform:uppercase;letter-spacing:0.06em;font-weight:600;">University Workspace</div>
                </div>
            </a>

            <h1 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;color:var(--cv-white);margin:0 0 var(--space-4) 0;line-height:1.2;">
                Account Security &amp; <span style="color:var(--cv-gold);">Recovery.</span>
            </h1>

            <p style="color:rgba(255,255,255,0.75);font-size:var(--fs-sm);line-height:1.65;margin:0 0 var(--space-8) 0;max-width:400px;">
                Authorized identity recovery for university students, teaching faculty, and institutional administrators.
            </p>

            <!-- Security card -->
            <div style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.15);border-radius:var(--radius-lg);padding:var(--space-5);">
                <div style="display:flex;align-items:center;gap:var(--space-3);margin-bottom:var(--space-4);">
                    <div style="width:38px;height:38px;border-radius:var(--radius-md);background:rgba(217,164,65,0.2);color:var(--cv-gold);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:700;color:var(--cv-white);">Cryptographic Reset Protocol</div>
                        <div style="font-size:11px;color:rgba(255,255,255,0.55);">Time-limited single-use tokens</div>
                    </div>
                </div>
                @foreach (var item in new[] {
                    "Institutional email verification required",
                    "Audit logged to university security ledger",
                    "Reset link expires in 15 minutes"
                })
                {
                    <div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid rgba(255,255,255,0.08);font-size:12px;color:rgba(255,255,255,0.8);">
                        <div style="width:18px;height:18px;border-radius:50%;background:rgba(167,243,208,0.2);color:#a7f3d0;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                        @item
                    </div>
                }
            </div>

            <div style="margin-top:var(--space-8);font-size:11px;color:rgba(255,255,255,0.35);">
                &copy; @DateTime.Now.Year CampusVault &bull; All sessions encrypted
            </div>
        </div>
    </div>

    @* ==================== RIGHT PANEL — FORM ==================== *@
    <div class="cv-auth-form-panel">
        <div class="cv-auth-form-container animate-slide-up">

            <!-- Back link -->
            <a href="@Url.Action("Login","Account")" style="display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--cv-slate);text-decoration:none;margin-bottom:var(--space-5);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Back to Sign In
            </a>

            <!-- Heading -->
            <div style="margin-bottom:var(--space-6);">
                <div style="width:48px;height:48px;border-radius:var(--radius-md);background:var(--cv-indigo-pale);color:var(--cv-indigo);display:flex;align-items:center;justify-content:center;margin-bottom:var(--space-4);">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <h2 style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);margin:0 0 var(--space-2) 0;letter-spacing:-0.02em;">
                    Reset Your Password
                </h2>
                <p style="color:var(--cv-slate);font-size:var(--fs-sm);margin:0;line-height:1.55;">
                    Enter your registered university email below. We'll send a secure reset link to your inbox.
                </p>
            </div>

            <!-- Success banner (hidden by default) -->
            <div id="successBanner" style="display:none;background:#ecfdf5;border:1px solid #a7f3d0;border-radius:var(--radius-md);padding:var(--space-4);margin-bottom:var(--space-5);">
                <div style="display:flex;align-items:flex-start;gap:10px;">
                    <div style="width:28px;height:28px;border-radius:50%;background:#d1fae5;color:#059669;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:700;color:#065f46;margin-bottom:3px;">Reset Link Sent!</div>
                        <p id="successMsg" style="font-size:12px;color:#047857;margin:0;line-height:1.5;">
                            Check your university inbox for the password reset link.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Error banner -->
            <div id="errorBanner" style="display:none;background:#fee2e2;border:1px solid #fca5a5;border-radius:var(--radius-md);padding:var(--space-4);margin-bottom:var(--space-5);">
                <div style="display:flex;align-items:center;gap:10px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <p id="errorMsg" style="font-size:12px;color:#991b1b;margin:0;"></p>
                </div>
            </div>

            <!-- Form -->
            <form id="forgotPasswordForm" onsubmit="handleForgotPassword(event)" novalidate>

                <!-- Email -->
                <div style="margin-bottom:var(--space-4);">
                    <label for="recoveryEmail" style="font-size:12px;font-weight:700;color:var(--cv-navy);display:block;margin-bottom:6px;">
                        University Email Address <span style="color:#dc2626;">*</span>
                    </label>
                    <div style="position:relative;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--cv-slate);pointer-events:none;width:16px;height:16px;flex-shrink:0;">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                        <input type="email" id="recoveryEmail" class="cv-form-control"
                               placeholder="yourname@university.ac.in" required
                               style="width:100%;height:44px;padding:0 14px 0 40px;border:1px solid var(--cv-border);border-radius:var(--radius-md);font-size:13px;box-sizing:border-box;outline:none;transition:border-color 0.15s;"
                               oninput="clearBanners()"
                               onfocus="this.style.borderColor='var(--cv-indigo)'"
                               onblur="this.style.borderColor='var(--cv-border)'" />
                    </div>
                    <div id="emailError" style="font-size:11px;color:#dc2626;margin-top:4px;display:none;">Please enter a valid email address.</div>
                </div>

                <!-- Role selector -->
                <div style="margin-bottom:var(--space-5);">
                    <label style="font-size:12px;font-weight:700;color:var(--cv-navy);display:block;margin-bottom:8px;">
                        Account Type
                    </label>
                    <div style="display:flex;gap:var(--space-2);">
                        @foreach (var role in new[] { new { Value="student", Label="Student", Icon="🎓" }, new { Value="faculty", Label="Faculty", Icon="👨‍🏫" }, new { Value="admin", Label="Admin", Icon="⚙️" } })
                        {
                            <label style="flex:1;cursor:pointer;">
                                <input type="radio" name="recoveryRole" value="@role.Value" @(role.Value == "student" ? "checked" : "") style="display:none;" class="role-radio" onchange="updateRoleCard()" />
                                <div class="role-card @(role.Value == "student" ? "role-card-active" : "")"
                                     style="text-align:center;padding:10px 6px;border:2px solid @(role.Value == "student" ? "var(--cv-indigo)" : "var(--cv-border)");border-radius:var(--radius-md);background:@(role.Value == "student" ? "var(--cv-indigo-pale)" : "var(--cv-white)");transition:all 0.15s;">
                                    <div style="font-size:18px;margin-bottom:3px;">@role.Icon</div>
                                    <div style="font-size:11px;font-weight:700;color:@(role.Value == "student" ? "var(--cv-indigo)" : "var(--cv-slate)");">@role.Label</div>
                                </div>
                            </label>
                        }
                    </div>
                </div>

                <!-- Submit button -->
                <button type="submit" id="submitBtn" class="cv-btn cv-btn-primary"
                        style="width:100%;height:46px;font-size:var(--fs-sm);font-weight:var(--fw-bold);display:flex;align-items:center;justify-content:center;gap:8px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                    Send Reset Link
                </button>
            </form>

            <!-- Divider + back to login -->
            <div style="margin-top:var(--space-6);padding-top:var(--space-5);border-top:1px solid var(--cv-border-light);text-align:center;font-size:var(--fs-xs);color:var(--cv-slate);">
                Remember your password?
                <a href="@Url.Action("Login","Account")" style="color:var(--cv-navy);font-weight:var(--fw-bold);text-decoration:none;margin-left:4px;">
                    Sign in to CampusVault →
                </a>
            </div>

            <!-- Registration link -->
            <div style="margin-top:var(--space-3);text-align:center;font-size:var(--fs-xs);color:var(--cv-slate);">
                New to CampusVault?
                <a href="@Url.Action("Register","Account")" style="color:var(--cv-indigo);font-weight:600;text-decoration:none;margin-left:4px;">
                    Create your account
                </a>
            </div>

        </div>
    </div>
</div>

<script>
    // Update role card styling on change
    function updateRoleCard() {
        document.querySelectorAll('.role-radio').forEach(function (radio) {
            var card = radio.nextElementSibling;
            if (radio.checked) {
                card.style.borderColor = 'var(--cv-indigo)';
                card.style.background  = 'var(--cv-indigo-pale)';
                card.querySelector('div:last-child').style.color = 'var(--cv-indigo)';
            } else {
                card.style.borderColor = 'var(--cv-border)';
                card.style.background  = 'var(--cv-white)';
                card.querySelector('div:last-child').style.color = 'var(--cv-slate)';
            }
        });
    }

    // Make whole role card clickable
    document.querySelectorAll('.role-card').forEach(function (card) {
        card.addEventListener('click', function () {
            var radio = card.previousElementSibling;
            if (radio) { radio.checked = true; updateRoleCard(); }
        });
    });

    function clearBanners() {
        document.getElementById('successBanner').style.display = 'none';
        document.getElementById('errorBanner').style.display   = 'none';
        document.getElementById('emailError').style.display    = 'none';
    }

    function handleForgotPassword(e) {
        e.preventDefault();
        var email = document.getElementById('recoveryEmail').value.trim();
        var btn   = document.getElementById('submitBtn');
        clearBanners();

        // Client-side validation
        var atChar = String.fromCharCode(64);
        var emailRegex = new RegExp('^[^\\s' + atChar + ']+' + atChar + '[^\\s' + atChar + ']+\\.[^\\s' + atChar + ']+$');
        if (!email || !emailRegex.test(email)) {
            document.getElementById('emailError').style.display = 'block';
            return;
        }

        // Show loading
        btn.disabled = true;
        btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 1s linear infinite;"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg> Sending...';

        // POST to backend
        fetch('@Url.Action("ForgotPassword","Account")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'email=' + encodeURIComponent(email)
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            btn.disabled = false;
            btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Send Reset Link';

            if (data.success) {
                var msgHtml = 'A secure password reset link has been created for ' + email + '.';
                if (data.resetUrl) {
                    msgHtml += '<br/><br/><a href="' + data.resetUrl + '" class="cv-btn cv-btn-primary" style="display:inline-block;padding:8px 16px;text-decoration:none;font-weight:700;border-radius:6px;margin-top:6px;">👉 Click here to Set New Password</a>';
                }
                document.getElementById('successMsg').innerHTML = msgHtml;
                document.getElementById('successBanner').style.display = 'block';
                document.getElementById('forgotPasswordForm').reset();
            } else {
                document.getElementById('errorMsg').textContent = data.message || 'Failed to process password reset.';
                document.getElementById('errorBanner').style.display = 'block';
            }
        })
        .catch(function () {
            btn.disabled = false;
            btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Send Reset Link';
            document.getElementById('errorMsg').textContent = 'An unexpected error occurred. Please check your connection and try again.';
            document.getElementById('errorBanner').style.display = 'block';
        });
    }
</script>

<style>
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
