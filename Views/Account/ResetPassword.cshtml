@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewBag.Title = "Set New Password — CampusVault";
    var token = ViewBag.Token as string ?? Request.QueryString["token"] ?? "";
}

<div class="cv-auth-split">
    @* Left branding panel *@
    <div class="cv-auth-visual-panel">
        <div class="cv-auth-visual-content animate-fade-in">
            <a href="@Url.Action("Login", "Account")" class="cv-auth-brand" style="color:var(--cv-white);text-decoration:none;margin-bottom:var(--space-8);display:inline-flex;align-items:center;gap:var(--space-3);" title="CampusVault">
                <div style="width:42px;height:42px;background:var(--cv-gold);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(217,164,65,0.35);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:22px;height:22px;color:var(--cv-navy);"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
                <div>
                    <span style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-white);">CampusVault</span>
                    <div style="font-size:11px;color:var(--cv-gold);text-transform:uppercase;letter-spacing:0.06em;font-weight:600;">University Workspace</div>
                </div>
            </a>

            <h1 style="font-family:var(--font-heading);font-size:2rem;font-weight:800;color:var(--cv-white);margin:0 0 var(--space-4) 0;line-height:1.2;">
                Create Your <span style="color:var(--cv-gold);">New Password</span>
            </h1>

            <p style="color:rgba(255,255,255,0.75);font-size:var(--fs-sm);line-height:1.65;margin:0 0 var(--space-8) 0;max-width:400px;">
                Choose a strong, unique passphrase to safeguard your university workspace credentials.
            </p>

            <div style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.15);border-radius:var(--radius-lg);padding:var(--space-5);">
                <div style="display:flex;align-items:center;gap:var(--space-3);margin-bottom:var(--space-3);">
                    <div style="width:36px;height:36px;border-radius:var(--radius-md);background:rgba(217,164,65,0.2);color:var(--cv-gold);display:flex;align-items:center;justify-content:center;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:700;color:var(--cv-white);">Password Requirements</div>
                        <div style="font-size:11px;color:rgba(255,255,255,0.55);">Academic security protocol</div>
                    </div>
                </div>
                <div style="font-size:12px;color:rgba(255,255,255,0.8);line-height:1.8;">
                    &bull; Minimum 6 characters<br/>
                    &bull; Avoid common words and birthdates<br/>
                    &bull; Never share your password with anyone
                </div>
            </div>
        </div>
    </div>

    @* Right form panel *@
    <div class="cv-auth-form-panel">
        <div class="cv-auth-form-container animate-slide-up">
            <a href="@Url.Action("Login","Account")" style="display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--cv-slate);text-decoration:none;margin-bottom:var(--space-5);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Back to Sign In
            </a>

            <div style="margin-bottom:var(--space-6);">
                <div style="width:48px;height:48px;border-radius:var(--radius-md);background:var(--cv-indigo-pale);color:var(--cv-indigo);display:flex;align-items:center;justify-content:center;margin-bottom:var(--space-4);">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <h2 style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);margin:0 0 var(--space-2) 0;">
                    Reset Password
                </h2>
                <p style="color:var(--cv-slate);font-size:var(--fs-sm);margin:0;">
                    Please enter your new password below.
                </p>
            </div>

            <!-- Success banner -->
            <div id="resetSuccessBanner" style="display:none;background:#ecfdf5;border:1px solid #a7f3d0;border-radius:var(--radius-md);padding:var(--space-4);margin-bottom:var(--space-5);">
                <div style="display:flex;align-items:center;gap:10px;">
                    <div style="width:28px;height:28px;border-radius:50%;background:#d1fae5;color:#059669;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:700;color:#065f46;">Password Reset Successfully!</div>
                        <div style="font-size:12px;color:#047857;margin-top:2px;">Redirecting you to the login page...</div>
                    </div>
                </div>
            </div>

            <!-- Error banner -->
            <div id="resetErrorBanner" style="display:none;background:#fee2e2;border:1px solid #fca5a5;border-radius:var(--radius-md);padding:var(--space-4);margin-bottom:var(--space-5);">
                <div style="display:flex;align-items:center;gap:10px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" cy="8" x2="12" y2="12"/><line x1="12" cy="16" x2="12.01" y2="16"/></svg>
                    <p id="resetErrorMsg" style="font-size:12px;color:#991b1b;margin:0;"></p>
                </div>
            </div>

            <form id="resetPasswordForm" onsubmit="handleResetPassword(event)">
                <input type="hidden" id="resetToken" value="@token" />

                <!-- New Password -->
                <div style="margin-bottom:var(--space-4);">
                    <label for="newPassword" style="font-size:12px;font-weight:700;color:var(--cv-navy);display:block;margin-bottom:6px;">
                        New Password <span style="color:#dc2626;">*</span>
                    </label>
                    <input type="password" id="newPassword" class="cv-form-control" placeholder="••••••••" required
                           style="width:100%;height:44px;padding:0 14px;border:1px solid var(--cv-border);border-radius:var(--radius-md);font-size:13px;box-sizing:border-box;outline:none;" />
                </div>

                <!-- Confirm Password -->
                <div style="margin-bottom:var(--space-5);">
                    <label for="confirmPassword" style="font-size:12px;font-weight:700;color:var(--cv-navy);display:block;margin-bottom:6px;">
                        Confirm New Password <span style="color:#dc2626;">*</span>
                    </label>
                    <input type="password" id="confirmPassword" class="cv-form-control" placeholder="••••••••" required
                           style="width:100%;height:44px;padding:0 14px;border:1px solid var(--cv-border);border-radius:var(--radius-md);font-size:13px;box-sizing:border-box;outline:none;" />
                </div>

                <button type="submit" id="resetSubmitBtn" class="cv-btn cv-btn-primary"
                        style="width:100%;height:46px;font-size:var(--fs-sm);font-weight:var(--fw-bold);display:flex;align-items:center;justify-content:center;gap:8px;">
                    Update Password
                </button>
            </form>
        </div>
    </div>
</div>

<script>
function handleResetPassword(e) {
    e.preventDefault();
    var token = document.getElementById('resetToken').value;
    var newPass = document.getElementById('newPassword').value;
    var confirmPass = document.getElementById('confirmPassword').value;
    var errBanner = document.getElementById('resetErrorBanner');
    var errMsg = document.getElementById('resetErrorMsg');
    var successBanner = document.getElementById('resetSuccessBanner');
    var btn = document.getElementById('resetSubmitBtn');

    errBanner.style.display = 'none';

    if (!token) {
        errMsg.textContent = 'Reset token is missing. Please request a new password reset link.';
        errBanner.style.display = 'block';
        return;
    }
    if (newPass.length < 6) {
        errMsg.textContent = 'Password must be at least 6 characters long.';
        errBanner.style.display = 'block';
        return;
    }
    if (newPass !== confirmPass) {
        errMsg.textContent = 'Passwords do not match.';
        errBanner.style.display = 'block';
        return;
    }

    btn.disabled = true;
    btn.textContent = 'Updating...';

    var fd = new FormData();
    fd.append('token', token);
    fd.append('newPassword', newPass);
    fd.append('confirmPassword', confirmPass);

    fetch('@Url.Action("ResetPassword", "Account")', {
        method: 'POST',
        body: new URLSearchParams(fd)
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
        btn.disabled = false;
        btn.textContent = 'Update Password';
        if (res.success) {
            successBanner.style.display = 'block';
            document.getElementById('resetPasswordForm').style.display = 'none';
            setTimeout(function() {
                window.location.href = '@Url.Action("Login", "Account")';
            }, 2000);
        } else {
            errMsg.textContent = res.message || 'Failed to reset password.';
            errBanner.style.display = 'block';
        }
    })
    .catch(function(err) {
        btn.disabled = false;
        btn.textContent = 'Update Password';
        errMsg.textContent = 'An error occurred. Please try again.';
        errBanner.style.display = 'block';
    });
}
</script>
