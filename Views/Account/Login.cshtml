@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewBag.Title = "Sign In — CampusVault";
}

<div class="cv-auth-split">
    @* ==================== LEFT: UNIVERSITY VISUAL AREA (45%) ==================== *@
    <div class="cv-auth-visual-panel">
        <div class="cv-auth-visual-content animate-fade-in">
            <!-- CampusVault Logo -->
            <a href="@Url.Action("Login", "Account")" class="cv-auth-brand" style="color:var(--cv-white);text-decoration:none;margin-bottom:var(--space-8);display:inline-flex;align-items:center;gap:var(--space-3);" title="CampusVault">
                <div class="brand-icon" style="width:42px;height:42px;background:var(--cv-gold);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(217,164,65,0.35);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;color:var(--cv-navy);">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                    </svg>
                </div>
                <div>
                    <span class="brand-name" style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-white);letter-spacing:-0.01em;">CampusVault</span>
                    <div style="font-size:11px;color:var(--cv-gold);text-transform:uppercase;letter-spacing:0.06em;font-weight:600;">University Workspace</div>
                </div>
            </a>

            <!-- Heading & Supporting Text -->
            <h1>
                Your Academic World, <span style="color:var(--cv-gold);">Organized.</span>
            </h1>

            <p class="visual-subtitle">
                One place for your classrooms, documents, submissions, and academic progress.
            </p>

            <!-- Sophisticated Academic Visual: Institutional Seal Card -->
            <div class="cv-academic-seal-card">
                <div class="cv-seal-header">
                    <div class="cv-seal-badge">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            <polyline points="9 12 11 14 15 10"/>
                        </svg>
                    </div>
                    <div>
                        <div class="cv-seal-title">Institutional Academic Single Sign-On</div>
                        <div class="cv-seal-meta">Accredited & Encrypted Directory</div>
                    </div>
                </div>

                <div class="cv-seal-features">
                    <div class="cv-seal-item">
                        <span class="cv-seal-check">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        <span>Centralized classrooms, assignments, and announcements</span>
                    </div>
                    <div class="cv-seal-item">
                        <span class="cv-seal-check">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        <span>Permanent document vault with tamper-proof version history</span>
                    </div>
                    <div class="cv-seal-item">
                        <span class="cv-seal-check">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        <span>Faculty revision workflows with actionable rubric feedback</span>
                    </div>
                </div>

                <div class="cv-seal-footer">
                    <span>Spring 2026 Academic Term</span>
                    <span>ISO 27001 & FERPA Compliant</span>
                </div>
            </div>
        </div>
    </div>

    @* ==================== RIGHT: LOGIN FORM AREA (55%) ==================== *@
    <div class="cv-auth-form-panel">
        <div class="cv-auth-card-wide animate-slide-up">
            
            <!-- Mobile Brand Header (Visible on small screens if stacked) -->
            <div style="display:none;margin-bottom:var(--space-6);" id="mobileBrandHeader">
                <a href="@Url.Action("Login", "Account")" style="display:inline-flex;align-items:center;gap:var(--space-2);text-decoration:none;" title="CampusVault">
                    <div style="width:32px;height:32px;background:var(--cv-gold);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;color:var(--cv-navy);">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                        </svg>
                    </div>
                    <span style="font-family:var(--font-heading);font-size:var(--fs-xl);font-weight:var(--fw-bold);color:var(--cv-navy);">CampusVault</span>
                </a>
            </div>

            <!-- Header -->
            <div style="margin-bottom:var(--space-6);">
                <h2 style="font-family:var(--font-heading);font-size:var(--fs-3xl);font-weight:var(--fw-bold);color:var(--cv-navy);margin-bottom:var(--space-2);letter-spacing:-0.015em;">
                    Sign in to CampusVault
                </h2>
                <p style="color:var(--cv-slate);font-size:var(--fs-base);">
                    Access your academic workspace, submissions, and course dossiers.
                </p>
            </div>

            <!-- Subtle Role Indicators -->
            <div class="cv-role-indicator-strip">
                <span class="cv-role-label">Academic Portal Access:</span>
                <div class="cv-role-pills">
                    <span class="cv-role-pill">
                        <span class="cv-role-dot student"></span> Student
                    </span>
                    <span class="cv-role-pill">
                        <span class="cv-role-dot faculty"></span> Faculty
                    </span>
                    <span class="cv-role-pill">
                        <span class="cv-role-dot admin"></span> Administrator
                    </span>
                </div>
            </div>

            <!-- Dynamic Alert for Visual States (Invalid Credentials, Success, etc.) -->
            <div id="loginAlert" class="cv-alert" style="display:none;margin-bottom:var(--space-6);">
                <div class="cv-alert-icon" id="alertIcon"></div>
                <div class="cv-alert-content">
                    <div class="cv-alert-title" id="alertTitle"></div>
                    <div id="alertMessage" style="font-size:var(--fs-xs);"></div>
                </div>
            </div>

            <!-- Login Form -->
            <div class="cv-auth-form" style="background:var(--cv-white);box-shadow:var(--shadow-sm);">
                <form id="loginForm" onsubmit="return false;" novalidate>
                    <!-- Email Field -->
                    <div class="cv-form-group">
                        <label class="cv-form-label" for="loginEmail">
                            Email Address <span style="color:var(--cv-danger);">*</span>
                        </label>
                        <div class="cv-input-wrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <polyline points="22,6 12,13 2,6"/>
                            </svg>
                            <input type="email"
                                   id="loginEmail"
                                   class="cv-input"
                                   placeholder="student@university.edu"
                                   autocomplete="email"
                                   oninput="clearFieldErrors('email')" />
                        </div>
                        <div id="emailError" class="cv-form-error" style="display:none;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;flex-shrink:0;">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                            <span id="emailErrorText">Please enter a valid university email address.</span>
                        </div>
                    </div>

                    <!-- Password Field -->
                    <div class="cv-form-group">
                        <label class="cv-form-label" for="loginPassword">
                            Password <span style="color:var(--cv-danger);">*</span>
                        </label>
                        <div class="cv-input-wrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                            <input type="password"
                                   id="loginPassword"
                                   class="cv-input"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   oninput="clearFieldErrors('password')" />
                            <button type="button" class="cv-password-toggle" id="togglePasswordBtn" aria-label="Toggle password visibility" onclick="togglePasswordVisibility()">
                                <svg id="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                        <div id="passwordError" class="cv-form-error" style="display:none;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;flex-shrink:0;">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                            <span id="passwordErrorText">Password is required.</span>
                        </div>
                    </div>

                    <!-- Remember Me & Forgot Password -->
                    <div class="form-footer" style="margin-top:var(--space-2);margin-bottom:var(--space-6);">
                        <label class="cv-checkbox">
                            <input type="checkbox" id="rememberMe" checked />
                            <span>Remember me</span>
                        </label>
                        <a href="@Url.Action("ForgotPassword", "Account")" style="font-size:var(--fs-sm);color:var(--cv-indigo);font-weight:var(--fw-medium);">
                            Forgot password?
                        </a>
                    </div>

                    <!-- Primary Action Button -->
                    <button type="button" id="loginBtn" class="cv-btn cv-btn-gold cv-btn-lg w-full" onclick="handleLogin()">
                        <span>Sign In</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;">
                            <line x1="5" y1="12" x2="19" y2="12"/>
                            <polyline points="12 5 19 12 12 19"/>
                        </svg>
                    </button>
                </form>
            </div>

            <!-- Footer Link -->
            <div class="cv-auth-footer">
                Don't have an account? <a href="@Url.Action("Register", "Account")" style="font-weight:600;">Create an account</a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Password Visibility Toggle
        function togglePasswordVisibility() {
            var pwdInput = document.getElementById('loginPassword');
            var eyeIcon = document.getElementById('eyeIcon');
            if (!pwdInput) return;

            if (pwdInput.type === 'password') {
                pwdInput.type = 'text';
                eyeIcon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                pwdInput.type = 'password';
                eyeIcon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
            }
        }

        // Clear field error highlights
        function clearFieldErrors(field) {
            hideAlert();
            if (field === 'email' || !field) {
                var emailInput = document.getElementById('loginEmail');
                var emailErr = document.getElementById('emailError');
                if (emailInput) emailInput.classList.remove('error');
                if (emailErr) emailErr.style.display = 'none';
            }
            if (field === 'password' || !field) {
                var pwdInput = document.getElementById('loginPassword');
                var pwdErr = document.getElementById('passwordError');
                if (pwdInput) pwdInput.classList.remove('error');
                if (pwdErr) pwdErr.style.display = 'none';
            }
        }

        // Show banner alert
        function showAlert(type, title, message) {
            var alertBox = document.getElementById('loginAlert');
            var alertIcon = document.getElementById('alertIcon');
            var alertTitle = document.getElementById('alertTitle');
            var alertMsg = document.getElementById('alertMessage');

            alertBox.className = 'cv-alert cv-alert-' + type;
            alertBox.style.display = 'flex';
            alertTitle.textContent = title;
            alertMsg.textContent = message;

            if (type === 'danger') {
                alertIcon.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
            } else if (type === 'success') {
                alertIcon.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;"><polyline points="20 6 9 17 4 12"/></svg>';
            } else if (type === 'info') {
                alertIcon.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';
            }
        }

        function hideAlert() {
            var alertBox = document.getElementById('loginAlert');
            if (alertBox) alertBox.style.display = 'none';
        }

        // Main Login Action Handler (Connected to Real SQL Server Database & JWT)
        function handleLogin() {
            clearFieldErrors();
            var emailInput = document.getElementById('loginEmail');
            var pwdInput = document.getElementById('loginPassword');
            var rememberCheckbox = document.getElementById('rememberMe');
            var btn = document.getElementById('loginBtn');

            var email = (emailInput.value || '').trim();
            var password = (pwdInput.value || '').trim();
            var rememberMe = rememberCheckbox ? rememberCheckbox.checked : false;

            // 1. Email format check
            var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!email || !emailRegex.test(email)) {
                emailInput.classList.add('error');
                var emailErr = document.getElementById('emailError');
                var emailErrText = document.getElementById('emailErrorText');
                emailErrText.textContent = !email ? 'Email address is required.' : 'Please enter a valid university email address.';
                emailErr.style.display = 'flex';
                emailInput.focus();
                return;
            }

            // 2. Password check
            if (!password) {
                pwdInput.classList.add('error');
                var pwdErr = document.getElementById('passwordError');
                var pwdErrText = document.getElementById('passwordErrorText');
                pwdErrText.textContent = 'Password is required.';
                pwdErr.style.display = 'flex';
                pwdInput.focus();
                return;
            }

            // 3. UI Loading State
            CampusVault.setButtonLoading(btn, true);
            emailInput.disabled = true;
            pwdInput.disabled = true;
            hideAlert();

            // 4. Send Real AJAX Request to AccountController
            fetch('@Url.Action("Login", "Account")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    Email: email,
                    Password: password,
                    RememberMe: rememberMe
                })
            })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('Server returned ' + response.status);
                }
                return response.json();
            })
            .then(function (data) {
                CampusVault.setButtonLoading(btn, false);
                emailInput.disabled = false;
                pwdInput.disabled = false;

                if (data.Success) {
                    var displayName = (data.User && data.User.FirstName) ? data.User.FirstName : 'User';
                    var roleName = data.Role || 'Student';

                    showAlert('success', 'Signed In Successfully!', 'Welcome back, ' + displayName + '! You are signed in as ' + roleName + '. Redirecting to your dashboard...');

                    setTimeout(function () {
                        var urlParams = new URLSearchParams(window.location.search);
                        var returnUrl = urlParams.get('returnUrl');
                        if (returnUrl && returnUrl.startsWith('/') && !returnUrl.startsWith('//') && !returnUrl.toLowerCase().includes('/account/login') && !returnUrl.toLowerCase().includes('/home')) {
                            window.location.href = returnUrl;
                        } else {
                            window.location.href = data.RedirectUrl || '@Url.Action("Dashboard", "Student")';
                        }
                    }, 900);
                } else {
                    pwdInput.classList.add('error');
                    showAlert('danger', 'Sign In Failed', data.Message || 'Invalid credentials. Please verify your email and password.');
                    pwdInput.focus();
                }
            })
            .catch(function (error) {
                CampusVault.setButtonLoading(btn, false);
                emailInput.disabled = false;
                pwdInput.disabled = false;
                showAlert('danger', 'Connection Error', 'Unable to reach the CampusVault authentication service: ' + error.message);
            });
        }

        // On Page Load: Clear any residual client storage and handle registration success banner
        document.addEventListener('DOMContentLoaded', function () {
            try {
                localStorage.removeItem('cv_access_token');
                localStorage.removeItem('cv_refresh_token');
                localStorage.removeItem('cv_user');
            } catch (e) { }

            var params = new URLSearchParams(window.location.search);
            if (params.get('registered') === 'true') {
                var regEmail = params.get('email');
                if (regEmail) {
                    var emailInput = document.getElementById('loginEmail');
                    if (emailInput) {
                        emailInput.value = decodeURIComponent(regEmail);
                    }
                    var pwdInput = document.getElementById('loginPassword');
                    if (pwdInput) pwdInput.focus();
                }
                showAlert('success', 'Account Created Successfully!', 'Your account has been created. Please enter your password to sign in.');
            } else if (params.get('loggedOut') === 'true') {
                showAlert('info', 'Signed Out Successfully', 'Your session has been completely ended. Please sign in again to access CampusVault.');
            }
        });
    </script>
}
