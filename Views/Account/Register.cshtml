@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewBag.Title = "Create Account — CampusVault";
}

<div class="cv-auth-split">
    @* ==================== LEFT: UNIVERSITY VISUAL AREA (42%) ==================== *@
    <div class="cv-auth-visual-panel" style="width:42%;">
        <div class="cv-auth-visual-content animate-fade-in">
            <!-- Brand Logo -->
            <a href="@Url.Action("Login", "Account")" class="cv-auth-brand" style="color:var(--cv-white);text-decoration:none;margin-bottom:var(--space-8);display:inline-flex;align-items:center;gap:var(--space-3);" title="CampusVault">
                <div class="brand-icon" style="width:42px;height:42px;background:var(--cv-gold);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(217,164,65,0.35);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;color:var(--cv-navy);">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                    </svg>
                </div>
                <div>
                    <span class="brand-name" style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-white);letter-spacing:-0.01em;">CampusVault</span>
                    <div style="font-size:11px;color:var(--cv-gold);text-transform:uppercase;letter-spacing:0.06em;font-weight:600;">University Workspace</div>
                </div>
            </a>

            <!-- Heading & Subtitle -->
            <h1 style="font-family:var(--font-heading);font-size:clamp(1.9rem, 3vw, 2.5rem);line-height:1.18;margin-bottom:var(--space-3);">
                Join Your Academic <span style="color:var(--cv-gold);">Community.</span>
            </h1>

            <p class="visual-subtitle" style="font-size:var(--fs-base);color:rgba(255,255,255,0.78);margin-bottom:var(--space-8);line-height:var(--lh-relaxed);">
                Create your verified university account to access classrooms, collaborate on coursework, and manage verified academic records.
            </p>

            <!-- Academic Institutional Seal Card -->
            <div class="cv-academic-seal-card">
                <div class="cv-seal-header">
                    <div class="cv-seal-badge">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                            <path d="M6 12v5c3 3 9 3 12 0v-5" />
                        </svg>
                    </div>
                    <div>
                        <div class="cv-seal-title">Official Institutional Registration</div>
                        <div class="cv-seal-meta">Students • Faculty • Administrators</div>
                    </div>
                </div>

                <div class="cv-seal-features">
                    <div class="cv-seal-item">
                        <span class="cv-seal-check">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                        </span>
                        <span>Role-tailored workspace for Coursework, Grading & Analytics</span>
                    </div>
                    <div class="cv-seal-item">
                        <span class="cv-seal-check">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                        </span>
                        <span>Permanent document vault with tamper-proof revision histories</span>
                    </div>
                    <div class="cv-seal-item">
                        <span class="cv-seal-check">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                        </span>
                        <span>Automated course enrollment & rubric-based grading feedback</span>
                    </div>
                </div>

                <div class="cv-seal-footer">
                    <span>Spring 2026 Academic Term</span>
                    <span>FERPA & ISO 27001 Certified</span>
                </div>
            </div>
        </div>
    </div>

    @* ==================== RIGHT: REGISTRATION FORM AREA (58%) ==================== *@
    <div class="cv-auth-form-panel" style="width:58%;padding:var(--space-8) var(--space-8);">
        <div class="cv-auth-card-register animate-slide-up" style="max-width:640px;">

            <!-- Mobile Brand Header (Visible on small screens) -->
            <div style="display:none;margin-bottom:var(--space-6);" id="mobileBrandHeader">
                <a href="@Url.Action("Login", "Account")" style="display:inline-flex;align-items:center;gap:var(--space-2);text-decoration:none;" title="CampusVault">
                    <div style="width:32px;height:32px;background:var(--cv-gold);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;color:var(--cv-navy);">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                        </svg>
                    </div>
                    <span style="font-family:var(--font-heading);font-size:var(--fs-xl);font-weight:var(--fw-bold);color:var(--cv-navy);">CampusVault</span>
                </a>
            </div>

            <!-- Page Header -->
            <div style="margin-bottom:var(--space-5);">
                <h2 style="font-family:var(--font-heading);font-size:var(--fs-3xl);font-weight:var(--fw-bold);color:var(--cv-navy);margin-bottom:4px;letter-spacing:-0.015em;">
                    Create an Account
                </h2>
                <p style="color:var(--cv-slate);font-size:var(--fs-base);">
                    Enter your university credentials to register for CampusVault.
                </p>
            </div>

            <!-- Role Selector Tabs -->
            <div style="margin-bottom:var(--space-2);">
                <label class="cv-form-label" style="margin-bottom:var(--space-2);display:flex;align-items:center;justify-content:space-between;">
                    <span>Select University Role <span style="color:var(--cv-danger);">*</span></span>
                    <span style="font-size:11px;color:var(--cv-slate);font-weight:normal;">Customizes your academic workspace</span>
                </label>
                <div class="cv-role-tabs" id="roleSelector">
                    <div class="cv-role-tab active" id="tabStudent" onclick="selectRole('student')">
                        <div class="cv-role-tab-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;">
                                <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                                <path d="M6 12v5c3 3 9 3 12 0v-5" />
                            </svg>
                        </div>
                        <span class="cv-role-tab-title">Student</span>
                        <span class="cv-role-tab-badge">Undergrad & Grad</span>
                    </div>

                    <div class="cv-role-tab" id="tabFaculty" onclick="selectRole('faculty')">
                        <div class="cv-role-tab-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;">
                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                            </svg>
                        </div>
                        <span class="cv-role-tab-title">Faculty</span>
                        <span class="cv-role-tab-badge">Instructors & Dept</span>
                    </div>

                    <div class="cv-role-tab" id="tabAdmin" onclick="selectRole('admin')">
                        <div class="cv-role-tab-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            </svg>
                        </div>
                        <span class="cv-role-tab-title">Administrator</span>
                        <span class="cv-role-tab-badge">Dean & Operations</span>
                    </div>
                </div>
            </div>

            <!-- Dynamic Alert for Validation/Feedback -->
            <div id="registerAlert" class="cv-alert" style="display:none;margin-bottom:var(--space-4);">
                <div class="cv-alert-icon" id="regAlertIcon"></div>
                <div class="cv-alert-content">
                    <div class="cv-alert-title" id="regAlertTitle"></div>
                    <div id="regAlertMessage" style="font-size:var(--fs-xs);"></div>
                </div>
            </div>

            <!-- Registration Form Card -->
            <div class="cv-auth-form" style="background:var(--cv-white);box-shadow:var(--shadow-sm);padding:var(--space-6);border-radius:var(--radius-xl);border:1px solid var(--cv-border);">
                <form id="registerForm" onsubmit="return false;" novalidate>
                    <input type="hidden" id="selectedRole" value="student" />

                    <!-- Section: Personal Information -->
                    <div class="cv-section-divider" style="margin-top:0;">
                        <span class="cv-section-divider-text">Personal & Login Credentials</span>
                        <div class="cv-section-divider-line"></div>
                    </div>

                    <!-- Row 1: Full Name & Email Address -->
                    <div class="cv-form-row-2">
                        <div class="cv-form-group">
                            <label class="cv-form-label" for="regName">
                                Full Name <span style="color:var(--cv-danger);">*</span>
                            </label>
                            <div class="cv-input-wrapper">
                                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                    <circle cx="12" cy="7" r="4" />
                                </svg>
                                <input type="text"
                                       id="regName"
                                       class="cv-input"
                                       placeholder="e.g. Alex Mercer"
                                       autocomplete="name"
                                       oninput="clearFieldErrors('name')" />
                            </div>
                            <div id="nameError" class="cv-form-error" style="display:none;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;flex-shrink:0;"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                                <span>Please enter your full name.</span>
                            </div>
                        </div>

                        <div class="cv-form-group">
                            <label class="cv-form-label" for="regEmail">
                                Email Address <span style="color:var(--cv-danger);">*</span>
                            </label>
                            <div class="cv-input-wrapper">
                                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                                    <polyline points="22,6 12,13 2,6" />
                                </svg>
                                <input type="email"
                                       id="regEmail"
                                       class="cv-input"
                                       placeholder="alex.mercer@university.edu"
                                       autocomplete="email"
                                       oninput="clearFieldErrors('email')" />
                            </div>
                            <div id="emailError" class="cv-form-error" style="display:none;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;flex-shrink:0;"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                                <span id="emailErrorText">Please enter a valid university email address.</span>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Password & Confirm Password -->
                    <div class="cv-form-row-2">
                        <div class="cv-form-group">
                            <label class="cv-form-label" for="regPassword">
                                Password <span style="color:var(--cv-danger);">*</span>
                            </label>
                            <div class="cv-input-wrapper">
                                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                </svg>
                                <input type="password"
                                       id="regPassword"
                                       class="cv-input"
                                       placeholder="Create a strong password"
                                       autocomplete="new-password"
                                       oninput="handlePasswordInput()" />
                                <button type="button" class="cv-password-toggle" id="toggleRegPwdBtn" aria-label="Toggle password visibility" onclick="togglePasswordVisibility('regPassword', 'regPwdEyeIcon')">
                                    <svg id="regPwdEyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div class="cv-form-group">
                            <label class="cv-form-label" for="regConfirm">
                                Confirm Password <span style="color:var(--cv-danger);">*</span>
                            </label>
                            <div class="cv-input-wrapper">
                                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                </svg>
                                <input type="password"
                                       id="regConfirm"
                                       class="cv-input"
                                       placeholder="Re-enter your password"
                                       autocomplete="new-password"
                                       oninput="handleConfirmPasswordInput()" />
                                <button type="button" class="cv-password-toggle" id="toggleConfirmPwdBtn" aria-label="Toggle password visibility" onclick="togglePasswordVisibility('regConfirm', 'confirmPwdEyeIcon')">
                                    <svg id="confirmPwdEyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </button>
                            </div>
                            <!-- Live Password Match Indicator -->
                            <div id="passwordMatchIndicator" class="cv-match-indicator">
                                <svg id="matchIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                                <span id="matchText">Passwords match</span>
                            </div>
                        </div>
                    </div>

                    <!-- Password Strength Meter & Requirement Checklist -->
                    <div class="cv-strength-container" id="strengthContainer">
                        <div class="cv-strength-meter-bar">
                            <div class="cv-strength-segment" id="strengthSeg1"></div>
                            <div class="cv-strength-segment" id="strengthSeg2"></div>
                            <div class="cv-strength-segment" id="strengthSeg3"></div>
                            <div class="cv-strength-segment" id="strengthSeg4"></div>
                        </div>
                        <div class="cv-strength-meta">
                            <span>Password Strength: <strong id="strengthLabel" class="cv-strength-label weak">Empty</strong></span>
                            <span id="strengthHint" style="color:var(--cv-slate-light);">8+ characters recommended</span>
                        </div>
                        <div class="cv-criteria-row">
                            <span class="cv-criterion" id="critLength">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
                                8+ characters
                            </span>
                            <span class="cv-criterion" id="critUpper">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
                                Uppercase
                            </span>
                            <span class="cv-criterion" id="critNumber">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
                                Number
                            </span>
                            <span class="cv-criterion" id="critSymbol">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
                                Symbol
                            </span>
                        </div>
                    </div>

                    <!-- Create Account Primary Button -->
                    <button type="button" id="regBtn" class="cv-btn cv-btn-gold cv-btn-lg w-full" onclick="handleRegister()">
                        <span>Create Account</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;">
                            <line x1="5" y1="12" x2="19" y2="12" />
                            <polyline points="12 5 19 12 12 19" />
                        </svg>
                    </button>
                </form>
            </div>

            <!-- Footer: Sign In Link -->
            <div class="cv-auth-footer" style="margin-top:var(--space-4);margin-bottom:var(--space-4);">
                Already have an account? <a href="@Url.Action("Login", "Account")" style="font-weight:600;color:var(--cv-indigo);">Sign In</a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Role Selection Handler
        function selectRole(role) {
            document.getElementById('selectedRole').value = role;

            // Update Tab States
            var tabs = ['student', 'faculty', 'admin'];
            tabs.forEach(function (r) {
                var tabEl = document.getElementById('tab' + capitalize(r));
                var sectionEl = document.getElementById('section' + capitalize(r));
                if (tabEl) {
                    if (r === role) {
                        tabEl.classList.add('active');
                    } else {
                        tabEl.classList.remove('active');
                    }
                }
                if (sectionEl) {
                    if (r === role) {
                        sectionEl.classList.add('active');
                    } else {
                        sectionEl.classList.remove('active');
                    }
                }
            });

            // Adjust email domain suggestion or placeholder if empty
            var emailInput = document.getElementById('regEmail');
            if (emailInput && !emailInput.value) {
                if (role === 'student') emailInput.placeholder = 'alex.mercer@university.edu';
                else if (role === 'faculty') emailInput.placeholder = 'dr.jenkins@university.edu';
                else if (role === 'admin') emailInput.placeholder = 'admin.office@university.edu';
            }
        }

        function capitalize(s) {
            return s.charAt(0).toUpperCase() + s.slice(1);
        }

        // Toggle Password Visibility
        function togglePasswordVisibility(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (!input || !icon) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                input.type = 'password';
                icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
            }
        }

        // Live Password Strength Calculation
        function handlePasswordInput() {
            clearFieldErrors('password');
            var pwd = document.getElementById('regPassword').value || '';

            var seg1 = document.getElementById('strengthSeg1');
            var seg2 = document.getElementById('strengthSeg2');
            var seg3 = document.getElementById('strengthSeg3');
            var seg4 = document.getElementById('strengthSeg4');
            var label = document.getElementById('strengthLabel');
            var hint = document.getElementById('strengthHint');

            var critLength = document.getElementById('critLength');
            var critUpper = document.getElementById('critUpper');
            var critNumber = document.getElementById('critNumber');
            var critSymbol = document.getElementById('critSymbol');

            // Reset segments
            [seg1, seg2, seg3, seg4].forEach(function (s) {
                s.className = 'cv-strength-segment';
            });

            // Evaluate criteria
            var hasLength = pwd.length >= 8;
            var hasUpper = /[A-Z]/.test(pwd);
            var hasNumber = /[0-9]/.test(pwd);
            var hasSymbol = /[^A-Za-z0-9]/.test(pwd);

            toggleCrit(critLength, hasLength);
            toggleCrit(critUpper, hasUpper);
            toggleCrit(critNumber, hasNumber);
            toggleCrit(critSymbol, hasSymbol);

            var score = 0;
            if (hasLength) score++;
            if (hasUpper) score++;
            if (hasNumber) score++;
            if (hasSymbol) score++;

            label.className = 'cv-strength-label';

            if (pwd.length === 0) {
                label.textContent = 'Empty';
                label.classList.add('weak');
                hint.textContent = '8+ characters recommended';
            } else if (score <= 1) {
                label.textContent = 'Weak';
                label.classList.add('weak');
                seg1.classList.add('active-weak');
                hint.textContent = 'Add uppercase, numbers, and symbols';
            } else if (score === 2) {
                label.textContent = 'Fair';
                label.classList.add('fair');
                seg1.classList.add('active-fair');
                seg2.classList.add('active-fair');
                hint.textContent = 'Good start, add symbols or length';
            } else if (score === 3) {
                label.textContent = 'Good';
                label.classList.add('good');
                seg1.classList.add('active-good');
                seg2.classList.add('active-good');
                seg3.classList.add('active-good');
                hint.textContent = 'Strong password! Almost complete';
            } else {
                label.textContent = 'Strong';
                label.classList.add('strong');
                seg1.classList.add('active-strong');
                seg2.classList.add('active-strong');
                seg3.classList.add('active-strong');
                seg4.classList.add('active-strong');
                hint.textContent = 'Excellent university passphrase';
            }

            // Also check match if confirm password has value
            handleConfirmPasswordInput();
        }

        function toggleCrit(el, isMet) {
            if (!el) return;
            if (isMet) {
                el.classList.add('met');
            } else {
                el.classList.remove('met');
            }
        }

        // Live Password Match Indicator
        function handleConfirmPasswordInput() {
            clearFieldErrors('confirm');
            var pwd = document.getElementById('regPassword').value;
            var confirm = document.getElementById('regConfirm').value;
            var indicator = document.getElementById('passwordMatchIndicator');
            var matchIcon = document.getElementById('matchIcon');
            var matchText = document.getElementById('matchText');

            if (!confirm) {
                indicator.className = 'cv-match-indicator';
                indicator.style.display = 'none';
                return;
            }

            indicator.style.display = 'flex';
            if (pwd === confirm) {
                indicator.className = 'cv-match-indicator match';
                matchText.textContent = 'Passwords match';
                matchIcon.innerHTML = '<polyline points="20 6 9 17 4 12"/>';
            } else {
                indicator.className = 'cv-match-indicator mismatch';
                matchText.textContent = 'Passwords do not match';
                matchIcon.innerHTML = '<circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>';
            }
        }

        // Clear Field Validation Highlights
        function clearFieldErrors(field) {
            hideAlert();
            if (field === 'name' || !field) {
                var el = document.getElementById('regName');
                var err = document.getElementById('nameError');
                if (el) el.classList.remove('error');
                if (err) err.style.display = 'none';
            }
            if (field === 'email' || !field) {
                var el = document.getElementById('regEmail');
                var err = document.getElementById('emailError');
                if (el) el.classList.remove('error');
                if (err) err.style.display = 'none';
            }
            if (field === 'password' || !field) {
                var el = document.getElementById('regPassword');
                if (el) el.classList.remove('error');
            }
            if (field === 'confirm' || !field) {
                var el = document.getElementById('regConfirm');
                if (el) el.classList.remove('error');
            }
        }

        // Alert Banner Display
        function showAlert(type, title, message) {
            var box = document.getElementById('registerAlert');
            var icon = document.getElementById('regAlertIcon');
            var titleEl = document.getElementById('regAlertTitle');
            var msgEl = document.getElementById('regAlertMessage');

            box.className = 'cv-alert cv-alert-' + type;
            box.style.display = 'flex';
            titleEl.textContent = title;
            msgEl.textContent = message;

            if (type === 'danger') {
                icon.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
            } else if (type === 'success') {
                icon.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;"><polyline points="20 6 9 17 4 12"/></svg>';
            } else if (type === 'warning') {
                icon.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
            }
        }

        function hideAlert() {
            var box = document.getElementById('registerAlert');
            if (box) box.style.display = 'none';
        }

        // Terms Dialog Modal / Notice
        function alertTerms() {
            if (window.CampusVault && CampusVault.showToast) {
                CampusVault.showToast({
                    type: 'info',
                    title: 'Academic Honor Code',
                    message: 'All registered students and faculty agree to abide by institutional honor and non-plagiarism codes.',
                    duration: 4000
                });
            } else {
                alert('CampusVault Academic Terms & Honor Code: All work submitted through this portal must adhere to institutional standards of academic integrity.');
            }
        }

        // Main Registration Submission Handler (Mock Only)
        function handleRegister() {
            clearFieldErrors();
            var name = document.getElementById('regName').value.trim();
            var email = document.getElementById('regEmail').value.trim();
            var password = document.getElementById('regPassword').value;
            var confirm = document.getElementById('regConfirm').value;
            var role = document.getElementById('selectedRole').value;
            var btn = document.getElementById('regBtn');

            // 1. Name Check
            if (!name) {
                document.getElementById('regName').classList.add('error');
                document.getElementById('nameError').style.display = 'flex';
                document.getElementById('regName').focus();
                showAlert('danger', 'Full Name Required', 'Please provide your full legal or institutional name.');
                return;
            }

            // 2. Email Check
            var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!email || !emailRegex.test(email)) {
                document.getElementById('regEmail').classList.add('error');
                var err = document.getElementById('emailError');
                var txt = document.getElementById('emailErrorText');
                txt.textContent = !email ? 'Email address is required.' : 'Please enter a valid university email address (e.g. name@university.edu).';
                err.style.display = 'flex';
                document.getElementById('regEmail').focus();
                showAlert('danger', 'Invalid Email', 'A valid university email address is required for institutional authentication.');
                return;
            }

            // 3. Password Check
            if (!password || password.length < 8) {
                document.getElementById('regPassword').classList.add('error');
                document.getElementById('regPassword').focus();
                showAlert('danger', 'Password Too Short', 'Password must be at least 8 characters in length.');
                return;
            }

            // 4. Password Match Check
            if (password !== confirm) {
                document.getElementById('regConfirm').classList.add('error');
                document.getElementById('regConfirm').focus();
                showAlert('danger', 'Passwords Do Not Match', 'The confirmation password does not match the password entered above.');
                return;
            }

            var resetLoading = function () {
                if (window.CampusVault && CampusVault.setButtonLoading) {
                    CampusVault.setButtonLoading(btn, false);
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '<span>Create Account</span>';
                }
            };

            // UI Loading State
            if (window.CampusVault && CampusVault.setButtonLoading) {
                CampusVault.setButtonLoading(btn, true);
            } else {
                btn.disabled = true;
                btn.innerHTML = '<span>Creating Account...</span>';
            }

            hideAlert();

            try {
                // Prepare payload according to role
                var endpoint = '';
                var payload = {};

                var nameParts = name.split(' ');
                var firstName = nameParts[0] || name;
                var lastName = nameParts.length > 1 ? nameParts.slice(1).join(' ') : ' ';

                if (role === 'student') {
                    endpoint = '@Url.Action("RegisterStudent", "Account")';
                    payload = {
                        FirstName: firstName,
                        LastName: lastName,
                        Email: email,
                        Password: password
                    };
                } else if (role === 'faculty') {
                    endpoint = '@Url.Action("RegisterFaculty", "Account")';
                    payload = {
                        FirstName: firstName,
                        LastName: lastName,
                        Email: email,
                        Password: password
                    };
                } else if (role === 'admin') {
                    endpoint = '@Url.Action("RegisterAdmin", "Account")';
                    payload = {
                        FirstName: firstName,
                        LastName: lastName,
                        Email: email,
                        Password: password
                    };
                } else {
                    resetLoading();
                    showAlert('warning', 'Invalid Role', 'Please select a valid university role.');
                    return;
                }

                // Real fetch call to server
                fetch(endpoint, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(payload)
                })
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error('Server returned HTTP ' + response.status);
                    }
                    return response.json();
                })
                .then(function (data) {
                    resetLoading();

                    if (data.success) {
                        showAlert('success', 'Account Created Successfully!', data.message + ' Redirecting to Sign In...');
                        setTimeout(function () {
                            window.location.href = '@Url.Action("Login", "Account")?registered=true&email=' + encodeURIComponent(email);
                        }, 1200);
                    } else {
                        showAlert('danger', 'Registration Failed', data.message || 'Unable to register. Please check your information.');
                    }
                })
                .catch(function (error) {
                    resetLoading();
                    showAlert('danger', 'Connection Error', 'Unable to reach the CampusVault service: ' + error.message);
                });
            } catch (err) {
                resetLoading();
                showAlert('danger', 'Form Error', 'An unexpected error occurred: ' + err.message);
            }
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', function () {
            handlePasswordInput();
            handleConfirmPasswordInput();
        });
    </script>
}

