<div id="chartTooltip" class="cv-chart-tooltip"></div>

@* ==================== 8. INTERACTIVE JAVASCRIPT ==================== *@
<script>
    // Tab Switching
    function switchReportTab(tabKey) {
        const tabs = ['overview', 'submissions', 'documents', 'classrooms'];
        tabs.forEach(t => {
            const btn = document.getElementById('tabBtn-' + t);
            const section = document.getElementById('section-' + t);
            if (btn && section) {
                if (t === tabKey) {
                    btn.classList.add('active');
                    section.classList.add('active');
                } else {
                    btn.classList.remove('active');
                    section.classList.remove('active');
                }
            }
        });
    }

    // Apply Filters simulation
    function applyReportFilters() {
        const year = document.getElementById('reportAcademicYear').value;
        const range = document.getElementById('reportDateRange').value;

        const summary = document.getElementById('reportStatusSummary');
        if (summary) {
            summary.innerHTML = `Scope: <strong>Platform-Wide Analytics &bull; ${range === 'all' ? 'All Time' : range} (${year})</strong>`;
        }

        showReportToast('Report Filter Updated', `Analyzing activity across all classrooms for AY ${year}.`, 'info');
    }

    function resetReportFilters() {
        document.getElementById('reportAcademicYear').value = '2026-2027';
        document.getElementById('reportDateRange').value = 'all';
        applyReportFilters();
    }

    // Export CSV simulation
    function exportReportsCsv() {
        showReportToast('Generating Academic Report CSV', 'Compiling submission trends, on-time rates, and classroom analytics...', 'info');
        setTimeout(() => {
            showReportToast('Export Complete', 'CampusVault_Academic_Activity_Report_2026.csv downloaded successfully.', 'success');
        }, 1200);
    }

    // SVG / Heatmap Tooltip
    function showSvgTip(evt, title, detail) {
        const tip = document.getElementById('chartTooltip');
        if (!tip) return;
        tip.innerHTML = `<strong>${title}</strong><br/>${detail}`;
        tip.style.left = (evt.clientX + 12) + 'px';
        tip.style.top = (evt.clientY - 30) + 'px';
        tip.style.display = 'block';
    }

    function hideSvgTip() {
        const tip = document.getElementById('chartTooltip');
        if (tip) tip.style.display = 'none';
    }

    // Toast notifications utility
    function showReportToast(title, message, type) {
        let toastContainer = document.getElementById('cv-admin-toast-container');
        if (!toastContainer) {
            toastContainer = document.createElement('div');
            toastContainer.id = 'cv-admin-toast-container';
            toastContainer.style.position = 'fixed';
            toastContainer.style.bottom = '24px';
            toastContainer.style.right = '24px';
            toastContainer.style.zIndex = '99999';
            toastContainer.style.display = 'flex';
            toastContainer.style.flexDirection = 'column';
            toastContainer.style.gap = '10px';
            document.body.appendChild(toastContainer);
        }

        const toast = document.createElement('div');
        toast.style.background = (type === 'success' ? '#064e3b' : '#0f172a');
        toast.style.color = '#fff';
        toast.style.border = (type === 'success' ? '1px solid #059669' : '1px solid #334155');
        toast.style.borderRadius = '8px';
        toast.style.padding = '12px 18px';
        toast.style.boxShadow = '0 10px 25px rgba(0,0,0,0.3)';
        toast.style.fontSize = '12px';
        toast.style.minWidth = '300px';
        toast.style.maxWidth = '420px';
        toast.style.animation = 'cvFadeIn 0.25s ease';

        toast.innerHTML = `
            <div style="display:flex;align-items:flex-start;gap:10px;">
                <div style="color:${type === 'success' ? '#34d399' : '#38bdf8'};flex-shrink:0;margin-top:1px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div style="flex:1;">
                    <div style="font-weight:700;font-size:13px;margin-bottom:2px;">${title}</div>
                    <div style="color:rgba(255,255,255,0.8);font-size:11.5px;line-height:1.4;">${message}</div>
                </div>
            </div>
        `;

        toastContainer.appendChild(toast);
        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.3s ease';
            setTimeout(() => toast.remove(), 300);
        }, 3800);
    }
</script>
