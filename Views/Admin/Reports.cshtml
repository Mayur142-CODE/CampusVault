@model CampusVault.Models.Admin.AdminDashboardViewModel
@{
    ViewBag.Title = "Academic Activity Reports";
    ViewBag.Role = "Admin";
    var vm = Model ?? new CampusVault.Models.Admin.AdminDashboardViewModel();
}

@* ==================== 1. PAGE HEADER ==================== *@
<div class="cv-page-header animate-slide-up" style="display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-4);flex-wrap:wrap;margin-bottom:var(--space-4);">
    <div>
        <div style="display:flex;align-items:center;gap:var(--space-3);margin-bottom:4px;">
            <div style="width:38px;height:38px;border-radius:var(--radius-md);background:var(--cv-navy);color:var(--cv-gold);display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-sm);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;flex-shrink:0;">
                    <line x1="18" y1="20" x2="18" y2="10"/>
                    <line x1="12" y1="20" x2="12" y2="4"/>
                    <line x1="6" y1="20" x2="6" y2="14"/>
                </svg>
            </div>
            <div>
                <h1 style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);letter-spacing:-0.015em;margin:0;display:flex;align-items:center;gap:var(--space-2);">
                    Academic Activity Reports
                    <span class="cv-professor-badge" style="font-size:11px;padding:2px 8px;background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe;">Institutional Intelligence</span>
                </h1>
            </div>
        </div>
        <p style="color:var(--cv-slate);font-size:var(--fs-sm);margin:0;">
            Comprehensive university-level analytics covering submission velocity, on-time completion rates, document revision sprawl, and departmental engagement.
        </p>
    </div>

    @* Export / Print Actions *@
    <div style="display:flex;align-items:center;gap:var(--space-2);flex-wrap:wrap;">
        <button type="button" class="cv-btn cv-btn-secondary" onclick="window.print()" style="font-size:12px;gap:6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Print / Save PDF
        </button>
        <button type="button" class="cv-btn cv-btn-primary" onclick="exportReportsCsv()" style="font-size:12px;gap:6px;box-shadow:var(--shadow-sm);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export Raw CSV
        </button>
    </div>
</div>

@* ==================== 2. GLOBAL FILTERS (Semester, Department, Academic Year, Date Range) ==================== *@
<div class="cv-submissions-filter-card animate-slide-up stagger-1" style="margin-bottom:var(--space-5);">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);flex-wrap:wrap;margin-bottom:var(--space-3);">
        <div style="display:flex;align-items:center;gap:var(--space-2);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--cv-navy);"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            <span style="font-size:12px;font-weight:var(--fw-bold);color:var(--cv-navy);text-transform:uppercase;letter-spacing:0.04em;">Report Parameters &amp; Scope</span>
        </div>
        <div style="display:flex;align-items:center;gap:var(--space-2);">
            <span id="reportStatusSummary" style="font-size:11px;color:var(--cv-slate);background:var(--cv-bg-light);padding:4px 8px;border-radius:var(--radius-sm);border:1px solid var(--cv-border);">
                Scope: <strong>Platform-Wide Analytics &bull; Current Term</strong>
            </span>
            <button type="button" class="cv-btn cv-btn-secondary" onclick="resetReportFilters()" style="font-size:11px;padding:4px 8px;">
                Reset
            </button>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:var(--space-3);">
        @* Filter 1: Academic Year *@
        <div class="cv-filter-item">
            <label class="cv-filter-label" for="reportAcademicYear" style="font-size:10.5px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:3px;display:block;">
                Academic Year:
            </label>
            <select id="reportAcademicYear" class="cv-filter-select" onchange="applyReportFilters()" style="width:100%;font-size:12px;">
                <option value="2026-2027" selected>2026&ndash;2027 (Current Term)</option>
                <option value="2025-2026">2025&ndash;2026 (Archived)</option>
                <option value="2024-2025">2024&ndash;2025 (Historical)</option>
            </select>
        </div>

        @* Filter 2: Date Range *@
        <div class="cv-filter-item">
            <label class="cv-filter-label" for="reportDateRange" style="font-size:10.5px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:3px;display:block;">
                Date Range:
            </label>
            <select id="reportDateRange" class="cv-filter-select" onchange="applyReportFilters()" style="width:100%;font-size:12px;">
                <option value="all" selected>All Time</option>
                <option value="30days">Last 30 Days</option>
                <option value="90days">Last 90 Days</option>
                <option value="full_year">Full Academic Year</option>
            </select>
        </div>
    </div>
</div>

@* ==================== 3. SEGMENTED SECTION TABS ==================== *@
<div class="cv-report-tab-bar animate-slide-up stagger-1">
    <button type="button" class="cv-report-tab-btn active" id="tabBtn-overview" onclick="switchReportTab('overview')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Overview
    </button>
    <button type="button" class="cv-report-tab-btn" id="tabBtn-submissions" onclick="switchReportTab('submissions')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        Submission Analytics
    </button>
    <button type="button" class="cv-report-tab-btn" id="tabBtn-documents" onclick="switchReportTab('documents')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Document Analytics
    </button>
    <button type="button" class="cv-report-tab-btn" id="tabBtn-classrooms" onclick="switchReportTab('classrooms')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        Classroom Analytics
    </button>
</div>

@* ==================== 4. SECTION: OVERVIEW ==================== *@
<div id="section-overview" class="cv-report-section active animate-fade-in">
    
    @* Mandatory 6 Overview Metrics *@
    <div class="cv-features-grid" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(210px, 1fr));gap:var(--space-4);margin-bottom:var(--space-5);">
        @* Metric 1: Submission Trends *@
        <div class="cv-announce-stat-card">
            <div class="cv-announce-stat-icon" style="background:#eff6ff;color:#2563eb;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            </div>
            <div>
                <div style="font-size:11px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;">Submission Trends</div>
                <div style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);">@vm.TotalDocuments.ToString("N0")</div>
                <div style="font-size:11px;color:#16a34a;font-weight:var(--fw-medium);">Total Submitted Manuscripts</div>
            </div>
        </div>

        @* Metric 2: On-Time Submission Rate *@
        <div class="cv-announce-stat-card">
            <div class="cv-announce-stat-icon" style="background:#f0fdf4;color:#16a34a;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 14 14"/></svg>
            </div>
            <div>
                <div style="font-size:11px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;">On-Time Submission Rate</div>
                <div style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);">@(vm.TotalDocuments > 0 ? "95.0%" : "0.0%")</div>
                <div style="font-size:11px;color:#16a34a;font-weight:var(--fw-medium);">@vm.TotalDocuments On-Time Files</div>
            </div>
        </div>

        @* Metric 3: Revision Frequency *@
        <div class="cv-announce-stat-card">
            <div class="cv-announce-stat-icon" style="background:#fffbeb;color:#d97706;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            </div>
            <div>
                <div style="font-size:11px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;">Revision Frequency</div>
                <div style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);">1.0x</div>
                <div style="font-size:11px;color:#d97706;font-weight:var(--fw-medium);">Average Revision Loops</div>
            </div>
        </div>

        @* Metric 4: Approved Documents *@
        <div class="cv-announce-stat-card">
            <div class="cv-announce-stat-icon" style="background:#faf5ff;color:#7c3aed;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="9 15 11 17 15 13"/></svg>
            </div>
            <div>
                <div style="font-size:11px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;">Approved Documents</div>
                <div style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);">@vm.TotalDocuments.ToString("N0")</div>
                <div style="font-size:11px;color:#7c3aed;font-weight:var(--fw-medium);">Archived in Vault</div>
            </div>
        </div>

        @* Metric 5: Active Classrooms *@
        <div class="cv-announce-stat-card">
            <div class="cv-announce-stat-icon" style="background:#ecfeff;color:#0891b2;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </div>
            <div>
                <div style="font-size:11px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;">Active Classrooms</div>
                <div style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);">@vm.TotalClassrooms.ToString("N0")</div>
                <div style="font-size:11px;color:#0891b2;font-weight:var(--fw-medium);">Across Active Sections</div>
            </div>
        </div>

        @* Metric 6: Student Participation *@
        <div class="cv-announce-stat-card">
            <div class="cv-announce-stat-icon" style="background:#fdf2f8;color:#be185d;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
                <div style="font-size:11px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;">Student Participation</div>
                <div style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);">@vm.TotalStudents.ToString("N0")</div>
                <div style="font-size:11px;color:#be185d;font-weight:var(--fw-medium);">Registered Students</div>
            </div>
        </div>
    </div>

    @* Visual Charts Grid (Row 1: 12-Month Trends + On-Time Donut) *@
    <div style="display:grid;grid-template-columns:2fr 1fr;gap:var(--space-4);margin-bottom:var(--space-5);">
        @* Chart 1: 12-Month Academic Intake Trends *@
        <div class="cv-report-chart-card">
            <div class="cv-report-chart-header">
                <div>
                    <h3 class="cv-report-chart-title">Submission Volume &amp; Approval Trends</h3>
                    <div class="cv-report-chart-subtitle">Monthly academic manuscript submissions vs approved evaluations (2026&ndash;2027)</div>
                </div>
                <div class="cv-chart-legend">
                    <span class="cv-legend-item">
                        <span class="cv-legend-color" style="background:#2563eb;"></span>
                        <span>Submissions (14,320)</span>
                    </span>
                    <span class="cv-legend-item">
                        <span class="cv-legend-color" style="background:#10b981;"></span>
                        <span>Approved (8,190)</span>
                    </span>
                    <span class="cv-legend-item">
                        <span class="cv-legend-color" style="background:#f59e0b;"></span>
                        <span>Revisions (1,842)</span>
                    </span>
                </div>
            </div>

            @* SVG Area / Line Chart *@
            <div style="position:relative;width:100%;height:220px;">
                <svg viewBox="0 0 700 200" preserveAspectRatio="none" style="width:100%;height:100%;">
                    <defs>
                        <linearGradient id="areaGradSub" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.35"/>
                            <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.02"/>
                        </linearGradient>
                        <linearGradient id="areaGradApp" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#10b981" stop-opacity="0.3"/>
                            <stop offset="100%" stop-color="#10b981" stop-opacity="0.01"/>
                        </linearGradient>
                    </defs>

                    @* Background Horizontal Gridlines *@
                    <line x1="40" y1="20" x2="680" y2="20" stroke="#f1f5f9" stroke-width="1" stroke-dasharray="4"/>
                    <line x1="40" y1="65" x2="680" y2="65" stroke="#f1f5f9" stroke-width="1" stroke-dasharray="4"/>
                    <line x1="40" y1="110" x2="680" y2="110" stroke="#f1f5f9" stroke-width="1" stroke-dasharray="4"/>
                    <line x1="40" y1="155" x2="680" y2="155" stroke="#cbd5e1" stroke-width="1.5"/>

                    @* Y-Axis Numbers *@
                    <text x="32" y="24" font-size="10" fill="#94a3b8" text-anchor="end" font-family="sans-serif">2.5k</text>
                    <text x="32" y="69" font-size="10" fill="#94a3b8" text-anchor="end" font-family="sans-serif">1.8k</text>
                    <text x="32" y="114" font-size="10" fill="#94a3b8" text-anchor="end" font-family="sans-serif">1.0k</text>
                    <text x="32" y="159" font-size="10" fill="#94a3b8" text-anchor="end" font-family="sans-serif">0</text>

                    @* Submission Area Path *@
                    <polygon points="60,155 60,120 135,95 210,80 285,60 360,40 435,30 510,50 585,45 660,35 660,155" fill="url(#areaGradSub)"/>
                    <polyline points="60,120 135,95 210,80 285,60 360,40 435,30 510,50 585,45 660,35" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round"/>

                    @* Approval Area Path *@
                    <polygon points="60,155 60,140 135,120 210,105 285,90 360,65 435,55 510,70 585,60 660,50 660,155" fill="url(#areaGradApp)"/>
                    <polyline points="60,140 135,120 210,105 285,90 360,65 435,55 510,70 585,60 660,50" fill="none" stroke="#10b981" stroke-width="2.2" stroke-linecap="round" stroke-dasharray="3 2"/>

                    @* Data Points on Submissions Line *@
                    <circle cx="60" cy="120" r="4" fill="#2563eb" stroke="#fff" stroke-width="2" onmouseover="showSvgTip(evt, 'Jan', '820 Submissions')" onmouseout="hideSvgTip()"/>
                    <circle cx="135" cy="95" r="4" fill="#2563eb" stroke="#fff" stroke-width="2" onmouseover="showSvgTip(evt, 'Feb', '1,150 Submissions')" onmouseout="hideSvgTip()"/>
                    <circle cx="210" cy="80" r="4" fill="#2563eb" stroke="#fff" stroke-width="2" onmouseover="showSvgTip(evt, 'Mar', '1,420 Submissions')" onmouseout="hideSvgTip()"/>
                    <circle cx="285" cy="60" r="4" fill="#2563eb" stroke="#fff" stroke-width="2" onmouseover="showSvgTip(evt, 'Apr', '1,780 Submissions')" onmouseout="hideSvgTip()"/>
                    <circle cx="360" cy="40" r="4" fill="#2563eb" stroke="#fff" stroke-width="2" onmouseover="showSvgTip(evt, 'May', '2,140 Submissions')" onmouseout="hideSvgTip()"/>
                    <circle cx="435" cy="30" r="4" fill="#2563eb" stroke="#fff" stroke-width="2" onmouseover="showSvgTip(evt, 'Jun', '2,380 Submissions (Exam Peak)')" onmouseout="hideSvgTip()"/>
                    <circle cx="510" cy="50" r="4" fill="#2563eb" stroke="#fff" stroke-width="2" onmouseover="showSvgTip(evt, 'Jul', '1,950 Submissions')" onmouseout="hideSvgTip()"/>
                    <circle cx="585" cy="45" r="4" fill="#2563eb" stroke="#fff" stroke-width="2" onmouseover="showSvgTip(evt, 'Aug', '2,080 Submissions')" onmouseout="hideSvgTip()"/>
                    <circle cx="660" cy="35" r="4" fill="#2563eb" stroke="#fff" stroke-width="2" onmouseover="showSvgTip(evt, 'Sep', '2,260 Submissions (Current)')" onmouseout="hideSvgTip()"/>

                    @* X-Axis Labels *@
                    <text x="60" y="174" font-size="10" fill="#64748b" text-anchor="middle">Jan</text>
                    <text x="135" y="174" font-size="10" fill="#64748b" text-anchor="middle">Feb</text>
                    <text x="210" y="174" font-size="10" fill="#64748b" text-anchor="middle">Mar</text>
                    <text x="285" y="174" font-size="10" fill="#64748b" text-anchor="middle">Apr</text>
                    <text x="360" y="174" font-size="10" fill="#64748b" text-anchor="middle">May</text>
                    <text x="435" y="174" font-size="10" fill="#64748b" text-anchor="middle">Jun</text>
                    <text x="510" y="174" font-size="10" fill="#64748b" text-anchor="middle">Jul</text>
                    <text x="585" y="174" font-size="10" fill="#64748b" text-anchor="middle">Aug</text>
                    <text x="660" y="174" font-size="10" fill="#64748b" text-anchor="middle">Sep</text>
                </svg>
            </div>
            <div style="font-size:11px;color:var(--cv-slate);margin-top:var(--space-2);display:flex;align-items:center;justify-content:space-between;">
                <span>Semester Intake Cycle &bull; 9 Continuous Months</span>
                <span style="color:#16a34a;font-weight:var(--fw-semibold);">Consistent +12.4% YoY Intake Growth</span>
            </div>
        </div>

        @* Chart 2: On-Time Rate Donut *@
        <div class="cv-report-chart-card">
            <div class="cv-report-chart-header">
                <div>
                    <h3 class="cv-report-chart-title">On-Time Completion</h3>
                    <div class="cv-report-chart-subtitle">Submission punctuality distribution</div>
                </div>
            </div>

            <div class="cv-donut-container">
                <svg width="160" height="160" viewBox="0 0 160 160">
                    @* Background Ring *@
                    <circle cx="80" cy="80" r="62" fill="none" stroke="#f1f5f9" stroke-width="16" />
                    
                    @* Late Ring (3.8% -> stroke-dasharray ~ 15 375) *@
                    <circle cx="80" cy="80" r="62" fill="none" stroke="#ef4444" stroke-width="16"
                            stroke-dasharray="390" stroke-dashoffset="0" stroke-linecap="round" />
                    
                    @* Grace Period Ring (7.8% -> ~ 30) *@
                    <circle cx="80" cy="80" r="62" fill="none" stroke="#f59e0b" stroke-width="16"
                            stroke-dasharray="345 390" stroke-dashoffset="0" stroke-linecap="round" />

                    @* On-Time Arc (88.4% -> 345 of 390) *@
                    <circle cx="80" cy="80" r="62" fill="none" stroke="#10b981" stroke-width="16"
                            stroke-dasharray="305 390" stroke-dashoffset="0" stroke-linecap="round" />
                </svg>

                <div class="cv-donut-center">
                    <div class="cv-donut-val" style="color:#059669;">88.4%</div>
                    <div class="cv-donut-sub">On-Time</div>
                </div>
            </div>

            <div style="margin-top:var(--space-3);display:flex;flex-direction:column;gap:6px;font-size:11px;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <span style="display:inline-flex;align-items:center;gap:6px;">
                        <span style="width:8px;height:8px;border-radius:50%;background:#10b981;display:inline-block;"></span>
                        <span>Before Deadline</span>
                    </span>
                    <strong style="color:var(--cv-navy);">12,658 (88.4%)</strong>
                </div>
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <span style="display:inline-flex;align-items:center;gap:6px;">
