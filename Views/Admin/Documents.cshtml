@model List<CampusVault.Models.Admin.AdminDocumentItem>
@using System.Linq
@{
    var docs = Model ?? new List<CampusVault.Models.Admin.AdminDocumentItem>();
    int totalDocs = docs.Count;
    int approvedCount = docs.Count(d => (d.Status ?? "").Contains("Approved"));
    int reviewCount = docs.Count(d => (d.Status ?? "").Contains("Review") || (d.Status ?? "").Contains("Submitted") || (d.Status ?? "").Contains("Pending"));
    int revisionCount = docs.Count(d => (d.Status ?? "").Contains("Revision"));

    var studentList = docs.Select(d => d.StudentName).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s).ToList();
    var facultyList = docs.Select(d => d.FacultyName).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s).ToList();
    var courseList = docs.Select(d => d.CourseName).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s).ToList();
    var taskList = docs.Select(d => d.TaskTitle).Where(s => !string.IsNullOrEmpty(s)).Distinct().OrderBy(s => s).ToList();
}

@* ==================== 1. PAGE HEADER ==================== *@
<div class="cv-page-header animate-slide-up" style="display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-4);flex-wrap:wrap;margin-bottom:var(--space-4);">
    <div>
        <div style="display:flex;align-items:center;gap:var(--space-3);margin-bottom:4px;">
            <div style="width:38px;height:38px;border-radius:var(--radius-md);background:var(--cv-navy);color:var(--cv-gold);display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-sm);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;flex-shrink:0;">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                    <polyline points="10 9 9 9 8 9"/>
                </svg>
            </div>
            <div>
                <h1 style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);letter-spacing:-0.015em;margin:0;display:flex;align-items:center;gap:var(--space-2);">
                    Document Management
                    <span class="cv-admin-scope-pill">Vault Surveillance</span>
                </h1>
            </div>
        </div>
        <p style="color:var(--cv-slate);font-size:var(--fs-sm);margin:0;">
            Institutional repository surveillance, storage allocation, cryptographic SHA-256 verification, and version tracking across all university academic classrooms.
        </p>
    </div>

    @* Header Actions *@
    <div style="display:flex;align-items:center;gap:var(--space-2);flex-wrap:wrap;">
        <button type="button" class="cv-btn cv-btn-secondary" onclick="runCryptographicAudit()" style="font-size:12px;gap:6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;flex-shrink:0;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Verify Checksums
        </button>
        <button type="button" class="cv-btn cv-btn-primary" onclick="exportDocumentAuditReport()" style="font-size:12px;gap:6px;box-shadow:var(--shadow-sm);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="width:14px;height:14px;flex-shrink:0;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export Audit Ledger
        </button>
    </div>
</div>

@* ==================== 2. ADMINISTRATIVE AUDIT & NON-GRADING SCOPE BANNER ==================== *@
<div class="cv-admin-doc-banner animate-slide-up">
    <div class="cv-admin-doc-banner-top">
        <div style="flex:1;min-width:280px;">
            <div style="display:flex;align-items:center;gap:var(--space-2);margin-bottom:var(--space-2);">
                <span class="cv-admin-scope-pill" style="background:rgba(217, 164, 65, 0.2);color:var(--cv-gold);border-color:rgba(217, 164, 65, 0.5);">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:12px;height:12px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    Platform Audit Mode &bull; Non-Grading View
                </span>
                <span style="font-size:11px;color:rgba(255,255,255,0.7);display:inline-flex;align-items:center;gap:4px;">
                    <span style="width:7px;height:7px;border-radius:50%;background:#34d399;display:inline-block;"></span>
                    Audit Node: <strong>US-EAST-VAULT-01</strong>
                </span>
            </div>
            <h2 style="font-family:var(--font-heading);font-size:var(--fs-lg);font-weight:var(--fw-bold);color:var(--cv-white);margin:0 0 4px 0;">
                Institutional Academic Vault Governance
            </h2>
            <p style="font-size:var(--fs-xs);color:rgba(255,255,255,0.8);margin:0;max-width:820px;line-height:1.5;">
                As a system administrator, your access is focused exclusively on platform surveillance: storage quotas, cryptographic hash integrity (SHA-256), version sprawl tracking, and regulatory audit compliance. <strong>Academic evaluations, rubric marks, and submission approvals remain isolated to faculty mentors.</strong>
            </p>
        </div>

        @* Mini Ingestion Telemetry *@
        <div style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.16);border-radius:var(--radius-lg);padding:var(--space-3) var(--space-4);text-align:right;min-width:190px;">
            <div style="font-size:10px;color:rgba(255,255,255,0.65);text-transform:uppercase;letter-spacing:0.06em;">Cryptographic Status</div>
            <div style="font-size:var(--fs-base);font-weight:var(--fw-bold);color:#34d399;margin:2px 0;display:flex;align-items:center;justify-content:flex-end;gap:5px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>100% Verified</span>
            </div>
            <div style="font-size:11px;color:rgba(255,255,255,0.75);">0 Tamper Flags Detected</div>
        </div>
    </div>

    @* Compliance Disclaimer Strip *@
    <div class="cv-admin-doc-disclaimer">
        <div class="cv-admin-doc-disclaimer-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        </div>
        <div>
            <strong>Administrative Role Separation:</strong> Viewing a submission renders technical file metadata, version diff timestamps, and storage signatures. Grading controls, marks awarding, and revision approvals are strictly disabled in administrative sessions.
        </div>
    </div>
</div>

@* ==================== 3. SUMMARY METRICS STRIP ==================== *@
<div class="cv-features-grid animate-slide-up stagger-1" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(210px, 1fr));gap:var(--space-4);margin-bottom:var(--space-5);">
    @* Metric 1: Total Documents *@
    <div class="cv-announce-stat-card">
        <div class="cv-announce-stat-icon" style="background:#eff6ff;color:#2563eb;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <div>
            <div style="font-size:11px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;">Total Documents</div>
            <div style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);" id="statTotalDocs">@totalDocs</div>
            <div style="font-size:11px;color:#2563eb;font-weight:var(--fw-medium);">Across @courseList.Count Courses</div>
        </div>
    </div>

    @* Metric 2: Approved *@
    <div class="cv-announce-stat-card">
        <div class="cv-announce-stat-icon" style="background:#f0fdf4;color:#16a34a;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div>
            <div style="font-size:11px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;">Approved</div>
            <div style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);">@approvedCount</div>
            <div style="font-size:11px;color:#16a34a;font-weight:var(--fw-medium);">@(totalDocs > 0 ? (approvedCount * 100 / totalDocs) : 0)% Approval Rate</div>
        </div>
    </div>

    @* Metric 3: Under Review *@
    <div class="cv-announce-stat-card">
        <div class="cv-announce-stat-icon" style="background:#fef3c7;color:#d97706;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div>
            <div style="font-size:11px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;">Under Review</div>
            <div style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);">@reviewCount</div>
            <div style="font-size:11px;color:#d97706;font-weight:var(--fw-medium);">Pending Evaluation</div>
        </div>
    </div>

    @* Metric 4: Revision Requested *@
    <div class="cv-announce-stat-card">
        <div class="cv-announce-stat-icon" style="background:#faf5ff;color:#7c3aed;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        </div>
        <div>
            <div style="font-size:11px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;">Revision Requests</div>
            <div style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);">@revisionCount</div>
            <div style="font-size:11px;color:#7c3aed;font-weight:var(--fw-medium);">Awaiting Resubmission</div>
        </div>
    </div>
</div>

@* ==================== 4. SEARCH & SIX FILTERS (Student, Faculty, Classroom, Subject, Status, Version) ==================== *@
<div class="cv-submissions-filter-card animate-slide-up stagger-2" style="margin-bottom:var(--space-5);">
    @* Row 1: Global Search & Quick Summary *@
    <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);flex-wrap:wrap;margin-bottom:var(--space-4);">
        <div style="position:relative;flex:1;min-width:280px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--cv-slate-400);pointer-events:none;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="docSearchInput" class="cv-filter-input" placeholder="Search by filename, student, faculty, classroom, task, or SHA-256 hash..." oninput="filterDocumentsTable()" style="padding-left:34px;width:100%;" />
        </div>
        <div style="display:flex;align-items:center;gap:var(--space-2);">
            <button type="button" class="cv-btn cv-btn-secondary" onclick="resetAllFilters()" style="font-size:11px;padding:6px 12px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px;"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                Reset Filters
            </button>
            <span id="filteredDocsCountBadge" style="font-size:12px;color:var(--cv-slate);background:var(--cv-bg-light);padding:5px 10px;border-radius:var(--radius-sm);border:1px solid var(--cv-border);font-weight:var(--fw-semibold);">
                Showing @totalDocs of @totalDocs files
            </span>
        </div>
    </div>

    @* Row 2: 6 Mandatory Filters Grid *@
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(170px, 1fr));gap:var(--space-3);padding-top:var(--space-3);border-top:1px solid var(--cv-border-light);">
        @* Filter 1: Student *@
        <div class="cv-filter-item">
            <label class="cv-filter-label" for="filterStudent" style="font-size:10.5px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:3px;display:block;">
                Student:
            </label>
            <select id="filterStudent" class="cv-filter-select" onchange="filterDocumentsTable()" style="width:100%;font-size:12px;">
                <option value="all">All Students</option>
                @foreach (var s in studentList) {
                    <option value="@s">@s</option>
                }
            </select>
        </div>

        @* Filter 2: Faculty *@
        <div class="cv-filter-item">
            <label class="cv-filter-label" for="filterFaculty" style="font-size:10.5px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:3px;display:block;">
                Faculty:
            </label>
            <select id="filterFaculty" class="cv-filter-select" onchange="filterDocumentsTable()" style="width:100%;font-size:12px;">
                <option value="all">All Faculty</option>
                @foreach (var f in facultyList) {
                    <option value="@f">@f</option>
                }
            </select>
        </div>

        @* Filter 3: Course *@
        <div class="cv-filter-item">
            <label class="cv-filter-label" for="filterSubject" style="font-size:10.5px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:3px;display:block;">
                Course:
            </label>
            <select id="filterSubject" class="cv-filter-select" onchange="filterDocumentsTable()" style="width:100%;font-size:12px;">
                <option value="all">All Courses</option>
                @foreach (var c in courseList) {
                    <option value="@c">@c</option>
                }
            </select>
        </div>

        @* Filter 4: Task *@
        <div class="cv-filter-item">
            <label class="cv-filter-label" for="filterTask" style="font-size:10.5px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:3px;display:block;">
                Task:
            </label>
            <select id="filterTask" class="cv-filter-select" onchange="filterDocumentsTable()" style="width:100%;font-size:12px;">
                <option value="all">All Tasks</option>
                @foreach (var t in taskList) {
                    <option value="@t">@t</option>
                }
            </select>
        </div>

        @* Filter 5: Status *@
        <div class="cv-filter-item">
            <label class="cv-filter-label" for="filterStatus" style="font-size:10.5px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:3px;display:block;">
                Status:
            </label>
            <select id="filterStatus" class="cv-filter-select" onchange="filterDocumentsTable()" style="width:100%;font-size:12px;">
                <option value="all">All Statuses</option>
                <option value="Approved">Approved</option>
                <option value="Under Review">Under Review</option>
                <option value="Revision Requested">Revision Requested</option>
                <option value="Submitted">Submitted</option>
                <option value="Archived">Archived</option>
            </select>
        </div>

        @* Filter 6: Version *@
        <div class="cv-filter-item">
            <label class="cv-filter-label" for="filterVersion" style="font-size:10.5px;font-weight:var(--fw-bold);color:var(--cv-slate);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:3px;display:block;">
                Version:
            </label>
            <select id="filterVersion" class="cv-filter-select" onchange="filterDocumentsTable()" style="width:100%;font-size:12px;">
                <option value="all">All Versions</option>
                <option value="v1">Version 1 (Initial)</option>
                <option value="v2">Version 2 (Revision)</option>
                <option value="v3">Version 3+ (Iterative)</option>
            </select>
        </div>
    </div>

    @* Row 3: Fast Quick-Tag Pills *@
    <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:var(--space-3);padding-top:var(--space-2);">
        <span style="font-size:11px;color:var(--cv-slate);font-weight:var(--fw-bold);">Quick Views:</span>
        <button type="button" class="cv-status-pill" onclick="setQuickFilter('all')" id="qf-all" style="cursor:pointer;border:1px solid var(--cv-navy);background:var(--cv-navy);color:#fff;">All Documents</button>
        <button type="button" class="cv-status-pill" onclick="setQuickFilter('pdf')" id="qf-pdf" style="cursor:pointer;border:1px solid #fecaca;background:#fef2f2;color:#dc2626;">PDF Only</button>
        <button type="button" class="cv-status-pill" onclick="setQuickFilter('multiver')" id="qf-multiver" style="cursor:pointer;border:1px solid #fde68a;background:#fffbeb;color:#b45309;">Revised (v2+)</button>
        <button type="button" class="cv-status-pill" onclick="setQuickFilter('review')" id="qf-review" style="cursor:pointer;border:1px solid #bfdbfe;background:#eff6ff;color:#1d4ed8;">Under Review</button>
        <button type="button" class="cv-status-pill" onclick="setQuickFilter('revision')" id="qf-revision" style="cursor:pointer;border:1px solid #e9d5ff;background:#faf5ff;color:#7c3aed;">Revision Requested</button>
    </div>
</div>

@* ==================== 5. UNIVERSITY-WIDE DOCUMENTS LEDGER TABLE ==================== *@
<div class="cv-admin-docs-table-wrapper animate-slide-up stagger-3">
    <div style="padding:var(--space-3) var(--space-4);background:var(--cv-bg-light);border-bottom:1px solid var(--cv-border);display:flex;align-items:center;justify-content:space-between;gap:var(--space-2);flex-wrap:wrap;">
        <div style="display:flex;align-items:center;gap:var(--space-2);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--cv-gold);"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span style="font-size:12px;font-weight:var(--fw-bold);color:var(--cv-navy);text-transform:uppercase;letter-spacing:0.04em;">Central Repository Ledger</span>
        </div>
        <div style="font-size:11px;color:var(--cv-slate);display:flex;align-items:center;gap:var(--space-3);">
            <span>Storage Node: <strong>Ceph/S3 Distributed</strong></span>
            <span>Encoding: <strong>UTF-8 / Binary</strong></span>
        </div>
    </div>

    <table class="cv-admin-docs-table" id="adminDocumentsTable">
        <thead>
            <tr>
                <th style="min-width:210px;">Filename</th>
                <th style="min-width:150px;">Student</th>
                <th style="min-width:140px;">Faculty</th>
                <th style="min-width:140px;">Classroom</th>
                <th style="min-width:150px;">Task</th>
                <th style="width:75px;text-align:center;">Version</th>
                <th style="width:125px;">Status</th>
                <th style="min-width:125px;">Date</th>
                <th style="width:105px;text-align:center;">Actions</th>
            </tr>
        </thead>
        <tbody id="adminDocumentsTableBody">
            @if (docs.Count == 0) {
                <tr><td colspan="8" style="text-align:center;padding:var(--space-6);color:var(--cv-slate);">
                    <div style="font-size:var(--fs-base);font-weight:var(--fw-bold);color:var(--cv-navy);margin-bottom:4px;">No Submissions Found</div>
                    <div style="font-size:var(--fs-sm);">No academic documents have been submitted yet.</div>
                </td></tr>
            } else {
                foreach (var doc in docs) {
                    var ext = System.IO.Path.GetExtension(doc.FileName ?? "").TrimStart('.').ToUpper();
                    if (string.IsNullOrEmpty(ext)) { ext = "FILE"; }
                    var extClass = (ext == "PDF") ? "pdf" : (ext == "ZIP" || ext == "RAR") ? "zip" : (ext == "DOCX" || ext == "DOC") ? "docx" : "code";
                    var statusClass = "cv-badge-info";
                    var statusDot = "#0284c7";
                    if ((doc.Status ?? "").Contains("Approved") || (doc.Status ?? "").Contains("Graded")) { statusClass = "cv-badge-success"; statusDot = "#16a34a"; }
                    else if ((doc.Status ?? "").Contains("Revision")) { statusClass = "cv-badge-purple"; statusDot = "#9333ea"; }
                    else if ((doc.Status ?? "").Contains("Review")) { statusClass = "cv-badge-warning"; statusDot = "#d97706"; }
                    else if ((doc.Status ?? "").Contains("Archive")) { statusClass = "cv-badge-neutral"; statusDot = "#64748b"; }
                    var initials = string.Join("", (doc.StudentName ?? "?").Split(' ').Take(2).Select(w => w.Length > 0 ? w[0].ToString().ToUpper() : ""));
                    var hashDisplay = (doc.Sha256Hash != null && doc.Sha256Hash.Length > 8) ? "sha256:" + doc.Sha256Hash.Substring(0, 4) + "..." + doc.Sha256Hash.Substring(doc.Sha256Hash.Length - 4) : (doc.Sha256Hash ?? "sha256-pending");
                    <tr data-filename="@doc.FileName"
                        data-student="@doc.StudentName"
                        data-student-id="@doc.RollNo"
                        data-faculty="@doc.FacultyName"
                        data-subject="@doc.CourseName"
                        data-task="@doc.TaskTitle"
                        data-status="@doc.Status"
                        data-date="@doc.SubmittedAt.ToString("yyyy-MM-dd")"
                        data-type="@extClass"
                        data-filesize="@doc.FileSize"
                        data-hash="@doc.Sha256Hash">
                        <td data-label="Filename">
                            <div style="display:flex;align-items:center;gap:var(--space-3);">
                                <span class="cv-doc-format-badge @extClass">@ext</span>
                                <div>
                                    <div style="font-weight:var(--fw-semibold);color:var(--cv-ink);">@doc.FileName</div>
                                    <div style="display:flex;align-items:center;gap:6px;margin-top:2px;">
                                        <span style="font-size:11px;color:var(--cv-slate);">@doc.FileSize</span>
                                        <span class="cv-hash-badge" title="Full SHA-256: @doc.Sha256Hash">@hashDisplay</span>
                                    </div>
                                </div>
                            </div>
                        </td>
