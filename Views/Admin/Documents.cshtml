@* ==================== 7. INTERACTIVE JAVASCRIPT LOGIC ==================== *@
<script>
    let activeQuickFilter = 'all';
    let currentModalDocData = null;

    // Filter table across search and 6 filters
    function filterDocumentsTable() {
        const query = (document.getElementById('docSearchInput').value || '').trim().toLowerCase();
        const selStudent = document.getElementById('filterStudent').value;
        const selFaculty = document.getElementById('filterFaculty').value;
        const selClassroom = document.getElementById('filterClassroom').value;
        const selSubject = document.getElementById('filterSubject').value;
        const selStatus = document.getElementById('filterStatus').value;
        const selVersion = document.getElementById('filterVersion').value;

        const tableBody = document.getElementById('adminDocumentsTableBody');
        const rows = tableBody.getElementsByTagName('tr');
        let visibleCount = 0;

        for (let i = 0; i < rows.length; i++) {
            const tr = rows[i];
            const filename = tr.getAttribute('data-filename') || '';
            const student = tr.getAttribute('data-student') || '';
            const studentId = tr.getAttribute('data-student-id') || '';
            const faculty = tr.getAttribute('data-faculty') || '';
            const classroom = tr.getAttribute('data-classroom') || '';
            const subject = tr.getAttribute('data-subject') || '';
            const task = tr.getAttribute('data-task') || '';
            const version = tr.getAttribute('data-version') || '';
            const status = tr.getAttribute('data-status') || '';
            const filetype = tr.getAttribute('data-type') || '';
            const hash = tr.getAttribute('data-hash') || '';

            // Search matches filename, student, studentId, faculty, classroom, task, hash
            const searchable = (filename + ' ' + student + ' ' + studentId + ' ' + faculty + ' ' + classroom + ' ' + subject + ' ' + task + ' ' + hash).toLowerCase();
            const matchesQuery = !query || searchable.indexOf(query) !== -1;

            // 6 Dropdown Filters
            const matchesStudent = (selStudent === 'all') || (student === selStudent);
            const matchesFaculty = (selFaculty === 'all') || (faculty === selFaculty);
            const matchesClassroom = (selClassroom === 'all') || (classroom === selClassroom);
            const matchesSubject = (selSubject === 'all') || (subject === selSubject);
            const matchesStatus = (selStatus === 'all') || (status === selStatus);
            
            let matchesVersion = true;
            if (selVersion === 'v1') matchesVersion = (version === 'v1');
            else if (selVersion === 'v2') matchesVersion = (version === 'v2');
            else if (selVersion === 'v3') matchesVersion = (version === 'v3' || version === 'v3plus');

            // Quick Tag filter
            let matchesQuick = true;
            if (activeQuickFilter === 'pdf') matchesQuick = (filetype === 'pdf');
            else if (activeQuickFilter === 'multiver') matchesQuick = (version === 'v2' || version === 'v3' || version === 'v3plus');
            else if (activeQuickFilter === 'review') matchesQuick = (status === 'Under Review');
            else if (activeQuickFilter === 'revision') matchesQuick = (status === 'Revision Requested');

            if (matchesQuery && matchesStudent && matchesFaculty && matchesClassroom && matchesSubject && matchesStatus && matchesVersion && matchesQuick) {
                tr.style.display = '';
                visibleCount++;
            } else {
                tr.style.display = 'none';
            }
        }

        // Update count badge & empty state
        const badge = document.getElementById('filteredDocsCountBadge');
        if (badge) {
            badge.innerText = 'Showing ' + visibleCount + ' of ' + rows.length + ' files';
        }

        const emptyMsg = document.getElementById('noDocsFoundMessage');
        if (emptyMsg) {
            emptyMsg.style.display = (visibleCount === 0) ? 'block' : 'none';
        }
    }

    // Set quick filter pills
    function setQuickFilter(key) {
        activeQuickFilter = key;
        const keys = ['all', 'pdf', 'multiver', 'review', 'revision'];
        keys.forEach(k => {
            const btn = document.getElementById('qf-' + k);
            if (btn) {
                if (k === key) {
                    btn.style.background = 'var(--cv-navy)';
                    btn.style.color = '#fff';
                    btn.style.borderColor = 'var(--cv-navy)';
                } else {
                    btn.style.background = 'var(--cv-bg-light)';
                    btn.style.color = 'var(--cv-slate)';
                    btn.style.borderColor = 'var(--cv-border)';
                }
            }
        });
        filterDocumentsTable();
    }

    // Reset all 6 filters and search input
    function resetAllFilters() {
        document.getElementById('docSearchInput').value = '';
        document.getElementById('filterStudent').value = 'all';
        document.getElementById('filterFaculty').value = 'all';
        document.getElementById('filterClassroom').value = 'all';
        document.getElementById('filterSubject').value = 'all';
        document.getElementById('filterStatus').value = 'all';
        document.getElementById('filterVersion').value = 'all';
        activeQuickFilter = 'all';
        setQuickFilter('all');
        filterDocumentsTable();
    }

    // Open Document Platform Audit Modal
    function openDocAuditModal(btn) {
        const tr = btn.closest('tr');
        if (!tr) return;

        const filename = tr.getAttribute('data-filename');
        const student = tr.getAttribute('data-student');
        const studentId = tr.getAttribute('data-student-id');
        const faculty = tr.getAttribute('data-faculty');
        const facultyDept = tr.getAttribute('data-faculty-dept') || 'Academic Faculty';
        const classroom = tr.getAttribute('data-classroom');
        const subject = tr.getAttribute('data-subject');
        const task = tr.getAttribute('data-task');
        const version = tr.getAttribute('data-version');
        const status = tr.getAttribute('data-status');
        const filesize = tr.getAttribute('data-filesize');
        const hash = tr.getAttribute('data-hash');

        currentModalDocData = { filename, student, studentId, faculty, classroom, task, hash, filesize };

        document.getElementById('modalDocSubtitle').innerText = 'File: ' + filename + ' \u2022 SHA-256 Ledger';
        document.getElementById('modalNoticeFaculty').innerText = faculty;
        document.getElementById('modalFileName').innerText = filename;
        document.getElementById('modalMimeType').innerText = (filename.endsWith('.pdf') ? 'application/pdf' : filename.endsWith('.zip') ? 'application/zip' : 'text/x-c') + ' \u2022 ' + filesize;
        document.getElementById('modalStorageUri').innerText = 's3://campusvault-store/2026/' + classroom.toLowerCase().replace(/[^a-z0-9]/g, '-') + '/' + filename.toLowerCase();
        document.getElementById('modalFullHash').innerText = hash;
        document.getElementById('modalStudentName').innerText = student;
        document.getElementById('modalStudentId').innerText = 'Roll No: ' + studentId + ' \u2022 Enrolled';
        document.getElementById('modalFacultyName').innerText = faculty;
        document.getElementById('modalFacultyDept').innerText = facultyDept;
        document.getElementById('modalClassroomName').innerText = classroom;
        document.getElementById('modalSubjectName').innerText = subject;
        document.getElementById('modalTaskName').innerText = task;
        
        const verBadge = document.getElementById('modalVersionBadge');
        verBadge.innerText = version;
        verBadge.className = 'cv-admin-ver-pill ' + (version === 'v1' ? 'v1' : version === 'v2' ? 'v2' : 'v3plus');

        const statusBadge = document.getElementById('modalStatusBadge');
        statusBadge.innerText = status;
        statusBadge.className = 'cv-badge ' + (status === 'Approved' ? 'cv-badge-success' : status === 'Under Review' ? 'cv-badge-warning' : status === 'Revision Requested' ? 'cv-badge-purple' : status === 'Archived' ? 'cv-badge-neutral' : 'cv-badge-info');

        document.getElementById('modalPreviewHeader').innerText = 'Course: ' + subject + ' \u2022 ' + classroom;
        document.getElementById('modalPreviewStudent').innerText = student;
        document.getElementById('modalPreviewStudentId').innerText = studentId;

        // Populate dynamic timeline for versioning
        const timeline = document.getElementById('modalVersionTimeline');
        if (version === 'v1') {
            timeline.innerHTML = `
                <div style="display:flex;align-items:center;justify-content:space-between;padding:var(--space-2);background:#fff;border-radius:var(--radius-sm);border:1px solid var(--cv-border);">
                    <div style="display:flex;align-items:center;gap:var(--space-2);">
                        <span class="cv-admin-ver-pill v1">v1</span>
                        <span style="font-size:12px;font-weight:var(--fw-semibold);color:var(--cv-ink);">Initial Submission Artifact</span>
                    </div>
                    <span style="font-size:11px;color:var(--cv-slate);">${tr.getAttribute('data-date')} (${filesize})</span>
                </div>
            `;
        } else if (version === 'v2') {
            timeline.innerHTML = `
                <div style="display:flex;align-items:center;justify-content:space-between;padding:var(--space-2);background:#fff;border-radius:var(--radius-sm);border:1px solid var(--cv-border);">
                    <div style="display:flex;align-items:center;gap:var(--space-2);">
                        <span class="cv-admin-ver-pill v2">v2</span>
                        <span style="font-size:12px;font-weight:var(--fw-semibold);color:var(--cv-ink);">Current Artifact &bull; Revision Ingested</span>
                    </div>
                    <span style="font-size:11px;color:var(--cv-slate);">${tr.getAttribute('data-date')} (${filesize})</span>
                </div>
                <div style="display:flex;align-items:center;justify-content:space-between;padding:var(--space-2);background:rgba(255,255,255,0.6);border-radius:var(--radius-sm);border:1px dashed var(--cv-border);">
                    <div style="display:flex;align-items:center;gap:var(--space-2);">
                        <span class="cv-admin-ver-pill v1">v1</span>
                        <span style="font-size:12px;color:var(--cv-slate);">Initial Manuscript (Superseded &bull; Archived)</span>
                    </div>
                    <span style="font-size:11px;color:var(--cv-slate);">Prior Hash Archive</span>
                </div>
            `;
        } else {
            timeline.innerHTML = `
                <div style="display:flex;align-items:center;justify-content:space-between;padding:var(--space-2);background:#fff;border-radius:var(--radius-sm);border:1px solid var(--cv-border);">
                    <div style="display:flex;align-items:center;gap:var(--space-2);">
                        <span class="cv-admin-ver-pill v3plus">${version}</span>
                        <span style="font-size:12px;font-weight:var(--fw-semibold);color:var(--cv-ink);">Current Iteration &bull; Revision Ingested</span>
                    </div>
                    <span style="font-size:11px;color:var(--cv-slate);">${tr.getAttribute('data-date')} (${filesize})</span>
                </div>
                <div style="display:flex;align-items:center;justify-content:space-between;padding:var(--space-2);background:rgba(255,255,255,0.6);border-radius:var(--radius-sm);border:1px dashed var(--cv-border);">
                    <div style="display:flex;align-items:center;gap:var(--space-2);">
                        <span class="cv-admin-ver-pill v2">v2</span>
                        <span style="font-size:12px;color:var(--cv-slate);">Interim Revision (Superseded)</span>
                    </div>
                    <span style="font-size:11px;color:var(--cv-slate);">Archive Hash Valid</span>
                </div>
            `;
        }

        const modal = document.getElementById('adminDocAuditModal');
        modal.style.display = 'flex';
    }

    function closeDocAuditModal() {
        document.getElementById('adminDocAuditModal').style.display = 'none';
        currentModalDocData = null;
    }

    // Trigger secure file download simulation
    function triggerDocDownload(btn) {
        const tr = btn.closest('tr');
        const filename = tr ? tr.getAttribute('data-filename') : 'Document.pdf';
        const hash = tr ? tr.getAttribute('data-hash') : '';
        showAdminDocToast('Initiating Vault Download', filename + ' (SHA-256: ' + hash.substring(0, 10) + '... verified)', 'success');
    }

    function downloadModalDoc() {
        if (currentModalDocData) {
            showAdminDocToast('Initiating Vault Download', currentModalDocData.filename + ' downloaded for compliance audit.', 'success');
            closeDocAuditModal();
        }
    }

    function copyModalHash() {
        const hash = document.getElementById('modalFullHash').innerText;
        navigator.clipboard.writeText(hash).then(() => {
            const btn = document.getElementById('btnCopyHash');
            btn.innerHTML = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Copied!`;
            setTimeout(() => {
                btn.innerHTML = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copy Hash`;
            }, 2500);
        });
    }

    function runCryptographicAudit() {
        showAdminDocToast('SHA-256 Integrity Sweep Running', 'Scanning 8,924 storage blocks across 6 distributed cluster nodes...', 'info');
        setTimeout(() => {
            showAdminDocToast('Integrity Sweep Complete', '100% Cryptographic verification passed. 0 anomalies detected.', 'success');
        }, 1600);
    }

    function exportDocumentAuditReport() {
        showAdminDocToast('Exporting Document Ledger', 'Generating compliance CSV report for 8,924 university files...', 'info');
        setTimeout(() => {
            showAdminDocToast('Export Ready', 'CampusVault_Document_Ledger_2026.csv generated successfully.', 'success');
        }, 1200);
    }

    // Toast notification utility
    function showAdminDocToast(title, message, type) {
        let toastContainer = document.getElementById('cv-admin-toast-container');
        if (!toastContainer) {
            toastContainer = document.createElement('div');
            toastContainer.id = 'cv-admin-toast-container';
            toastContainer.style.position = 'fixed';
            toastContainer.style.bottom = '24px';
            toastContainer.style.right = '24px';
            toastContainer.style.zIndex = '99999';
            toastContainer.style.display = 'flex';
            toastContainer.style.flexDirection = 'column';
            toastContainer.style.gap = '10px';
            document.body.appendChild(toastContainer);
        }

        const toast = document.createElement('div');
        toast.style.background = (type === 'success' ? '#064e3b' : '#0f172a');
        toast.style.color = '#fff';
        toast.style.border = (type === 'success' ? '1px solid #059669' : '1px solid #334155');
        toast.style.borderRadius = '8px';
        toast.style.padding = '12px 18px';
        toast.style.boxShadow = '0 10px 25px rgba(0,0,0,0.3)';
        toast.style.fontSize = '12px';
        toast.style.minWidth = '300px';
        toast.style.maxWidth = '420px';
        toast.style.animation = 'cvFadeIn 0.25s ease';

        toast.innerHTML = `
            <div style="display:flex;align-items:flex-start;gap:10px;">
                <div style="color:${type === 'success' ? '#34d399' : '#38bdf8'};flex-shrink:0;margin-top:1px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div style="flex:1;">
                    <div style="font-weight:700;font-size:13px;margin-bottom:2px;">${title}</div>
                    <div style="color:rgba(255,255,255,0.8);font-size:11.5px;line-height:1.4;">${message}</div>
                </div>
            </div>
        `;

        toastContainer.appendChild(toast);
        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.3s ease';
            setTimeout(() => toast.remove(), 300);
        }, 4000);
    }

    // Close modal on Escape key or backdrop click
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeDocAuditModal();
        }
    });

    document.getElementById('adminDocAuditModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeDocAuditModal();
        }
    });
</script>
