@model CampusVault.Models.Academic.ClassroomDetailsViewModel
@{
    ViewBag.Title = Model?.Classroom != null ? $"{Model.Classroom.CourseName} — Classroom" : "Classroom Details";
    ViewBag.Role = "Student";
    var c = Model?.Classroom;
    var tasks = Model?.Tasks ?? new List<CampusVault.Models.Academic.ClassroomTask>();
    var announcements = Model?.Announcements ?? new List<CampusVault.Models.Academic.ClassroomAnnouncementItem>();
    var materials = Model?.Materials ?? new List<CampusVault.Models.Academic.ClassroomMaterialItem>();
}

<!-- Back Link Breadcrumb & Actions -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:12px;">
    <a href="@Url.Action("Classrooms", "Student")" style="display:inline-flex;align-items:center;gap:6px;color:#64748b;font-size:13px;font-weight:600;text-decoration:none;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        <span>Back to My Classrooms</span>
    </a>
    @if (c != null)
    {
        <button type="button" onclick="confirmLeaveClassroom(@c.ClassroomId)" style="background:#fee2e2;color:#dc2626;border:1px solid #fca5a5;padding:6px 14px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all 0.2s ease;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Leave Classroom
        </button>
    }
</div>

@if (c != null)
{
    @* ==================== 1. CLASSROOM HEADER HERO ==================== *@
    <div style="background:@c.ThemeGradient;border:1px solid rgba(255,255,255,0.25);border-radius:16px;padding:28px 32px;color:#ffffff;box-shadow:0 12px 32px -6px rgba(11,25,44,0.3);position:relative;overflow:hidden;margin-bottom:24px;">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:24px;flex-wrap:wrap;position:relative;z-index:2;">
            <div>
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                    <span style="background:rgba(255,255,255,0.22);color:#ffffff;border:1px solid rgba(255,255,255,0.35);padding:3px 10px;border-radius:6px;font-size:12px;font-weight:700;">
                        @c.CourseCode
                    </span>
                    <span style="font-size:12px;color:rgba(255,255,255,0.85);font-weight:600;">
                        @c.Department Core &bull; Semester @c.Semester
                    </span>
                </div>
                <h1 style="font-family:'DM Sans', -apple-system, sans-serif;font-size:26px;font-weight:800;color:#ffffff;margin:0 0 6px 0;letter-spacing:-0.02em;">
                    @c.CourseName
                </h1>
                <p style="color:rgba(255,255,255,0.85);font-size:13.5px;margin:0;max-width:620px;">
                    Official coursework workspace &bull; Academic Year @c.AcademicYear
                </p>
            </div>

            <!-- Classroom Access Key Card -->
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;">
                <span style="font-size:11px;color:rgba(255,255,255,0.75);text-transform:uppercase;letter-spacing:0.05em;">Section Key</span>
                <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.14);border:1px solid rgba(255,255,255,0.25);padding:6px 14px;border-radius:8px;backdrop-filter:blur(4px);">
                    <span style="font-family:monospace;font-size:14px;font-weight:700;color:#fde68a;letter-spacing:0.08em;">@c.JoinCode</span>
                </div>
            </div>
        </div>

        <!-- Faculty & Meta Info Bar -->
        <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:20px;padding-top:16px;border-top:1px solid rgba(255,255,255,0.18);font-size:12.5px;">
            <span style="display:inline-flex;align-items:center;gap:6px;color:rgba(255,255,255,0.9);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Mentor: <strong style="color:#ffffff;">@c.FacultyName</strong> (@c.FacultyDesignation)
            </span>
            <span style="display:inline-flex;align-items:center;gap:6px;color:rgba(255,255,255,0.9);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                @c.FacultyEmail
            </span>
            <span style="display:inline-flex;align-items:center;gap:6px;color:rgba(255,255,255,0.9);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                @c.StudentCount Enrolled Students
            </span>
        </div>
    </div>

    @* ==================== 2. TABS NAVIGATION ==================== *@
    <div style="display:flex;gap:12px;margin-bottom:18px;border-bottom:2px solid #e2e8f0;padding-bottom:2px;">
        <button id="tabBtnTasks" onclick="switchTab('tasks')" style="background:none;border:none;padding:10px 18px;font-size:14px;font-weight:700;color:#2563eb;border-bottom:3px solid #2563eb;cursor:pointer;display:inline-flex;align-items:center;gap:8px;">
            <span>Tasks &amp; Assignments</span>
            <span style="background:#eff6ff;color:#2563eb;padding:2px 8px;border-radius:12px;font-size:11px;">@tasks.Count</span>
        </button>
        <button id="tabBtnAnnouncements" onclick="switchTab('announcements')" style="background:none;border:none;padding:10px 18px;font-size:14px;font-weight:600;color:#64748b;border-bottom:3px solid transparent;cursor:pointer;display:inline-flex;align-items:center;gap:8px;">
            <span>Announcements</span>
            <span style="background:#f1f5f9;color:#64748b;padding:2px 8px;border-radius:12px;font-size:11px;">@announcements.Count</span>
        </button>
        <button id="tabBtnMaterials" onclick="switchTab('materials')" style="background:none;border:none;padding:10px 18px;font-size:14px;font-weight:600;color:#64748b;border-bottom:3px solid transparent;cursor:pointer;display:inline-flex;align-items:center;gap:8px;">
            <span>Course Materials</span>
            <span style="background:#f1f5f9;color:#64748b;padding:2px 8px;border-radius:12px;font-size:11px;">@materials.Count</span>
        </button>
    </div>

    @* ==================== TAB 1: TASKS & ASSIGNMENTS ==================== *@
    <div id="tabContentTasks" style="background:#ffffff;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;box-shadow:0 2px 8px rgba(15,23,42,0.04);margin-bottom:24px;">
        <div style="padding:16px 24px;background:#f8fafc;border-bottom:1px solid #e2e8f0;display:flex;align-items:center;justify-content:space-between;">
            <h3 style="margin:0;font-size:14px;font-weight:700;color:#0b192c;text-transform:uppercase;letter-spacing:0.04em;">
                Coursework Assignments &amp; Lab Practical Tasks
            </h3>
            <span style="font-size:12px;color:#64748b;font-weight:600;">@tasks.Count Assigned Tasks</span>
        </div>

        @if (tasks != null && tasks.Count > 0)
        {
            <div style="display:flex;flex-direction:column;">
                @foreach (var t in tasks)
                {
                    <div style="padding:20px 24px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;transition:background 0.2s ease;">
                        <div style="display:flex;align-items:flex-start;gap:14px;flex:1;min-width:280px;">
                            <div style="width:40px;height:40px;border-radius:10px;background:#eff6ff;color:#2563eb;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            </div>
                            <div>
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
                                    <span style="background:#f1f5f9;color:#475569;border:1px solid #cbd5e1;padding:2px 7px;border-radius:4px;font-size:11px;font-weight:700;">
                                        @t.TaskType
                                    </span>
                                    @{
                                        var hasSubmission = !string.IsNullOrEmpty(t.SubmissionStatus);
                                        var isApproved = hasSubmission && (t.SubmissionStatus.Equals("Approved", StringComparison.OrdinalIgnoreCase) 
                                                      || t.SubmissionStatus.Equals("Reviewed", StringComparison.OrdinalIgnoreCase)
                                                      || t.SubmissionStatus.Equals("Graded", StringComparison.OrdinalIgnoreCase));
                                        var isSubmitted = hasSubmission && (t.SubmissionStatus.Equals("Submitted", StringComparison.OrdinalIgnoreCase)
                                                       || t.SubmissionStatus.Equals("PendingReview", StringComparison.OrdinalIgnoreCase)
                                                       || t.SubmissionStatus.Equals("Under Review", StringComparison.OrdinalIgnoreCase));
                                        var isRevision = hasSubmission && t.SubmissionStatus.IndexOf("Revision", StringComparison.OrdinalIgnoreCase) >= 0;
                                        var isPending = !hasSubmission || (!isApproved && !isSubmitted && !isRevision);
                                        
                                        string dateDisplay = "";
                                        if (isApproved || isSubmitted)
                                        {
                                            dateDisplay = t.SubmittedAt.HasValue ? "Submitted " + t.SubmittedAt.Value.ToString("MMM dd, yyyy") : "Submitted recently";
                                        }
                                        else
                                        {
                                            var dueDate = t.DueDate;
                                            var daysLeft = (int)Math.Ceiling((dueDate - DateTime.Now).TotalDays);
                                            if (daysLeft < 0) { dateDisplay = "Overdue (" + dueDate.ToString("MMM dd") + ")"; }
                                            else if (daysLeft == 0) { dateDisplay = "Due today at " + dueDate.ToString("hh:mm tt"); }
                                            else if (daysLeft == 1) { dateDisplay = "Due tomorrow (" + dueDate.ToString("MMM dd") + ")"; }
                                            else { dateDisplay = "Due " + dueDate.ToString("MMM dd, yyyy"); }
                                        }
                                    }
                                    <span style="font-size:11.5px;color:@(isPending || isRevision ? "#d97706" : "#16a34a");font-weight:700;">
                                        @dateDisplay
                                    </span>
                                </div>
                                <h4 style="margin:0 0 4px 0;font-size:15px;font-weight:700;color:#0f172a;">
                                    @t.Title
                                </h4>
                                <p style="margin:0;font-size:12.5px;color:#64748b;line-height:1.4;">
                                    @(t.Description ?? "Complete the practical assignment as specified in the course syllabus.")
                                </p>
                            </div>
                        </div>

                        <div style="display:flex;align-items:center;gap:14px;">
                            @{
                                string statusBadgeHtml = "";
                                string actionButtonHtml = "";
                                
                                if (isApproved)
                                {
                                    statusBadgeHtml = "<div style=\"text-align:right;\"><div style=\"font-size:14px;font-weight:800;color:#16a34a;\">" + (t.Score.HasValue ? t.Score + " / " + t.MaxScore + " pts" : t.MaxScore + " pts") + "</div><div style=\"font-size:11px;color:#16a34a;font-weight:600;display:inline-flex;align-items:center;gap:4px;\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"20 6 9 17 4 12\"/></svg>Approved</div></div>";
                                    actionButtonHtml = "<a href=\"" + Url.Action("Documents", "Student") + "\" style=\"display:inline-flex;align-items:center;gap:6px;background:#16a34a;color:#ffffff;text-decoration:none;padding:9px 18px;border-radius:8px;font-size:12.5px;font-weight:700;box-shadow:0 2px 8px rgba(22,163,74,0.25);\"><span>View Doc</span><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"9 18 15 12 9 6\"/></svg></a>";
                                }
                                else if (isSubmitted)
                                {
                                    statusBadgeHtml = "<div style=\"text-align:right;\"><div style=\"font-size:14px;font-weight:800;color:#0b192c;\">" + t.MaxScore + " pts</div><div style=\"font-size:11px;color:#0891b2;font-weight:600;display:inline-flex;align-items:center;gap:4px;\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>Under Review</div></div>";
                                    actionButtonHtml = "<a href=\"" + Url.Action("Documents", "Student") + "\" style=\"display:inline-flex;align-items:center;gap:6px;background:#0891b2;color:#ffffff;text-decoration:none;padding:9px 18px;border-radius:8px;font-size:12.5px;font-weight:700;box-shadow:0 2px 8px rgba(8,145,178,0.25);\"><span>View Doc</span><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"9 18 15 12 9 6\"/></svg></a>";
                                }
                                else if (isRevision)
                                {
                                    statusBadgeHtml = "<div style=\"text-align:right;\"><div style=\"font-size:11px;color:#d97706;font-weight:600;display:inline-flex;align-items:center;gap:4px;\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"23 4 23 10 17 10\"/><path d=\"M20.49 15a9 9 0 1 1-2.12-9.36L23 10\"/></svg>Needs Revision</div></div>";
                                    actionButtonHtml = "<a href=\"" + Url.Action("SubmitDocument", "Student", new { id = t.TaskId }) + "\" style=\"display:inline-flex;align-items:center;gap:6px;background:#d97706;color:#ffffff;text-decoration:none;padding:9px 18px;border-radius:8px;font-size:12.5px;font-weight:700;box-shadow:0 2px 8px rgba(217,119,6,0.25);\"><span>Re-Submit</span><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"17 8 12 3 7 8\"/><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"/></svg></a>";
                                }
                                else
                                {
                                    statusBadgeHtml = "<div style=\"text-align:right;\"><div style=\"font-size:14px;font-weight:800;color:#0b192c;\">" + t.MaxScore + " pts</div><div style=\"font-size:11px;color:#dc2626;font-weight:600;display:inline-flex;align-items:center;gap:4px;\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/></svg>Pending</div></div>";
                                    actionButtonHtml = "<a href=\"" + Url.Action("SubmitDocument", "Student", new { id = t.TaskId }) + "\" style=\"display:inline-flex;align-items:center;gap:6px;background:#2563eb;color:#ffffff;text-decoration:none;padding:9px 18px;border-radius:8px;font-size:12.5px;font-weight:700;box-shadow:0 2px 8px rgba(37,99,235,0.25);\"><span>Submit Work</span><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"17 8 12 3 7 8\"/><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"/></svg></a>";
                                }
                            }
                            @Html.Raw(statusBadgeHtml)
                            @Html.Raw(actionButtonHtml)
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="padding:40px 24px;text-align:center;color:#64748b;">
                <p style="margin:0;font-size:14px;">No tasks have been assigned in this classroom yet.</p>
            </div>
        }
    </div>

    @* ==================== TAB 2: ANNOUNCEMENTS ==================== *@
    <div id="tabContentAnnouncements" style="display:none;background:#ffffff;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;box-shadow:0 2px 8px rgba(15,23,42,0.04);margin-bottom:24px;">
        <div style="padding:16px 24px;background:#f8fafc;border-bottom:1px solid #e2e8f0;display:flex;align-items:center;justify-content:space-between;">
            <h3 style="margin:0;font-size:14px;font-weight:700;color:#0b192c;text-transform:uppercase;letter-spacing:0.04em;">
                Faculty Notices &amp; Class Announcements
            </h3>
            <span style="font-size:12px;color:#64748b;font-weight:600;">@announcements.Count Notices</span>
        </div>

        @if (announcements != null && announcements.Count > 0)
        {
            <div style="display:flex;flex-direction:column;">
                @foreach (var a in announcements)
                {
                    <div style="padding:20px 24px;border-bottom:1px solid #f1f5f9;position:relative;background:@(a.IsPinned ? "#fffdf5" : "#ffffff");">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:12px;flex-wrap:wrap;">
                            <div style="display:flex;align-items:center;gap:8px;">
                                @if (a.IsPinned)
                                {
                                    <span style="background:#fef3c7;color:#92400e;border:1px solid #fde68a;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700;display:inline-flex;align-items:center;gap:4px;">
                                        📌 Pinned
                                    </span>
                                }
                                <span style="background:#f1f5f9;color:#475569;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700;">
                                    @a.Priority Priority
                                </span>
                                <h4 style="margin:0;font-size:15px;font-weight:700;color:#0f172a;">
                                    @a.Title
                                </h4>
                            </div>
                            <span style="font-size:12px;color:#94a3b8;">
                                Posted @a.PublishedAt.ToString("MMM dd, yyyy &bull; hh:mm tt")
                            </span>
                        </div>
                        <p style="margin:0 0 10px 0;font-size:13px;color:#334155;line-height:1.6;white-space:pre-line;">
                            @a.Message
                        </p>
                        <div style="font-size:11.5px;color:#64748b;display:flex;align-items:center;gap:6px;">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            <span>Posted by: <strong>@a.FacultyName</strong></span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="padding:40px 24px;text-align:center;color:#64748b;">
                <p style="margin:0;font-size:14px;">No announcements posted in this classroom yet.</p>
            </div>
        }
    </div>

    @* ==================== TAB 3: LEARNING MATERIALS ==================== *@
    <div id="tabContentMaterials" style="display:none;background:#ffffff;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;box-shadow:0 2px 8px rgba(15,23,42,0.04);margin-bottom:24px;">
        <div style="padding:16px 24px;background:#f8fafc;border-bottom:1px solid #e2e8f0;display:flex;align-items:center;justify-content:space-between;">
            <h3 style="margin:0;font-size:14px;font-weight:700;color:#0b192c;text-transform:uppercase;letter-spacing:0.04em;">
                Learning Materials &amp; Study Resources
            </h3>
            <span style="font-size:12px;color:#64748b;font-weight:600;">@materials.Count Resources</span>
        </div>

        @if (materials != null && materials.Count > 0)
        {
            <div style="display:flex;flex-direction:column;">
                @foreach (var m in materials)
                {
                    bool isLink = !string.IsNullOrEmpty(m.ExternalUrl);
                    string catBadgeBg = isLink ? "#fef3c7" : "#e0e7ff";
                    string catBadgeColor = isLink ? "#b45309" : "#4338ca";

                    <div style="padding:18px 24px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
                        <div style="display:flex;align-items:flex-start;gap:14px;flex:1;min-width:280px;">
                            <div style="width:42px;height:42px;border-radius:10px;background:@(isLink ? "#fef3c7" : "#eff6ff");color:@(isLink ? "#d97706" : "#2563eb");display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                @if (isLink)
                                {
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                }
                                else
                                {
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                                }
                            </div>
                            <div>
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;flex-wrap:wrap;">
                                    <span style="background:@catBadgeBg;color:@catBadgeColor;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;">
                                        @(m.Category ?? (isLink ? "Web Resource" : "Document"))
                                    </span>
                                    <span style="font-size:11.5px;color:#94a3b8;">
                                        Shared @m.UploadedAt.ToString("MMM dd, yyyy")
                                    </span>
                                    @if (!string.IsNullOrEmpty(m.FacultyName))
                                    {
                                        <span style="font-size:11.5px;color:#64748b;">
                                            &bull; by <strong>@m.FacultyName</strong>
                                        </span>
                                    }
                                </div>
                                <h4 style="margin:0 0 4px 0;font-size:14.5px;font-weight:700;color:#0f172a;">
                                    @m.Title
                                </h4>
                                @if (!string.IsNullOrEmpty(m.Description))
                                {
                                    <p style="margin:0 0 6px 0;font-size:12.5px;color:#64748b;line-height:1.5;">
                                        @m.Description
                                    </p>
                                }
                                <div style="font-size:11.5px;color:#94a3b8;display:flex;align-items:center;gap:6px;">
                                    @if (isLink)
                                    {
                                        <span>🔗 External Resource Link</span>
                                    }
                                    else
                                    {
                                        <span>📄 @m.FileName @(!string.IsNullOrEmpty(m.FileSize) ? $"({m.FileSize})" : "")</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div>
                            @if (isLink)
                            {
                                <a href="@Url.Action("DownloadMaterial", "Student", new { id = m.MaterialId })" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:6px;background:#d97706;color:#ffffff;text-decoration:none;padding:8px 16px;border-radius:8px;font-size:12px;font-weight:700;box-shadow:0 2px 6px rgba(217,119,6,0.25);">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                    <span>Open Resource</span>
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(m.FileUrl))
                            {
                                <a href="@Url.Action("DownloadMaterial", "Student", new { id = m.MaterialId })" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:6px;background:#2563eb;color:#ffffff;text-decoration:none;padding:8px 16px;border-radius:8px;font-size:12px;font-weight:700;box-shadow:0 2px 6px rgba(37,99,235,0.2);">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                    <span>Download File</span>
                                </a>
                            }
                            else
                            {
                                <span style="font-size:12px;color:#94a3b8;">No link available</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="padding:48px 24px;text-align:center;color:#64748b;">
                <div style="width:48px;height:48px;border-radius:50%;background:#f1f5f9;color:#94a3b8;display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
                <h4 style="margin:0 0 4px 0;font-size:15px;font-weight:700;color:#0f172a;">No learning materials have been shared in this classroom yet.</h4>
                <p style="margin:0;font-size:13px;color:#94a3b8;">Your instructor will post lecture notes, presentations, lab manuals, and reference materials here.</p>
            </div>
        }
    </div>
}
else
{
    <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:14px;padding:36px;text-align:center;">
        <h3 style="color:#0b192c;margin:0 0 8px 0;">Classroom Not Found</h3>
        <p style="color:#64748b;margin:0 0 16px 0;">The requested academic section could not be located.</p>
        <a href="@Url.Action("Classrooms", "Student")" style="color:#2563eb;font-weight:700;text-decoration:none;">&larr; Return to Classrooms</a>
    </div>
}

<script>
function switchTab(tab) {
    var tabs = ['tasks', 'announcements', 'materials'];
    tabs.forEach(function(t) {
        var btn = document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
        var content = document.getElementById('tabContent' + t.charAt(0).toUpperCase() + t.slice(1));
        if (t === tab) {
            content.style.display = 'block';
            btn.style.color = '#2563eb';
            btn.style.borderBottom = '3px solid #2563eb';
            btn.style.fontWeight = '700';
        } else {
            content.style.display = 'none';
            btn.style.color = '#64748b';
            btn.style.borderBottom = '3px solid transparent';
            btn.style.fontWeight = '600';
        }
    });
}

function confirmLeaveClassroom(classroomId) {
    if (!confirm('Are you sure you want to leave this classroom? You will lose access to assignments and submitted grades until you rejoin.')) {
        return;
    }

    var fd = new FormData();
    fd.append('classroomId', classroomId);

    fetch('@Url.Action("LeaveClassroom", "Student")', {
        method: 'POST',
        body: new URLSearchParams(fd)
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
        if (res.success) {
            alert('You have successfully left the classroom.');
            window.location.href = '@Url.Action("Classrooms", "Student")';
        } else {
            alert(res.message || 'Failed to leave classroom.');
        }
    })
    .catch(function(err) {
        alert('An error occurred. Please try again.');
    });
}
</script>
