@model CampusVault.Models.Auth.User
@{
    ViewBag.Title = "My Profile";
    ViewBag.Role = "Student";
    if (Model != null)
    {
        ViewBag.UserName = Model.FullName;
        var firstInit = !string.IsNullOrEmpty(Model.FirstName) ? Model.FirstName.Substring(0, 1).ToUpper() : "S";
        var lastInit = !string.IsNullOrEmpty(Model.LastName) ? Model.LastName.Substring(0, 1).ToUpper() : "T";
        ViewBag.UserInitials = firstInit + lastInit;
        ViewBag.UserRoleDisplay = $"{Model.StudentDepartment ?? "Student"} - Sem {Model.Semester ?? 1}";
    }
    var userInitials = ViewBag.UserInitials as string ?? "ST";
}

<div style="display:flex;flex-direction:column;gap:22px;width:100%;">

    @* ==================== 1. HERO BANNER ==================== *@
    <div style="background:linear-gradient(135deg, #091a32 0%, #102a4e 55%, #183b6b 100%);border:1px solid rgba(217, 164, 65, 0.4);border-radius:16px;padding:28px 32px;color:#ffffff;box-shadow:0 12px 32px -6px rgba(11, 25, 44, 0.4);position:relative;overflow:hidden;">
        
        <div style="position:absolute;top:-60px;right:-60px;width:260px;height:260px;background:radial-gradient(circle, rgba(217, 164, 65, 0.18) 0%, transparent 70%);pointer-events:none;"></div>

        <div style="display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;position:relative;z-index:2;">
            
            @* User Monogram + Details *@
            <div style="display:flex;align-items:center;gap:22px;flex-wrap:wrap;">
                <div style="position:relative;">
                    <div id="profileHeroAvatar" style="width:82px;height:82px;border-radius:18px;background:linear-gradient(135deg, #f59e0b 0%, #d97706 100%);color:#0b192c;font-size:28px;font-weight:800;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(0, 0, 0, 0.3);border:3px solid rgba(255, 255, 255, 0.3);flex-shrink:0;letter-spacing:0.5px;overflow:hidden;">
                        @if (!string.IsNullOrEmpty(Model?.ProfilePictureUrl))
                        {
                            <img id="avatarImg" src="@Model.ProfilePictureUrl" alt="Avatar" style="width:100%;height:100%;object-fit:cover;" />
                        }
                        else
                        {
                            <span id="avatarInitials">@userInitials</span>
                        }
                    </div>
                    <label for="avatarFileInput" title="Upload Profile Photo" style="position:absolute;bottom:-4px;right:-4px;background:#2563eb;color:#ffffff;border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 2px 6px rgba(0,0,0,0.3);border:2px solid #ffffff;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    </label>
                    <input type="file" id="avatarFileInput" accept="image/*" onchange="uploadAvatar(this)" style="display:none;" />
                </div>
                <div>
                    <h1 style="font-family:'DM Sans', -apple-system, sans-serif;font-size:26px;font-weight:700;color:#ffffff;margin:0 0 8px 0;letter-spacing:-0.02em;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                        <span id="profileHeroName">@(Model != null ? Model.FullName : "Student")</span>
                        <span style="background:rgba(37, 99, 235, 0.3);color:#bfdbfe;border:1px solid rgba(147, 197, 253, 0.4);border-radius:20px;font-size:11px;font-weight:600;padding:3px 11px;display:inline-flex;align-items:center;gap:6px;">
                            <span style="width:6px;height:6px;background:#34d399;border-radius:50%;display:inline-block;box-shadow:0 0 6px #34d399;"></span>
                            Enrolled Student
                        </span>
                    </h1>
                    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                        <span style="display:inline-flex;align-items:center;gap:7px;background:rgba(255, 255, 255, 0.09);border:1px solid rgba(255, 255, 255, 0.18);border-radius:8px;padding:5px 12px;font-size:12px;color:rgba(255, 255, 255, 0.9);">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                            @(Model != null ? Model.Email : "student@campusvault.edu")
                        </span>
                        <span style="display:inline-flex;align-items:center;gap:7px;background:rgba(255, 255, 255, 0.09);border:1px solid rgba(255, 255, 255, 0.18);border-radius:8px;padding:5px 12px;font-size:12px;color:rgba(255, 255, 255, 0.9);">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/></svg>
                            ID: <strong style="color:#ffffff;">@(Model != null && !string.IsNullOrEmpty(Model.EnrollmentNumber) ? Model.EnrollmentNumber : "N/A")</strong>
                        </span>
                        <span style="display:inline-flex;align-items:center;gap:7px;background:rgba(255, 255, 255, 0.09);border:1px solid rgba(255, 255, 255, 0.18);border-radius:8px;padding:5px 12px;font-size:12px;color:rgba(255, 255, 255, 0.9);">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                            @(Model != null && !string.IsNullOrEmpty(Model.StudentDepartment) ? Model.StudentDepartment : "Engineering") &bull; @(Model != null && Model.Semester.HasValue ? "Semester " + Model.Semester.Value : "Semester 1")
                        </span>
                    </div>
                </div>
            </div>

            @* Action Buttons: Edit Profile and Change Password *@
            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <button type="button" id="btnOpenEditProfile" onclick="openEditProfileModal()" style="display:inline-flex;align-items:center;gap:8px;background:rgba(255, 255, 255, 0.16);color:#ffffff;border:1px solid rgba(255, 255, 255, 0.32);border-radius:10px;padding:10px 18px;font-size:13px;font-weight:600;cursor:pointer;transition:all 0.2s ease;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    <span>Edit Profile</span>
                </button>
                <button type="button" id="btnOpenChangePassword" onclick="openChangePasswordModal()" style="display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg, #d97706 0%, #b45309 100%);color:#ffffff;border:1px solid rgba(217, 119, 6, 0.5);border-radius:10px;padding:10px 20px;font-size:13px;font-weight:700;cursor:pointer;transition:all 0.2s ease;box-shadow:0 4px 14px rgba(217, 119, 6, 0.4);">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <span>Change Password</span>
                </button>
            </div>
        </div>
    </div>

    @* ==================== 2. TWO-COLUMN DATA GRID ==================== *@
    <div style="display:grid;grid-template-columns:360px 1fr;gap:22px;align-items:start;">
        
        @* Left Column: Academic Coordinates & Identity Card *@
        <div style="display:flex;flex-direction:column;gap:20px;">
            
            @* Academic Coordinates Card *@
            <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:14px;padding:22px;box-shadow:0 2px 8px rgba(15, 23, 42, 0.04);">
                <div style="display:flex;align-items:center;gap:9px;font-size:12px;font-weight:700;color:#0b192c;text-transform:uppercase;letter-spacing:0.05em;margin:0 0 16px 0;padding-bottom:12px;border-bottom:1px solid #f1f5f9;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    Academic Coordinates
                </div>
                
                <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid #f1f5f9;font-size:13px;">
                    <span style="color:#64748b;font-weight:500;">Student ID</span>
                    <span style="color:#0f172a;font-weight:700;">@(Model != null && !string.IsNullOrEmpty(Model.EnrollmentNumber) ? Model.EnrollmentNumber : "N/A")</span>
                </div>
                <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid #f1f5f9;font-size:13px;">
                    <span style="color:#64748b;font-weight:500;">Roll Number</span>
                    <span style="color:#0f172a;font-weight:700;">@(Model != null && !string.IsNullOrEmpty(Model.RollNumber) ? Model.RollNumber : "N/A")</span>
                </div>
                <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid #f1f5f9;font-size:13px;">
                    <span style="color:#64748b;font-weight:500;">Department</span>
                    <span style="color:#0f172a;font-weight:700;">@(Model != null && !string.IsNullOrEmpty(Model.StudentDepartment) ? Model.StudentDepartment : "Engineering")</span>
                </div>
                <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid #f1f5f9;font-size:13px;">
                    <span style="color:#64748b;font-weight:500;">Semester</span>
                    <span style="color:#0f172a;font-weight:700;">@(Model != null && Model.Semester.HasValue ? "Semester " + Model.Semester.Value : "Semester 1") (Active)</span>
                </div>
                <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid #f1f5f9;font-size:13px;">
                    <span style="color:#64748b;font-weight:500;">Division</span>
                    <span id="profileDisplayDivision" style="color:#0f172a;font-weight:700;">@(Model != null && !string.IsNullOrEmpty(Model.Division) ? Model.Division : "Not Assigned")</span>
                </div>
                <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 0;font-size:13px;">
                    <span style="color:#64748b;font-weight:500;">Contact Phone</span>
                    <span id="profileDisplayPhone" style="color:#0f172a;font-weight:700;">@(Model != null && !string.IsNullOrEmpty(Model.PhoneNumber) ? Model.PhoneNumber : "Not provided")</span>
                </div>
            </div>


        </div>

        @* Right Column: 4 Stat Chips & Tables *@
        <div style="display:flex;flex-direction:column;gap:20px;">
            
            @* 4 Stat Chips *@
            @{
                var profileClassrooms = ViewBag.ProfileClassrooms as List<CampusVault.Models.Academic.Classroom> 
                                        ?? new List<CampusVault.Models.Academic.Classroom>();
                var profileDocs       = ViewBag.ProfileDocs as List<CampusVault.Models.Student.StudentDocumentItem> 
                                        ?? new List<CampusVault.Models.Student.StudentDocumentItem>();

                Func<string,bool> pIsApproved = (s) => !string.IsNullOrEmpty(s) && (
                    s.Equals("Approved", StringComparison.OrdinalIgnoreCase) ||
                    s.Equals("Reviewed", StringComparison.OrdinalIgnoreCase) ||
                    s.Equals("Graded",   StringComparison.OrdinalIgnoreCase));

                int pClassCount   = profileClassrooms.Count;
                int pDocCount     = profileDocs.Count;
                int pSubCount     = profileDocs.Count;
                int pApproved     = profileDocs.Count(d => pIsApproved(d.Status));
                double pApprPct   = pSubCount > 0 ? Math.Round((double)pApproved / pSubCount * 100, 1) : 0;
            }
            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(160px, 1fr));gap:14px;">
                <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:16px 18px;display:flex;align-items:center;gap:14px;box-shadow:0 2px 6px rgba(15,23,42,0.03);">
                    <div style="width:42px;height:42px;border-radius:10px;background:#eff6ff;color:#2563eb;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    </div>
                    <div>
                        <div style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;">Classrooms</div>
                        <div style="font-size:20px;font-weight:800;color:#0b192c;margin-top:2px;">@pClassCount Enrolled</div>
                    </div>
                </div>
                <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:16px 18px;display:flex;align-items:center;gap:14px;box-shadow:0 2px 6px rgba(15,23,42,0.03);">
                    <div style="width:42px;height:42px;border-radius:10px;background:#faf5ff;color:#7c3aed;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    </div>
                    <div>
                        <div style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;">Documents</div>
                        <div style="font-size:20px;font-weight:800;color:#0b192c;margin-top:2px;">@pDocCount In Vault</div>
                    </div>
                </div>
                <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:16px 18px;display:flex;align-items:center;gap:14px;box-shadow:0 2px 6px rgba(15,23,42,0.03);">
                    <div style="width:42px;height:42px;border-radius:10px;background:#fef3c7;color:#d97706;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    </div>
                    <div>
                        <div style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;">Submissions</div>
                        <div style="font-size:20px;font-weight:800;color:#0b192c;margin-top:2px;">@pSubCount Cycles</div>
                    </div>
                </div>
                <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:16px 18px;display:flex;align-items:center;gap:14px;box-shadow:0 2px 6px rgba(15,23,42,0.03);">
                    <div style="width:42px;height:42px;border-radius:10px;background:#f0fdf4;color:#16a34a;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </div>
                    <div>
                        <div style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;">Approved</div>
                        <div style="font-size:20px;font-weight:800;color:#0b192c;margin-top:2px;">@pApproved (@pApprPct%)</div>
                    </div>
                </div>
            </div>

            @* Enrolled Classrooms Table — DYNAMIC *@
            <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;box-shadow:0 2px 8px rgba(15,23,42,0.04);">
                <div style="padding:14px 20px;background:#f8fafc;border-bottom:1px solid #e2e8f0;display:flex;align-items:center;justify-content:space-between;">
                    <span style="font-size:13px;font-weight:700;color:#0b192c;text-transform:uppercase;letter-spacing:0.04em;">Enrolled Classrooms</span>
                    <span style="font-size:12px;color:#64748b;font-weight:600;">@(Model != null && !string.IsNullOrEmpty(Model.Division) ? "Div " + Model.Division : "") &bull; @pClassCount Courses</span>
                </div>
                @if (profileClassrooms.Count > 0)
                {
                    <table style="width:100%;border-collapse:collapse;font-size:13px;">
                        <thead>
                            <tr style="background:#ffffff;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11.5px;text-transform:uppercase;">
                                <th style="padding:11px 20px;text-align:left;">Course</th>
                                <th style="padding:11px 20px;text-align:left;">Faculty</th>
                                <th style="padding:11px 20px;text-align:left;">Semester</th>
                                <th style="padding:11px 20px;text-align:left;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cls in profileClassrooms)
                            {
                                <tr style="border-bottom:1px solid #f1f5f9;">
                                    <td style="padding:13px 20px;">
                                        <a href="@Url.Action("ClassroomDetails","Student", new { id = cls.ClassroomId })" style="text-decoration:none;">
                                            <strong style="color:#0f172a;">@cls.CourseName</strong>
                                        </a>
                                        <div style="font-size:11px;color:#64748b;">@cls.CourseCode</div>
                                    </td>
                                    <td style="padding:13px 20px;color:#334155;">@(string.IsNullOrEmpty(cls.FacultyName) ? "—" : cls.FacultyName)</td>
                                    <td style="padding:13px 20px;color:#334155;">Sem @cls.Semester</td>
                                    <td style="padding:13px 20px;">
                                        <span style="background:#dcfce7;color:#15803d;padding:3px 9px;border-radius:6px;font-size:11px;font-weight:700;">Enrolled</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="padding:24px;text-align:center;color:#64748b;font-size:13px;">
                        No classrooms enrolled yet. <a href="@Url.Action("JoinClassroom","Student")" style="color:#2563eb;font-weight:600;">Join a classroom</a>
                    </div>
                }
            </div>

            @* Recent Submissions Table — DYNAMIC *@
            <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;box-shadow:0 2px 8px rgba(15,23,42,0.04);">
                <div style="padding:14px 20px;background:#f8fafc;border-bottom:1px solid #e2e8f0;display:flex;align-items:center;justify-content:space-between;">
                    <span style="font-size:13px;font-weight:700;color:#0b192c;text-transform:uppercase;letter-spacing:0.04em;">Recent Coursework Submissions</span>
                    <a href="@Url.Action("Documents","Student")" style="font-size:12px;color:#2563eb;text-decoration:none;font-weight:700;">View Vault →</a>
                </div>
                @if (profileDocs.Count > 0)
                {
                    <table style="width:100%;border-collapse:collapse;font-size:13px;">
                        <thead>
                            <tr style="background:#ffffff;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11.5px;text-transform:uppercase;">
                                <th style="padding:11px 20px;text-align:left;">Document</th>
                                <th style="padding:11px 20px;text-align:left;">Assignment</th>
                                <th style="padding:11px 20px;text-align:left;">Submitted</th>
                                <th style="padding:11px 20px;text-align:left;">Score</th>
                                <th style="padding:11px 20px;text-align:left;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in profileDocs.Take(5))
                            {
                                bool dApp = pIsApproved(doc.Status);
                                bool dRev = !string.IsNullOrEmpty(doc.Status) && doc.Status.IndexOf("Revision", StringComparison.OrdinalIgnoreCase) >= 0;
                                bool dPend = !dApp && !dRev;

                                string sLabel = dApp  ? "Approved"
                                              : dRev  ? "Revision"
                                              : dPend && (doc.Status ?? "").Equals("PendingReview", StringComparison.OrdinalIgnoreCase) ? "Under Review"
                                              : "Under Review";

                                string sBg    = dApp  ? "#dcfce7" : dRev ? "#faf5ff" : "#fef3c7";
                                string sColor = dApp  ? "#15803d" : dRev ? "#6b21a8" : "#b45309";

                                <tr style="border-bottom:1px solid #f1f5f9;">
                                    <td style="padding:13px 20px;">
                                        <strong style="color:#0f172a;font-size:12px;">@(doc.FileName ?? "—")</strong>
                                        <div style="font-size:11px;color:#64748b;">@(doc.FileSize ?? "") &bull; @doc.CourseCode</div>
                                    </td>
                                    <td style="padding:13px 20px;color:#334155;">@doc.TaskTitle</td>
                                    <td style="padding:13px 20px;color:#334155;font-size:12px;">@doc.SubmittedAt.ToString("dd MMM yyyy")</td>
                                    <td style="padding:13px 20px;font-weight:700;color:@(dApp ? "#16a34a" : "#94a3b8");">
                                        @(doc.Score.HasValue ? doc.Score + " / " + doc.MaxScore : "—")
                                    </td>
                                    <td style="padding:13px 20px;">
                                        <span style="background:@sBg;color:@sColor;padding:3px 9px;border-radius:6px;font-size:11px;font-weight:700;">@sLabel</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="padding:24px;text-align:center;color:#64748b;font-size:13px;">
                        No submissions yet. <a href="@Url.Action("Tasks","Student")" style="color:#2563eb;font-weight:600;">View active tasks</a>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@* Hidden AntiForgeryToken for AJAX Modals *@
<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@* ==================== 3. EDIT PROFILE MODAL ==================== *@
<div id="editProfileModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(15,23,42,0.72);z-index:999999;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px);">

    <div style="background:#ffffff;border-radius:16px;max-width:520px;width:100%;box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);border:1px solid #cbd5e1;overflow:hidden;position:relative;">
        
        @* Modal Header *@
        <div style="padding:18px 24px;background:linear-gradient(135deg, #0b192c 0%, #1e293b 100%);color:#ffffff;display:flex;align-items:center;justify-content:space-between;">
            <div style="display:flex;align-items:center;gap:10px;">
                <div style="width:32px;height:32px;border-radius:8px;background:rgba(217,119,6,0.25);display:flex;align-items:center;justify-content:center;color:#f59e0b;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </div>
                <h3 style="margin:0;font-size:16px;font-weight:700;color:#ffffff;">Edit Profile Details</h3>
            </div>
            <button type="button" onclick="closeEditProfileModal()" style="background:none;border:none;color:rgba(255,255,255,0.7);cursor:pointer;padding:6px;border-radius:6px;display:flex;align-items:center;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>

        @* Modal Form *@
        <form id="editProfileForm" onsubmit="handleSaveProfile(event)" style="padding:22px;">
            <div id="editProfileAlert" style="display:none;padding:10px 14px;border-radius:8px;margin-bottom:14px;font-size:12.5px;"></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                <div>
                    <label style="display:block;font-size:11.5px;font-weight:700;color:#334155;margin-bottom:6px;text-transform:uppercase;">First Name</label>
                    <input type="text" id="editFirstName" value="@(Model?.FirstName)" required style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;color:#0f172a;box-sizing:border-box;" />
                </div>
                <div>
                    <label style="display:block;font-size:11.5px;font-weight:700;color:#334155;margin-bottom:6px;text-transform:uppercase;">Last Name</label>
                    <input type="text" id="editLastName" value="@(Model?.LastName)" required style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;color:#0f172a;box-sizing:border-box;" />
                </div>
            </div>

            <div style="margin-bottom:14px;">
                <label style="display:block;font-size:11.5px;font-weight:700;color:#334155;margin-bottom:6px;text-transform:uppercase;">Institutional Email (Read-Only)</label>
                <input type="email" value="@(Model?.Email)" disabled style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;background:#f1f5f9;color:#64748b;cursor:not-allowed;box-sizing:border-box;" />
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                <div>
                    <label style="display:block;font-size:11.5px;font-weight:700;color:#334155;margin-bottom:6px;text-transform:uppercase;">Contact Phone</label>
                    <input type="tel" id="editPhoneNumber" value="@(Model?.PhoneNumber)" placeholder="+91 98765 43210" style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;color:#0f172a;box-sizing:border-box;" />
                </div>
                <div>
                    <label style="display:block;font-size:11.5px;font-weight:700;color:#334155;margin-bottom:6px;text-transform:uppercase;">Division</label>
                    <input type="text" id="editDivision" value="@(Model?.Division)" placeholder="e.g. Div D" style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;color:#0f172a;box-sizing:border-box;" />
                </div>
            </div>

            <div style="margin-bottom:18px;">
                <label style="display:block;font-size:11.5px;font-weight:700;color:#334155;margin-bottom:6px;text-transform:uppercase;">Enrollment Number (Read-Only)</label>
                <input type="text" value="@(Model?.EnrollmentNumber)" disabled style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;background:#f1f5f9;color:#64748b;cursor:not-allowed;box-sizing:border-box;" />
            </div>

            <div style="display:flex;justify-content:flex-end;gap:10px;border-top:1px solid #e2e8f0;padding-top:16px;">
                <button type="button" onclick="closeEditProfileModal()" style="background:#f1f5f9;color:#334155;border:1px solid #cbd5e1;border-radius:8px;padding:9px 18px;font-size:13px;font-weight:600;cursor:pointer;">Cancel</button>
                <button type="submit" id="btnSaveProfile" style="background:#2563eb;color:#ffffff;border:none;border-radius:8px;padding:9px 20px;font-size:13px;font-weight:700;cursor:pointer;">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@* ==================== 4. CHANGE PASSWORD MODAL ==================== *@
<div id="changePasswordModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(15,23,42,0.72);z-index:999999;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px);">
    <div style="background:#ffffff;border-radius:16px;max-width:480px;width:100%;box-shadow:0 25px 50px -12px rgba(0,0,0,0.5);border:1px solid #cbd5e1;overflow:hidden;position:relative;">
        
        @* Modal Header *@
        <div style="padding:18px 24px;background:linear-gradient(135deg, #0b192c 0%, #1e293b 100%);color:#ffffff;display:flex;align-items:center;justify-content:space-between;">
            <div style="display:flex;align-items:center;gap:10px;">
                <div style="width:32px;height:32px;border-radius:8px;background:rgba(217,119,6,0.25);display:flex;align-items:center;justify-content:center;color:#f59e0b;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <h3 style="margin:0;font-size:16px;font-weight:700;color:#ffffff;">Change Account Password</h3>
            </div>
            <button type="button" onclick="closeChangePasswordModal()" style="background:none;border:none;color:rgba(255,255,255,0.7);cursor:pointer;padding:6px;border-radius:6px;display:flex;align-items:center;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>

        @* Modal Form *@
        <form id="changePasswordForm" onsubmit="handleChangePassword(event)" style="padding:22px;">
            <div id="changePwdAlert" style="display:none;padding:10px 14px;border-radius:8px;margin-bottom:14px;font-size:12.5px;"></div>

            <div style="margin-bottom:14px;">
                <label style="display:block;font-size:11.5px;font-weight:700;color:#334155;margin-bottom:6px;text-transform:uppercase;">Current Password</label>
                <input type="password" id="pwdCurrent" placeholder="Enter current passphrase" required style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;color:#0f172a;box-sizing:border-box;" />
            </div>
            <div style="margin-bottom:14px;">
                <label style="display:block;font-size:11.5px;font-weight:700;color:#334155;margin-bottom:6px;text-transform:uppercase;">New Password (Min 6 Characters)</label>
                <input type="password" id="pwdNew" placeholder="Enter secure new passphrase" required style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;color:#0f172a;box-sizing:border-box;" />
            </div>
            <div style="margin-bottom:18px;">
                <label style="display:block;font-size:11.5px;font-weight:700;color:#334155;margin-bottom:6px;text-transform:uppercase;">Confirm New Password</label>
                <input type="password" id="pwdConfirm" placeholder="Re-enter new passphrase" required style="width:100%;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;color:#0f172a;box-sizing:border-box;" />
            </div>

            <div style="display:flex;justify-content:flex-end;gap:10px;border-top:1px solid #e2e8f0;padding-top:16px;">
                <button type="button" onclick="closeChangePasswordModal()" style="background:#f1f5f9;color:#334155;border:1px solid #cbd5e1;border-radius:8px;padding:9px 18px;font-size:13px;font-weight:600;cursor:pointer;">Cancel</button>
                <button type="submit" id="btnSavePassword" style="background:linear-gradient(135deg, #d97706 0%, #b45309 100%);color:#ffffff;border:none;border-radius:8px;padding:9px 20px;font-size:13px;font-weight:700;cursor:pointer;box-shadow:0 4px 12px rgba(217,119,6,0.35);">
                    Update Password
                </button>
            </div>
        </form>
    </div>
</div>

@* ==================== 5. JAVASCRIPT CONTROLS ==================== *@
<script>
    // Explicitly expose modal openers globally on window
    window.openEditProfileModal = function () {
        var modal = document.getElementById('editProfileModal');
        var alertBox = document.getElementById('editProfileAlert');
        if (alertBox) alertBox.style.display = 'none';
        if (modal) {
            modal.style.display = 'flex';
            modal.style.zIndex = '999999';
        }
    };

    window.closeEditProfileModal = function () {
        var modal = document.getElementById('editProfileModal');
        if (modal) modal.style.display = 'none';
    };

    window.openChangePasswordModal = function () {
        var modal = document.getElementById('changePasswordModal');
        var alertBox = document.getElementById('changePwdAlert');
        if (alertBox) alertBox.style.display = 'none';
        var p1 = document.getElementById('pwdCurrent');
        var p2 = document.getElementById('pwdNew');
        var p3 = document.getElementById('pwdConfirm');
        if (p1) p1.value = '';
        if (p2) p2.value = '';
        if (p3) p3.value = '';
        if (modal) {
            modal.style.display = 'flex';
            modal.style.zIndex = '999999';
        }
    };

    window.closeChangePasswordModal = function () {
        var p1 = document.getElementById('pwdCurrent');
        var p2 = document.getElementById('pwdNew');
        var p3 = document.getElementById('pwdConfirm');
        if (p1) p1.value = '';
        if (p2) p2.value = '';
        if (p3) p3.value = '';
        var modal = document.getElementById('changePasswordModal');
        if (modal) modal.style.display = 'none';
    };

    // Close on backdrop click
    window.addEventListener('click', function (e) {
        var editModal = document.getElementById('editProfileModal');
        if (e.target === editModal) {
            closeEditProfileModal();
        }
        var pwdModal = document.getElementById('changePasswordModal');
        if (e.target === pwdModal) {
            closeChangePasswordModal();
        }
    });

    // Close on ESC key
    window.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeEditProfileModal();
            closeChangePasswordModal();
        }
    });

    // Save Profile AJAX
    window.handleSaveProfile = async function (e) {
        e.preventDefault();
        var firstName = document.getElementById('editFirstName').value.trim();
        var lastName = document.getElementById('editLastName').value.trim();
        var phoneNumber = document.getElementById('editPhoneNumber').value.trim();
        var division = document.getElementById('editDivision').value.trim();
        var alertBox = document.getElementById('editProfileAlert');
        var btn = document.getElementById('btnSaveProfile');

        if (!firstName || !lastName) {
            alertBox.style.display = 'block';
            alertBox.style.background = '#fef2f2';
            alertBox.style.color = '#dc2626';
            alertBox.style.border = '1px solid #fecaca';
            alertBox.textContent = 'First name and last name are required.';
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Saving...';
        alertBox.style.display = 'none';

        try {
            var tokenInput = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
            var token = tokenInput ? tokenInput.value : '';

            var formData = new URLSearchParams();
            formData.append('__RequestVerificationToken', token);
            formData.append('firstName', firstName);
            formData.append('lastName', lastName);
            formData.append('phoneNumber', phoneNumber);
            formData.append('division', division);

            var response = await fetch('@Url.Action("UpdateProfile", "Student")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData.toString()
            });

            var result = await response.json();
            if (result.success) {
                var fullName = firstName + ' ' + lastName;
                var initials = (firstName[0] || 'S') + (lastName[0] || 'T');

                var heroName = document.getElementById('profileHeroName');
                if (heroName) heroName.textContent = fullName;
                var heroAvatar = document.getElementById('profileHeroAvatar');
                if (heroAvatar) heroAvatar.textContent = initials.toUpperCase();
                var divElem = document.getElementById('profileDisplayDivision');
                if (divElem) divElem.textContent = division || 'Not Assigned';
                var phoneElem = document.getElementById('profileDisplayPhone');
                if (phoneElem) phoneElem.textContent = phoneNumber || 'Not provided';

                var topUserName = document.querySelector('.user-name');
                if (topUserName) topUserName.textContent = fullName;
                var topUserInitials = document.querySelector('.user-avatar');
                if (topUserInitials) topUserInitials.textContent = initials.toUpperCase();

                closeEditProfileModal();
                showProfileToast('Profile Updated', result.message || 'Profile saved successfully.', 'success');
            } else {
                alertBox.style.display = 'block';
                alertBox.style.background = '#fef2f2';
                alertBox.style.color = '#dc2626';
                alertBox.style.border = '1px solid #fecaca';
                alertBox.textContent = result.message || 'Failed to update profile.';
            }
        } catch (err) {
            alertBox.style.display = 'block';
            alertBox.style.background = '#fef2f2';
            alertBox.style.color = '#dc2626';
            alertBox.style.border = '1px solid #fecaca';
            alertBox.textContent = 'Connection error. Please try again.';
        } finally {
            btn.disabled = false;
            btn.textContent = 'Save Changes';
        }
    };

    // Change Password AJAX
    window.handleChangePassword = async function (e) {
        e.preventDefault();
        var currentPassword = document.getElementById('pwdCurrent').value;
        var newPassword = document.getElementById('pwdNew').value;
        var confirmPassword = document.getElementById('pwdConfirm').value;
        var alertBox = document.getElementById('changePwdAlert');
        var btn = document.getElementById('btnSavePassword');

        if (!currentPassword || !newPassword) {
            alertBox.style.display = 'block';
            alertBox.style.background = '#fef2f2';
            alertBox.style.color = '#dc2626';
            alertBox.style.border = '1px solid #fecaca';
            alertBox.textContent = 'Please fill out all password fields.';
            return;
        }

        if (newPassword.length < 6) {
            alertBox.style.display = 'block';
            alertBox.style.background = '#fef2f2';
            alertBox.style.color = '#dc2626';
            alertBox.style.border = '1px solid #fecaca';
            alertBox.textContent = 'New password must be at least 6 characters.';
            return;
        }

        if (newPassword !== confirmPassword) {
            alertBox.style.display = 'block';
            alertBox.style.background = '#fef2f2';
            alertBox.style.color = '#dc2626';
            alertBox.style.border = '1px solid #fecaca';
            alertBox.textContent = 'New password and confirmation do not match.';
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Updating...';
        alertBox.style.display = 'none';

        try {
            var tokenInput = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
            var token = tokenInput ? tokenInput.value : '';

            var formData = new URLSearchParams();
            formData.append('__RequestVerificationToken', token);
            formData.append('currentPassword', currentPassword);
            formData.append('newPassword', newPassword);
            formData.append('confirmPassword', confirmPassword);

            var response = await fetch('@Url.Action("ChangePassword", "Student")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData.toString()
            });

            var result = await response.json();
            if (result.success) {
                closeChangePasswordModal();
                showProfileToast('Password Changed', result.message || 'Password updated successfully.', 'success');
            } else {
                alertBox.style.display = 'block';
                alertBox.style.background = '#fef2f2';
                alertBox.style.color = '#dc2626';
                alertBox.style.border = '1px solid #fecaca';
                alertBox.textContent = result.message || 'Password update failed.';
            }
        } catch (err) {
            alertBox.style.display = 'block';
            alertBox.style.background = '#fef2f2';
            alertBox.style.color = '#dc2626';
            alertBox.style.border = '1px solid #fecaca';
            alertBox.textContent = 'Connection error. Please try again.';
        } finally {
            btn.disabled = false;
            btn.textContent = 'Update Password';
        }
    };

    function showProfileToast(title, message, type) {
        var toastContainer = document.getElementById('cv-profile-toast-container');
        if (!toastContainer) {
            toastContainer = document.createElement('div');
            toastContainer.id = 'cv-profile-toast-container';
            toastContainer.style.position = 'fixed';
            toastContainer.style.bottom = '24px';
            toastContainer.style.right = '24px';
            toastContainer.style.zIndex = '999999';
            toastContainer.style.display = 'flex';
            toastContainer.style.flexDirection = 'column';
            toastContainer.style.gap = '10px';
            document.body.appendChild(toastContainer);
        }

        var toast = document.createElement('div');
        toast.style.background = (type === 'success' ? '#064e3b' : '#7f1d1d');
        toast.style.color = '#fff';
        toast.style.border = (type === 'success' ? '1px solid #059669' : '1px solid #dc2626');
        toast.style.borderRadius = '10px';
        toast.style.padding = '14px 20px';
        toast.style.boxShadow = '0 12px 28px rgba(0,0,0,0.25)';
        toast.style.fontSize = '13px';
        toast.style.minWidth = '290px';

        toast.innerHTML = `
            <div style="display:flex;align-items:center;gap:10px;">
                <div style="color:${type === 'success' ? '#34d399' : '#f87171'};font-size:16px;">
                    ${type === 'success' ? '&#10003;' : '&#9888;'}
                </div>
                <div>
                    <div style="font-weight:700;font-size:13px;">${title}</div>
                    <div style="color:rgba(255,255,255,0.85);font-size:11.5px;margin-top:2px;">${message}</div>
                </div>
            </div>
        `;

        toastContainer.appendChild(toast);
        setTimeout(function () {
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.3s ease';
            setTimeout(function () { toast.remove(); }, 300);
        }, 3500);
    }

    window.uploadAvatar = function (input) {
        if (!input.files || !input.files[0]) return;
        var file = input.files[0];
        var fd = new FormData();
        fd.append('profilePic', file);

        showProfileToast('Uploading', 'Uploading photo to Cloudinary...', 'info');

        fetch('@Url.Action("UploadProfilePicture", "Student")', {
            method: 'POST',
            body: fd
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res.success) {
                showProfileToast('Success', 'Profile picture updated successfully!', 'success');
                var avatarDiv = document.getElementById('profileHeroAvatar');
                avatarDiv.innerHTML = '<img id="avatarImg" src="' + res.url + '" alt="Avatar" style="width:100%;height:100%;object-fit:cover;" />';
            } else {
                showProfileToast('Error', res.message || 'Upload failed.', 'error');
            }
        })
        .catch(function (err) {
            showProfileToast('Error', 'An error occurred during upload.', 'error');
        });
    };
</script>

