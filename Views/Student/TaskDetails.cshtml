                <div style="display:flex;flex-direction:column;gap:var(--space-2);">
                    <button type="button" class="cv-btn cv-btn-secondary" onclick="downloadReceipt()" style="width:100%;justify-content:center;gap:6px;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        <span>Download Submission Receipt</span>
                    </button>

                    <button type="button" class="cv-btn cv-btn-ghost cv-btn-sm" onclick="resetSubmissionForm()" style="color:var(--cv-slate);justify-content:center;">
                        Re-upload / Modify Submission
                    </button>
                </div>
            </div>
        </div>

        <!-- Academic Rubric Quick Summary Card -->
        <div class="cv-card" style="margin-top:var(--space-5);padding:var(--space-5);border-radius:var(--radius-xl);background:var(--cv-white);border:1px solid var(--cv-border);">
            <h4 style="font-family:var(--font-heading);font-size:var(--fs-sm);font-weight:var(--fw-bold);color:var(--cv-navy);margin:0 0 var(--space-3) 0;display:flex;align-items:center;justify-content:space-between;">
                <span>Evaluation Rubric</span>
                <span style="font-size:11px;color:var(--cv-slate);font-weight:normal;">@(Model != null ? Model.MaxScore : 25) Marks Total</span>
            </h4>
            <div style="display:flex;flex-direction:column;gap:var(--space-2);font-size:var(--fs-xs);color:var(--cv-slate);">
                <div style="display:flex;justify-content:space-between;padding-bottom:4px;border-bottom:1px solid var(--cv-border-light);">
                    <span>Core Implementation &amp; Functionality</span>
                    <strong style="color:var(--cv-navy);">@(Model != null ? (int)Math.Round(Model.MaxScore * 0.4) : 10) Marks</strong>
                </div>
                <div style="display:flex;justify-content:space-between;padding-bottom:4px;border-bottom:1px solid var(--cv-border-light);">
                    <span>Code Quality &amp; Architecture Standards</span>
                    <strong style="color:var(--cv-navy);">@(Model != null ? (int)Math.Round(Model.MaxScore * 0.3) : 8) Marks</strong>
                </div>
                <div style="display:flex;justify-content:space-between;padding-bottom:4px;border-bottom:1px solid var(--cv-border-light);">
                    <span>Verification &amp; Test Output Results</span>
                    <strong style="color:var(--cv-navy);">@(Model != null ? (int)Math.Round(Model.MaxScore * 0.15) : 4) Marks</strong>
                </div>
                <div style="display:flex;justify-content:space-between;">
                    <span>Lab Documentation &amp; Report Submission</span>
                    <strong style="color:var(--cv-navy);">@(Model != null ? (Model.MaxScore - (int)Math.Round(Model.MaxScore * 0.4) - (int)Math.Round(Model.MaxScore * 0.3) - (int)Math.Round(Model.MaxScore * 0.15)) : 3) Marks</strong>
                </div>
            </div>
        </div>

    </div>

</div>

@* ==================== 4. CLIENT JAVASCRIPT LOGIC ==================== *@
<script>
    var currentFile = null;

    function triggerFileInput() {
        document.getElementById('assignmentFileInput').click();
    }

    function handleDragOver(e) {
        e.preventDefault();
        e.stopPropagation();
        var dropzone = document.getElementById('dropzone');
        dropzone.classList.add('dragover');
    }

    function handleDragLeave(e) {
        e.preventDefault();
        e.stopPropagation();
        var dropzone = document.getElementById('dropzone');
        dropzone.classList.remove('dragover');
    }

    function handleFileDrop(e) {
        e.preventDefault();
        e.stopPropagation();
        var dropzone = document.getElementById('dropzone');
        dropzone.classList.remove('dragover');

        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
            handleFileSelected(e.dataTransfer.files);
        }
    }

    function handleFileSelected(files) {
        if (!files || files.length === 0) return;
        var file = files[0];
        
        // Format size
        var sizeStr = '';
        if (file.size < 1024 * 1024) {
            sizeStr = (file.size / 1024).toFixed(1) + ' KB';
        } else {
            sizeStr = (file.size / (1024 * 1024)).toFixed(1) + ' MB';
        }

        // Determine friendly type
        var typeStr = 'Document';
        var ext = file.name.split('.').pop().toUpperCase();
        if (ext === 'PDF') typeStr = 'PDF Document';
        else if (ext === 'ZIP') typeStr = 'ZIP Archive';
        else if (ext === 'CPP' || ext === 'C') typeStr = 'C++ Source Code';
        else if (ext === 'JAVA') typeStr = 'Java Source Code';
        else if (ext === 'DOCX' || ext === 'DOC') typeStr = 'Word Document';

        applySelectedFile({
            name: file.name,
            type: typeStr,
            size: sizeStr,
            ext: ext,
            rawSize: file.size
        });
    }

    function loadDemoFile(filename, fileType, fileSize) {
        var ext = filename.split('.').pop().toUpperCase();
        applySelectedFile({
            name: filename,
            type: fileType,
            size: fileSize,
            ext: ext,
            rawSize: 3.8 * 1024 * 1024
        });
        showToast('Demo file "' + filename + '" loaded into submission area.', 'success');
    }

    function applySelectedFile(fileInfo) {
        currentFile = fileInfo;

        // Populate File Preview
        document.getElementById('previewFileName').textContent = fileInfo.name;
        document.getElementById('previewFileType').textContent = fileInfo.type;
        document.getElementById('previewFileSize').textContent = fileInfo.size;
        document.getElementById('previewThumbExt').textContent = fileInfo.ext;

        // Show Preview, hide dropzone
        document.getElementById('filePreviewCard').style.display = 'block';
        document.getElementById('dropzone').style.display = 'none';
        document.getElementById('submissionPanel').classList.add('has-file');

        // Update Validation Checklist
        updateValidationChecklist(true, fileInfo);
    }

    function removeSelectedFile() {
        currentFile = null;
        document.getElementById('assignmentFileInput').value = '';
        document.getElementById('filePreviewCard').style.display = 'none';
        document.getElementById('dropzone').style.display = 'block';
        document.getElementById('submissionPanel').classList.remove('has-file');

        // Reset Checklist
        updateValidationChecklist(false, null);
        showToast('File removed from submission.', 'info');
    }

    function updateValidationChecklist(hasFile, fileInfo) {
        var valUploaded = document.getElementById('valItem-uploaded');
        var valType = document.getElementById('valItem-type');
        var valSize = document.getElementById('valItem-size');
        var valCount = document.getElementById('validationCount');

        if (hasFile && fileInfo) {
            // Check 1: File uploaded
            valUploaded.classList.add('valid');

            // Check 2: File type valid
            var allowedExts = ['PDF', 'ZIP', 'CPP', 'C', 'JAVA', 'DOCX', 'DOC', 'TAR', 'GZ'];
            if (allowedExts.indexOf(fileInfo.ext) !== -1) {
                valType.classList.add('valid');
                valType.classList.remove('invalid');
            } else {
                valType.classList.remove('valid');
                valType.classList.add('invalid');
            }

            // Check 3: File size valid (< 25MB)
            if (fileInfo.rawSize <= 25 * 1024 * 1024) {
                valSize.classList.add('valid');
                valSize.classList.remove('invalid');
            } else {
                valSize.classList.remove('valid');
                valSize.classList.add('invalid');
            }

            valCount.textContent = '4 / 4 Complete';
            valCount.style.background = 'var(--cv-success-bg)';
            valCount.style.color = 'var(--cv-success)';
            valCount.style.borderColor = 'rgba(16, 185, 129, 0.3)';
        } else {
            valUploaded.classList.remove('valid');
            valType.classList.remove('valid', 'invalid');
            valSize.classList.remove('valid', 'invalid');

            valCount.textContent = '1 / 4 Complete';
            valCount.style.background = 'var(--cv-white)';
            valCount.style.color = 'var(--cv-slate)';
            valCount.style.borderColor = 'var(--cv-border)';
        }
    }

    function submitAssignment() {
        if (!currentFile) {
            // Highlight dropzone & show warning
            var dropzone = document.getElementById('dropzone');
            dropzone.style.borderColor = 'var(--cv-danger)';
            dropzone.style.background = '#FEF2F2';
            setTimeout(function () {
                dropzone.style.borderColor = '';
                dropzone.style.background = '';
            }, 1200);

            showToast('Please select or drop a file before submitting assignment.', 'danger');
            return;
        }

        var btn = document.getElementById('btnSubmitAssignment');
        btn.disabled = true;
        btn.innerHTML = '<span class="cv-spinner" style="width:16px;height:16px;border:2px solid #fff;border-top-color:transparent;border-radius:50%;display:inline-block;animation:spin 0.8s linear infinite;margin-right:8px;"></span> Submitting to CampusVault...';

        setTimeout(function () {
            // Generate receipt details
            var randNum = Math.floor(1000 + Math.random() * 9000);
            var receipt = 'CV-SUB-2026-' + randNum;
            document.getElementById('receiptId').textContent = receipt;
            document.getElementById('submittedFilenameDisplay').textContent = currentFile.name;

            // Current date time formatted
            var now = new Date();
            var dateStr = '23 Aug 2026 • ' + now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            document.getElementById('submissionTimestamp').textContent = dateStr;

            // Switch to Success View
            document.getElementById('submissionBody').style.display = 'none';
            document.getElementById('submissionSuccessView').style.display = 'block';

            // Update Badges on Hero & Panel
            var heroBadge = document.getElementById('heroStatusBadge');
            heroBadge.className = 'cv-badge cv-badge-dot cv-badge-success';
            heroBadge.textContent = 'Submitted';
            document.getElementById('heroStatusCard').style.background = 'var(--cv-success-bg)';
            document.getElementById('heroStatusCard').style.borderColor = 'rgba(16, 185, 129, 0.3)';

            var panelBadge = document.getElementById('panelStatusBadge');
            panelBadge.className = 'cv-badge cv-badge-dot cv-badge-success';
            panelBadge.textContent = 'Submitted';
            panelBadge.style.background = 'rgba(16, 185, 129, 0.2)';
            panelBadge.style.color = '#A7F3D0';
            panelBadge.style.borderColor = 'rgba(16, 185, 129, 0.4)';

            showToast('Assignment submitted successfully! Receipt #' + receipt + ' generated.', 'success');
        }, 1200);
    }

    function resetSubmissionForm() {
        document.getElementById('submissionBody').style.display = 'block';
        document.getElementById('submissionSuccessView').style.display = 'none';

        var btn = document.getElementById('btnSubmitAssignment');
        btn.disabled = false;
        btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg><span>Submit Assignment</span>';

        removeSelectedFile();

        // Restore pending badges
        var heroBadge = document.getElementById('heroStatusBadge');
        heroBadge.className = 'cv-badge cv-badge-dot cv-badge-warning';
        heroBadge.textContent = 'Pending';
        document.getElementById('heroStatusCard').style.background = 'var(--cv-warning-bg)';
        document.getElementById('heroStatusCard').style.borderColor = 'rgba(245, 158, 11, 0.25)';

        var panelBadge = document.getElementById('panelStatusBadge');
        panelBadge.className = 'cv-badge cv-badge-dot cv-badge-warning';
        panelBadge.textContent = 'Pending';
        panelBadge.style.background = 'rgba(245, 158, 11, 0.2)';
        panelBadge.style.color = '#FDE68A';
        panelBadge.style.borderColor = 'rgba(245, 158, 11, 0.4)';
    }

    function downloadAttachment(filename) {
        showToast('Downloading "' + filename + '" from CampusVault repository...', 'info');
        setTimeout(function () {
            showToast('Download complete: "' + filename + '" (2.4 MB)', 'success');
        }, 1000);
    }

    function previewAttachment(filename) {
        showToast('Opening in-browser preview for "' + filename + '"...', 'info');
    }

    function downloadReceipt() {
        var receipt = document.getElementById('receiptId').textContent;
        showToast('Generated verified submission receipt ' + receipt + '.pdf', 'success');
    }

    // Toast helper
    function showToast(message, type) {
        var toastContainer = document.querySelector('.cv-toast-container');
        if (!toastContainer) {
            toastContainer = document.createElement('div');
            toastContainer.className = 'cv-toast-container';
            document.body.appendChild(toastContainer);
        }

        var toast = document.createElement('div');
        toast.className = 'cv-toast toast-' + (type || 'info');

        var iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="cv-toast-icon"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
        if (type === 'success') {
            iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="cv-toast-icon"><polyline points="20 6 9 17 4 12"/></svg>';
        } else if (type === 'danger') {
            iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="cv-toast-icon"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
        }

        toast.innerHTML = iconSvg + '<div style="flex:1;font-size:13px;line-height:1.4;">' + message + '</div>';
        toastContainer.appendChild(toast);

        setTimeout(function () {
            toast.classList.add('removing');
            setTimeout(function () {
                if (toast.parentNode) toast.parentNode.removeChild(toast);
            }, 300);
        }, 3500);
    }
</script>

