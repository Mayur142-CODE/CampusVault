                </h3>

                <p style="font-size:var(--fs-sm);color:var(--cv-slate);margin:0 0 var(--space-4) 0;line-height:1.5;">
                    Your work for <strong>@(Model != null ? Model.Title : "Assignment")</strong> has been received and timestamped for evaluation.
                </p>

                <!-- Academic Submission Receipt Box -->
                <div class="cv-receipt-box">
                    <div style="font-weight:var(--fw-bold);color:var(--cv-navy);margin-bottom:var(--space-2);display:flex;align-items:center;justify-content:space-between;">
                        <span>CampusVault Submission Receipt</span>
                        <span style="color:var(--cv-success);font-weight:700;">VERIFIED</span>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-2);color:var(--cv-slate);">
                        <div>Receipt ID: <strong style="color:var(--cv-navy);" id="receiptId">CV-2026-8941</strong></div>
                        <div>Status: <strong style="color:var(--cv-success);">Submitted</strong></div>
                        <div>Submitted by: <strong style="color:var(--cv-navy);">@(Session["UserFullName"] ?? "Prit Pansuriyaa")</strong></div>
                        <div>Roll No: <strong style="color:var(--cv-navy);">@(Session["RollNo"] ?? "21CE048")</strong></div>
                        <div style="grid-column:1 / -1;">Timestamp: <strong style="color:var(--cv-navy);" id="submissionTimestamp">@DateTime.Now.ToString("dd MMM yyyy • hh:mm tt")</strong></div>
                        <div style="grid-column:1 / -1;">Document: <strong style="color:var(--cv-navy);" id="submittedFilenameDisplay">Submission_Document.pdf</strong></div>
