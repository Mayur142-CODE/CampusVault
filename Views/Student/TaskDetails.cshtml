                            1 / 4 Complete
                        </span>
                    </div>

                    <ul class="cv-validation-list" id="validationList">
                        <!-- 1: File uploaded -->
                        <li class="cv-val-item" id="valItem-uploaded">
                            <div class="cv-val-icon" id="valIcon-uploaded">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="width:10px;height:10px;"><polyline points="20 6 9 17 4 12"/></svg>
                            </div>
                            <span class="val-text">File uploaded</span>
                        </li>

                        <!-- 2: File type valid -->
                        <li class="cv-val-item" id="valItem-type">
                            <div class="cv-val-icon" id="valIcon-type">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="width:10px;height:10px;"><polyline points="20 6 9 17 4 12"/></svg>
                            </div>
                            <span class="val-text">File type valid (.pdf, .zip, .cpp)</span>
                        </li>

                        <!-- 3: File size valid -->
                        <li class="cv-val-item" id="valItem-size">
                            <div class="cv-val-icon" id="valIcon-size">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="width:10px;height:10px;"><polyline points="20 6 9 17 4 12"/></svg>
                            </div>
                            <span class="val-text">File size valid (&lt; 25 MB)</span>
                        </li>

                        <!-- 4: Deadline valid -->
                        <li class="cv-val-item valid" id="valItem-deadline">
                            <div class="cv-val-icon" id="valIcon-deadline">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="width:10px;height:10px;"><polyline points="20 6 9 17 4 12"/></svg>
                            </div>
                            <span class="val-text">Deadline (@(Model != null ? Model.DueDate.ToString("MMM dd, yyyy") : "Valid"))</span>
                        </li>
                    </ul>
                </div>

                <!-- 4. ACTION BUTTON: "Submit Assignment" -->
                <button type="button" class="cv-btn cv-btn-primary" id="btnSubmitAssignment" onclick="submitAssignment()" style="width:100%;padding:var(--space-4);font-size:var(--fs-base);font-weight:var(--fw-bold);box-shadow:var(--shadow-md);display:flex;align-items:center;justify-content:center;gap:var(--space-2);background:linear-gradient(135deg, var(--cv-indigo) 0%, #4338CA 100%);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;">
                        <line x1="22" y1="2" x2="11" y2="13"/>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                    <span>Submit Assignment</span>
