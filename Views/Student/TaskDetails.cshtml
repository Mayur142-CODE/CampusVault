                <!-- Hidden Native File Input -->
                <input type="file" id="assignmentFileInput" style="display:none;" accept=".pdf,.zip,.cpp,.java,.docx,.tar.gz" onchange="handleFileSelected(this.files)" />

                <!-- Quick Demo Autofill Helpers -->
                <div style="margin:var(--space-3) 0 var(--space-4) 0;display:flex;align-items:center;justify-content:space-between;gap:var(--space-2);background:var(--cv-bg-alt);padding:6px 12px;border-radius:var(--radius-md);border:1px dashed var(--cv-border);">
