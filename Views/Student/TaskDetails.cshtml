                    <!-- Upload Progress indicator -->
                    <div style="margin-top:var(--space-3);padding-top:var(--space-2);border-top:1px solid var(--cv-border-light);">
                        <div style="display:flex;align-items:center;justify-content:space-between;font-size:11px;color:var(--cv-success);font-weight:600;margin-bottom:4px;">
