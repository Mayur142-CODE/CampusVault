@model CampusVault.Models.Academic.ClassroomTask
@{
    ViewBag.Title = (Model != null ? Model.Title : "Task Details") + " — CampusVault";
    ViewBag.ActiveNav = "Tasks";
    string status = Model != null && !string.IsNullOrEmpty(Model.Status) ? Model.Status : "Pending";
    bool isSubmitted = status.Equals("Submitted", StringComparison.OrdinalIgnoreCase) || status.Equals("Graded", StringComparison.OrdinalIgnoreCase);
    bool isOverdue = Model != null && Model.DueDate < DateTime.Now && !isSubmitted;
}

@* ==================== 1. BREADCRUMBS & NAVIGATION ==================== *@
<div class="cv-breadcrumbs-bar animate-slide-up" style="display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);flex-wrap:wrap;margin-bottom:var(--space-5);">
    <div style="display:flex;align-items:center;gap:var(--space-2);font-size:var(--fs-sm);color:var(--cv-slate);">
        <a href="@Url.Action("Dashboard", "Student")" style="color:var(--cv-slate);text-decoration:none;display:inline-flex;align-items:center;gap:4px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
            Dashboard
        </a>
        <span style="color:var(--cv-border-dark);">/</span>
        <a href="@Url.Action("Classrooms", "Student")" style="color:var(--cv-slate);text-decoration:none;">
            Classrooms
        </a>
        <span style="color:var(--cv-border-dark);">/</span>
        <a href="@Url.Action("ClassroomDetails", "Student", new { id = Model != null ? Model.ClassroomId : 1 })" style="color:var(--cv-slate);text-decoration:none;">
            @(Model != null && !string.IsNullOrEmpty(Model.CourseName) ? Model.CourseName : "Classroom")
        </a>
        <span style="color:var(--cv-border-dark);">/</span>
        <span style="color:var(--cv-navy);font-weight:var(--fw-semibold);">@(Model != null ? Model.Title : "Task Details")</span>
    </div>

    <div style="display:flex;align-items:center;gap:var(--space-3);">
        <a href="@Url.Action("Classrooms", "Student")" class="cv-btn cv-btn-secondary cv-btn-sm" style="display:inline-flex;align-items:center;gap:6px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><polyline points="15 18 9 12 15 6"/></svg>
            Back to Classrooms
        </a>
        <a href="@Url.Action("ClassroomDetails", "Student", new { id = Model != null ? Model.ClassroomId : 1 })" class="cv-btn cv-btn-ghost cv-btn-sm" style="color:var(--cv-indigo);">
            Open Classroom
        </a>
    </div>
</div>

@* ==================== 2. TASK HERO BANNER ==================== *@
<div class="cv-task-hero-banner animate-slide-up stagger-1">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-4);flex-wrap:wrap;">
        <div style="flex:1;min-width:300px;">
            <div style="display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap;margin-bottom:var(--space-2);">
                <span class="cv-badge" style="background:var(--cv-indigo-pale);color:var(--cv-indigo);font-weight:var(--fw-bold);padding:4px 10px;">
                    @(Model != null ? Model.CourseCode : "DBMS") &bull; @(Model != null ? Model.CourseName : "Course")
                </span>
                <span class="cv-badge" style="background:var(--cv-bg-alt);color:var(--cv-slate);border:1px solid var(--cv-border);">
                    @(Model != null ? Model.TaskType : "Lab Practical")
                </span>
                <span class="cv-badge" style="background:var(--cv-bg-alt);color:var(--cv-slate);border:1px solid var(--cv-border);">
                    Task #@(Model != null ? Model.TaskId : 1)
                </span>
            </div>

            <h1 style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);letter-spacing:-0.015em;margin:0 0 var(--space-2) 0;">
                @(Model != null ? Model.Title : "Task Details")
            </h1>

            <p style="color:var(--cv-slate);font-size:var(--fs-base);margin:0;max-width:760px;line-height:1.5;">
                @(Model != null && !string.IsNullOrEmpty(Model.Description) ? Model.Description : "Academic task instructions and digital submission portal.")
            </p>
        </div>

        <!-- Prominent Marks & Status Card -->
        <div style="display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap;">
            <div style="background:var(--cv-bg-alt);border:1px solid var(--cv-border);border-radius:var(--radius-lg);padding:var(--space-3) var(--space-4);text-align:center;min-width:130px;">
                <span style="display:block;font-size:11px;text-transform:uppercase;letter-spacing:0.05em;color:var(--cv-slate);font-weight:var(--fw-semibold);margin-bottom:2px;">
                    Maximum Marks
                </span>
                <span style="font-family:var(--font-heading);font-size:var(--fs-2xl);font-weight:var(--fw-bold);color:var(--cv-navy);">
                    @(Model != null ? Model.MaxScore : 100)
                </span>
                <span style="font-size:11px;color:var(--cv-slate);margin-left:2px;">pts</span>
            </div>

            <div style="background:@(isSubmitted ? "var(--cv-success-bg)" : "var(--cv-warning-bg)");border:1px solid @(isSubmitted ? "rgba(16, 185, 129, 0.3)" : "rgba(245, 158, 11, 0.25)");border-radius:var(--radius-lg);padding:var(--space-3) var(--space-4);text-align:center;min-width:130px;" id="heroStatusCard">
                <span style="display:block;font-size:11px;text-transform:uppercase;letter-spacing:0.05em;color:@(isSubmitted ? "var(--cv-success)" : "var(--cv-warning)");font-weight:var(--fw-bold);margin-bottom:2px;">
                    Status
                </span>
                <span class="cv-badge cv-badge-dot @(isSubmitted ? "cv-badge-success" : "cv-badge-warning")" id="heroStatusBadge" style="font-size:13px;font-weight:var(--fw-bold);">
                    @status
                </span>
            </div>
        </div>
    </div>

    <!-- Meta Details Bar -->
    <div class="cv-task-meta-bar">
        <div class="cv-task-meta-pill" style="@(isOverdue ? "border-left:3px solid var(--cv-danger);" : "border-left:3px solid var(--cv-indigo);")">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;flex-shrink:0;color:@(isOverdue ? "var(--cv-danger)" : "var(--cv-indigo)");">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>Due: <strong>@(Model != null ? Model.DueDate.ToString("dd MMMM yyyy • hh:mm tt") : "TBA")</strong></span>
        </div>

        <div class="cv-task-meta-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;flex-shrink:0;color:var(--cv-indigo);">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
            <span>Faculty: <strong>@(Model != null && !string.IsNullOrEmpty(Model.FacultyName) ? Model.FacultyName : "Faculty Mentor")</strong></span>
        </div>

        <div class="cv-task-meta-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;flex-shrink:0;color:var(--cv-indigo);">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
            </svg>
            <span>Type: <strong>@(Model != null ? Model.TaskType : "Individual Lab")</strong></span>
        </div>

        <div class="cv-task-meta-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;flex-shrink:0;color:var(--cv-gold-dark);">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
            <span>Weightage: <strong>@(Model != null ? Model.MaxScore : 20) Marks Assessment</strong></span>
        </div>
    </div>
</div>

@* ==================== 3. TWO-COLUMN WORKSPACE ==================== *@
<div class="cv-task-detail-grid">

    <!-- LEFT COLUMN: Description, Requirements, and Attachments -->
    <div class="cv-task-left-col animate-slide-up stagger-2">

        <!-- SECTION 1: DESCRIPTION -->
        <div class="cv-content-card" id="section-description">
            <div class="cv-section-title">
                <div class="cv-section-title-left">
                    <div class="cv-section-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
                            <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
                        </svg>
                    </div>
                    <span>Description</span>
                </div>
                <span style="font-size:var(--fs-xs);color:var(--cv-slate);font-weight:var(--fw-normal);">
                    Core Assignment Objective
                </span>
            </div>

            <div style="color:var(--cv-ink);font-size:var(--fs-base);line-height:1.7;">
                <p style="margin:0 0 var(--space-4) 0;font-size:var(--fs-lg);font-weight:var(--fw-medium);color:var(--cv-navy);">
                    @(Model != null ? Model.Title : "Task Overview")
                </p>

                <p style="margin:0 0 var(--space-4) 0;color:var(--cv-slate);">
                    @(Model != null && !string.IsNullOrEmpty(Model.Description) ? Model.Description : "Complete all tasks and submit according to the requirements specified below.")
                </p>

                <div style="background:var(--cv-bg-alt);border:1px solid var(--cv-border);border-left:4px solid var(--cv-indigo);border-radius:var(--radius-md);padding:var(--space-4);margin-bottom:var(--space-4);">
                    <h4 style="font-size:var(--fs-sm);font-weight:var(--fw-bold);color:var(--cv-navy);margin:0 0 var(--space-2) 0;">
                        Course &amp; Task Deliverables:
                    </h4>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-3);font-size:var(--fs-sm);">
                        <div>
                            <strong style="color:var(--cv-indigo);">Course:</strong>
                            <p style="margin:4px 0 0 0;color:var(--cv-slate);">@(Model != null ? Model.CourseCode + " — " + Model.CourseName : "Coursework")</p>
                        </div>
                        <div>
                            <strong style="color:var(--cv-gold-dark);">Assessment Type:</strong>
                            <p style="margin:4px 0 0 0;color:var(--cv-slate);">@(Model != null ? Model.TaskType : "Practical Task") (@(Model != null ? Model.MaxScore : 25) Points)</p>
                        </div>
                    </div>
                </div>

                <div style="display:flex;align-items:center;gap:var(--space-3);padding:var(--space-3) var(--space-4);background:rgba(245, 158, 11, 0.08);border:1px solid rgba(245, 158, 11, 0.25);border-radius:var(--radius-md);font-size:var(--fs-xs);color:var(--cv-warning-dark);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;flex-shrink:0;color:var(--cv-warning);">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span>
                        <strong>Academic Evaluation Note:</strong> Submissions must be your original work for <strong>@(Model != null ? Model.Title : "this task")</strong>. All code files and documentation are evaluated according to the departmental grading rubric.
                    </span>
                </div>
            </div>
        </div>

        <!-- SECTION 2: REQUIREMENTS -->
        <div class="cv-content-card" id="section-requirements">
            <div class="cv-section-title">
                <div class="cv-section-title-left">
                    <div class="cv-section-icon" style="background:var(--cv-success-bg);color:var(--cv-success);">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                        </svg>
                    </div>
                    <span>Requirements</span>
                </div>
                <span class="cv-badge" style="background:var(--cv-bg-alt);color:var(--cv-slate);border:1px solid var(--cv-border);">
                    4 Mandatory Components
                </span>
            </div>

            <p style="color:var(--cv-slate);font-size:var(--fs-sm);margin:0 0 var(--space-4) 0;">
                All submissions must adhere to the academic standards of the Department of Computer Engineering. Ensure all four requirements are packaged into your final submission:
            </p>

            <div class="cv-requirements-grid">
                <!-- Requirement 1: Source code -->
                <div class="cv-requirement-item">
                    <div class="cv-req-badge-icon" style="background:#EFF6FF;color:#2563EB;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;">
                            <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                        </svg>
                    </div>
                    <div>
                        <div style="display:flex;align-items:center;gap:6px;margin-bottom:2px;">
                            <h4 style="font-size:var(--fs-sm);font-weight:var(--fw-bold);color:var(--cv-navy);margin:0;">
                                Source Code &amp; Assets
                            </h4>
                            <span style="font-size:10px;padding:2px 6px;border-radius:4px;background:#DBEAFE;color:#1E40AF;font-weight:600;">
                                Implementation
                            </span>
                        </div>
                        <p style="font-size:var(--fs-xs);color:var(--cv-slate);margin:0;line-height:1.4;">
                            Complete, well-commented source code or project repository files satisfying the technical objectives of @(Model != null ? Model.Title : "this task").
                        </p>
                    </div>
                </div>

                <!-- Requirement 2: Explanation -->
                <div class="cv-requirement-item">
                    <div class="cv-req-badge-icon" style="background:#F5F3FF;color:#7C3AED;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                        </svg>
                    </div>
                    <div>
                        <div style="display:flex;align-items:center;gap:6px;margin-bottom:2px;">
                            <h4 style="font-size:var(--fs-sm);font-weight:var(--fw-bold);color:var(--cv-navy);margin:0;">
                                Technical Documentation
                            </h4>
                            <span style="font-size:10px;padding:2px 6px;border-radius:4px;background:#EDE9FE;color:#5B21B6;font-weight:600;">
                                Architecture
                            </span>
                        </div>
                        <p style="font-size:var(--fs-xs);color:var(--cv-slate);margin:0;line-height:1.4;">
                            Clear architectural breakdown explaining the system design, endpoints/schema, algorithms used, and verification steps performed.
                        </p>
                    </div>
                </div>

                <!-- Requirement 3: Output screenshots -->
                <div class="cv-requirement-item">
                    <div class="cv-req-badge-icon" style="background:#ECFDF5;color:#059669;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
                        </svg>
                    </div>
                    <div>
                        <div style="display:flex;align-items:center;gap:6px;margin-bottom:2px;">
                            <h4 style="font-size:var(--fs-sm);font-weight:var(--fw-bold);color:var(--cv-navy);margin:0;">
                                Output screenshots
                            </h4>
                            <span style="font-size:10px;padding:2px 6px;border-radius:4px;background:#D1FAE5;color:#065F46;font-weight:600;">
                                Verification
                            </span>
                        </div>
                        <p style="font-size:var(--fs-xs);color:var(--cv-slate);margin:0;line-height:1.4;">
                            High-clarity terminal or command prompt captures showcasing compile-time success, interactive menu choices, and testing of edge cases (empty list, boundary nodes).
                        </p>
                    </div>
                </div>

                <!-- Requirement 4: PDF report -->
                <div class="cv-requirement-item">
                    <div class="cv-req-badge-icon" style="background:#FEF2F2;color:#DC2626;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/>
                        </svg>
                    </div>
                    <div>
                        <div style="display:flex;align-items:center;gap:6px;margin-bottom:2px;">
                            <h4 style="font-size:var(--fs-sm);font-weight:var(--fw-bold);color:var(--cv-navy);margin:0;">
                                PDF report
                            </h4>
                            <span style="font-size:10px;padding:2px 6px;border-radius:4px;background:#FEE2E2;color:#991B1B;font-weight:600;">
                                Formal
                            </span>
                        </div>
                        <p style="font-size:var(--fs-xs);color:var(--cv-slate);margin:0;line-height:1.4;">
                            A single, consolidated PDF lab report incorporating title page, student metadata (Roll No., Semester, Division), flowchart, code snippets, and execution results.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 3: ATTACHMENTS -->
        @{
            var realAttachments = ViewBag.Attachments as List<CampusVault.Models.Faculty.TaskAttachmentItem>;
        }
        @if (realAttachments != null && realAttachments.Count > 0)
        {
            <div class="cv-content-card" id="section-attachments">
                <div class="cv-section-title">
                    <div class="cv-section-title-left">
                        <div class="cv-section-icon" style="background:rgba(217, 119, 6, 0.12);color:var(--cv-gold-dark);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                            </svg>
                        </div>
                        <span>Reference Attachments</span>
                    </div>
                    <span style="font-size:var(--fs-xs);color:var(--cv-slate);">
                        @realAttachments.Count File@(realAttachments.Count > 1 ? "s" : "") Available
                    </span>
                </div>

                @foreach (var att in realAttachments)
                {
                    <div class="cv-attachment-card" style="margin-bottom: var(--space-3);">
                        <div class="cv-attachment-left">
                            <div class="cv-file-type-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;margin-bottom:2px;">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                                </svg>
                                <span>@(string.IsNullOrEmpty(att.FileType) ? "FILE" : att.FileType.ToUpperInvariant())</span>
                            </div>

                            <div style="min-width:0;">
                                <h4 style="font-family:var(--font-heading);font-size:var(--fs-base);font-weight:var(--fw-bold);color:var(--cv-navy);margin:0 0 2px 0;word-break:break-all;">
                                    @att.FileName
                                </h4>
                                <div style="display:flex;align-items:center;gap:var(--space-3);font-size:var(--fs-xs);color:var(--cv-slate);flex-wrap:wrap;">
                                    <span>@att.FileSize</span>
                                    <span>•</span>
                                    <span>Uploaded on @att.UploadedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        </div>

                        <div style="display:flex;align-items:center;gap:var(--space-2);flex-shrink:0;">
                            <a href="@Url.Action("DownloadAttachment", "Student", new { id = att.AttachmentId })" class="cv-btn cv-btn-secondary cv-btn-sm" style="display:inline-flex;align-items:center;gap:6px;text-decoration:none;" download>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                <span>Download</span>
                            </a>
                        </div>
                    </div>
                }

                <div style="margin-top:var(--space-4);padding:var(--space-3) var(--space-4);background:var(--cv-bg-alt);border-radius:var(--radius-md);font-size:var(--fs-xs);color:var(--cv-slate);display:flex;align-items:center;justify-content:space-between;">
                    <span>Need extra help or syllabus clarification? Check the classroom overview.</span>
                    <a href="@Url.Action("ClassroomDetails", "Student", new { id = Model != null ? Model.ClassroomId : 1 })" style="color:var(--cv-indigo);font-weight:500;text-decoration:none;display:inline-flex;align-items:center;gap:4px;">
                        View Classroom
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px;"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>
            </div>
        }

    </div>

    <!-- RIGHT COLUMN: Visually Prominent SUBMISSION AREA -->
    <div class="cv-task-right-col animate-slide-up stagger-3">

        <div class="cv-submission-panel" id="submissionPanel">
            <!-- Prominent Header -->
            <div class="cv-submission-header" style="background:linear-gradient(135deg, #0b192c 0%, #1e293b 100%);color:#ffffff;">
                <div>
                    <h3 style="font-family:var(--font-heading);font-size:var(--fs-lg);font-weight:var(--fw-bold);margin:0 0 2px 0;color:#ffffff !important;">
                        Submission Area
                    </h3>
                    <p style="font-size:var(--fs-xs);color:rgba(255,255,255,0.85);margin:0;">
                        Upload your completed academic work
                    </p>
                </div>

                <div style="display:flex;flex-direction:column;align-items:flex-end;">
                    <span style="font-size:10px;text-transform:uppercase;letter-spacing:0.06em;color:rgba(255,255,255,0.7);margin-bottom:2px;">
                        Current Status
                    </span>
                    <span class="cv-badge cv-badge-dot cv-badge-warning" id="panelStatusBadge" style="font-size:12px;font-weight:var(--fw-bold);background:rgba(245, 158, 11, 0.2);color:#FDE68A;border:1px solid rgba(245, 158, 11, 0.4);">
