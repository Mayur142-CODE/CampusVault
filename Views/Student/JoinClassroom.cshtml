@{
    ViewBag.Title = "Join Classroom — CampusVault";
    ViewBag.Role = "Student";
}

@* Back Link Breadcrumb *@
<div style="margin-bottom:18px;">
    <a href="@Url.Action("Classrooms", "Student")" style="display:inline-flex;align-items:center;gap:6px;color:#64748b;font-size:13px;font-weight:600;text-decoration:none;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        <span>Back to My Classrooms</span>
    </a>
</div>

@* ==================== JOIN CLASSROOM WORKSPACE ==================== *@
<div style="max-width:680px;margin:0 auto;">
    <div style="background:#ffffff;border:1px solid #e2e8f0;border-radius:16px;padding:32px;box-shadow:0 6px 20px rgba(15, 23, 42, 0.05);">
        
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid #f1f5f9;">
            <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg, #0b192c 0%, #1e3a5f 100%);color:#f59e0b;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px rgba(11,25,44,0.25);flex-shrink:0;">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/></svg>
            </div>
            <div>
                <h1 style="font-family:'DM Sans', -apple-system, sans-serif;font-size:22px;font-weight:700;color:#0b192c;margin:0 0 4px 0;">
                    Join Academic Classroom
                </h1>
                <p style="font-size:13.5px;color:#64748b;margin:0;">
                    Enter the authorized section key provided by your course faculty or academic advisor.
                </p>
            </div>
        </div>

        @* Quick Code Helper Chips *@
        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:16px;margin-bottom:24px;">
            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;margin-bottom:10px;">
                Available Classroom Codes (Quick Select)
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <button type="button" onclick="applyClassCode('DBMS-501', 'Database Management Systems', 'Prof. V. Sharma')" style="background:#ffffff;border:1px solid #cbd5e1;border-radius:6px;padding:6px 12px;font-size:12px;font-weight:600;color:#1e293b;cursor:pointer;">
                    DBMS-501 &bull; Database Systems
                </button>
                <button type="button" onclick="applyClassCode('NSC-502', 'Network Security & Cryptography', 'Dr. R. Joshi')" style="background:#ffffff;border:1px solid #cbd5e1;border-radius:6px;padding:6px 12px;font-size:12px;font-weight:600;color:#1e293b;cursor:pointer;">
                    NSC-502 &bull; Network Security
                </button>
                <button type="button" onclick="applyClassCode('SWE-503', 'Full Stack Web Engineering', 'Prof. K. Patel')" style="background:#ffffff;border:1px solid #cbd5e1;border-radius:6px;padding:6px 12px;font-size:12px;font-weight:600;color:#1e293b;cursor:pointer;">
                    SWE-503 &bull; Web Engineering
                </button>
                <button type="button" onclick="applyClassCode('CID-504', 'Cloud Infrastructure & DevOps', 'Prof. A. Mehta')" style="background:#ffffff;border:1px solid #cbd5e1;border-radius:6px;padding:6px 12px;font-size:12px;font-weight:600;color:#1e293b;cursor:pointer;">
                    CID-504 &bull; Cloud &amp; DevOps
                </button>
            </div>
        </div>

        @* Alert message box *@
        <div id="joinAlert" style="display:none;padding:12px 16px;border-radius:8px;margin-bottom:18px;font-size:13px;font-weight:500;"></div>

        <form id="joinClassroomForm" onsubmit="handleJoinClassroom(event)">
            <div style="margin-bottom:20px;">
                <label for="classCodeInput" style="display:block;font-size:12px;font-weight:700;color:#334155;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.04em;">Classroom Section Key</label>
                <div style="position:relative;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <input type="text" id="classCodeInput" placeholder="e.g. DBMS-501" style="width:100%;padding:11px 14px 11px 40px;border:1px solid #cbd5e1;border-radius:8px;font-size:14px;font-family:monospace;letter-spacing:0.08em;font-weight:700;color:#0f172a;box-sizing:border-box;" required />
                </div>
                <span style="display:block;font-size:11.5px;color:#64748b;margin-top:6px;">Check your course syllabus notice for your designated section code.</span>
            </div>

            @* Live Classroom Preview Card *@
            <div id="classroomPreviewCard" style="display:none;background:#f0fdf4;border:1px solid #86efac;border-radius:10px;padding:16px;margin-bottom:20px;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;">
                    <span id="previewCourseCode" style="background:#dcfce7;color:#15803d;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;">DBMS-501</span>
                    <span style="font-size:11.5px;color:#15803d;font-weight:600;">Verified Active Section</span>
                </div>
                <h4 id="previewClassName" style="font-size:15px;font-weight:700;color:#0b192c;margin:4px 0 2px 0;">
                    Database Management Systems
                </h4>
                <div id="previewFaculty" style="font-size:12px;color:#166534;">
                    Instructor: Prof. V. Sharma
                </div>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:12px;border-top:1px solid #e2e8f0;padding-top:20px;">
                <a href="@Url.Action("Classrooms", "Student")" style="background:#f1f5f9;color:#334155;border:1px solid #cbd5e1;border-radius:8px;padding:10px 20px;font-size:13px;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;">Cancel</a>
                <button type="submit" id="enrollSubmitBtn" style="background:linear-gradient(135deg, #d97706 0%, #b45309 100%);color:#ffffff;border:none;border-radius:8px;padding:10px 24px;font-size:13px;font-weight:700;cursor:pointer;box-shadow:0 4px 12px rgba(217,119,6,0.35);">
                    Enroll in Classroom &rarr;
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function applyClassCode(code, name, faculty) {
        document.getElementById('classCodeInput').value = code;
        var card = document.getElementById('classroomPreviewCard');
        document.getElementById('previewCourseCode').textContent = code;
        document.getElementById('previewClassName').textContent = name;
        document.getElementById('previewFaculty').textContent = 'Instructor: ' + faculty;
        card.style.display = 'block';
    }

    async function handleJoinClassroom(e) {
        e.preventDefault();
        var btn = document.getElementById('enrollSubmitBtn');
        var code = document.getElementById('classCodeInput').value.trim();
        var alertBox = document.getElementById('joinAlert');

        btn.disabled = true;
        btn.textContent = 'Enrolling...';
        alertBox.style.display = 'none';

        try {
            var formData = new URLSearchParams();
            formData.append('joinCode', code);

            var res = await fetch('@Url.Action("JoinClassroom", "Student")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData.toString()
            });

            var data = await res.json();
            if (data.success) {
                alertBox.style.display = 'block';
                alertBox.style.background = '#f0fdf4';
                alertBox.style.color = '#15803d';
                alertBox.style.border = '1px solid #86efac';
                alertBox.textContent = data.message || 'Successfully joined classroom! Redirecting...';

                setTimeout(function () {
                    window.location.href = '@Url.Action("Classrooms", "Student")';
                }, 1000);
            } else {
                alertBox.style.display = 'block';
                alertBox.style.background = '#fef2f2';
                alertBox.style.color = '#dc2626';
                alertBox.style.border = '1px solid #fecaca';
                alertBox.textContent = data.message || 'Failed to join classroom.';
                btn.disabled = false;
                btn.textContent = 'Enroll in Classroom →';
            }
        } catch (err) {
            alertBox.style.display = 'block';
            alertBox.style.background = '#fef2f2';
            alertBox.style.color = '#dc2626';
            alertBox.style.border = '1px solid #fecaca';
            alertBox.textContent = 'Connection error. Please try again.';
            btn.disabled = false;
            btn.textContent = 'Enroll in Classroom →';
        }
    }
</script>
