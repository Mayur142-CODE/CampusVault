@{
    var pageTitle = ViewBag.Title as string ?? "CampusVault";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle — CampusVault</title>
    <meta name="description" content="CampusVault — University Academic Document Management & Learning Workspace" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/campusvault.css")" rel="stylesheet" />
</head>
<body class="cv-public-body">
    @RenderBody()

    <script src="@Url.Content("~/Content/js/campusvault.js")"></script>
    @if (IsSectionDefined("Scripts"))
    {
        @RenderSection("Scripts", required: false)
    }
</body>
</html>
