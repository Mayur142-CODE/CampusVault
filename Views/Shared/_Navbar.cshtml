@{
    var pageTitle = ViewBag.Title as string ?? "Dashboard";
    var userName = Session["UserName"] as string ?? ViewBag.UserName as string ?? "User";
    var userInitials = Session["UserInitials"] as string ?? ViewBag.UserInitials as string ?? "CV";
    var userEmail = Session["UserEmail"] as string ?? Session["Email"] as string ?? "";
    var role = Session["Role"] as string ?? ViewBag.Role as string ?? "Student";
    var userRole = Session["UserRoleDisplay"] as string ?? ViewBag.UserRoleDisplay as string ?? (role == "Student" ? "Enrolled Student" : (role == "Faculty" ? "Faculty Mentor" : "Administrator"));
    var breadcrumbs = ViewBag.Breadcrumbs as string[] ?? new string[] { };
    var profileUrl = role == "Admin" ? Url.Action("Profile", "Admin") : (role == "Faculty" ? Url.Action("Profile", "Faculty") : Url.Action("Profile", "Student"));
}
<header class="cv-navbar" id="cvNavbar">
    @* Mobile menu toggle *@
    <button class="cv-mobile-toggle" id="mobileToggle" title="Open menu" aria-label="Toggle navigation menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    @* Page title / Breadcrumb *@
    <div class="cv-navbar-title">
        @if (breadcrumbs.Length > 0)
        {
            <nav class="cv-breadcrumb">
                @for (int i = 0; i < breadcrumbs.Length; i++)
                {
                    if (i < breadcrumbs.Length - 1)
                    {
                        <span class="breadcrumb-item" style="color:var(--cv-slate-500);font-weight:500;">@breadcrumbs[i]</span>
                        <span class="breadcrumb-sep">›</span>
                    }
                    else
                    {
                        <span class="breadcrumb-current">@breadcrumbs[i]</span>
                    }
                }
            </nav>
        }
        else
        {
            <h2 class="cv-navbar-heading" title="@pageTitle">@pageTitle</h2>
        }
    </div>

    @* Search *@
    <div class="cv-navbar-search">
        <button class="cv-search-trigger" type="button" onclick="if(window.CampusVault && window.CampusVault.openSearch){window.CampusVault.openSearch();}" aria-label="Search classrooms, tasks, documents, materials (Ctrl+K)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span>Search classrooms, tasks, documents, materials...</span>
            <kbd>Ctrl+K</kbd>
        </button>
    </div>

    @* User profile dropdown (Notification bell removed per requirements) *@
    <div class="cv-dropdown" style="position:relative;margin-left:auto;">
        <button type="button" class="cv-navbar-user" id="userMenuBtn" data-dropdown="userDropdown" aria-haspopup="true" aria-expanded="false" title="Account profile &amp; settings">
            <span class="user-name">@userName</span>
            <div class="user-avatar">@userInitials</div>
            <svg class="user-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="cv-dropdown-menu cv-user-dropdown-menu" id="userDropdown" role="menu" aria-labelledby="userMenuBtn">
            <div class="cv-dropdown-user-header" style="padding:12px 16px;border-bottom:1px solid var(--cv-border);background:var(--cv-bg-alt);border-radius:var(--radius-lg) var(--radius-lg) 0 0;">
                <div style="font-weight:600;font-size:14px;color:var(--cv-navy);line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@userName">@userName</div>
                @if (!string.IsNullOrEmpty(userEmail))
                {
                    <div style="font-size:12px;color:var(--cv-slate);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@userEmail">@userEmail</div>
                }
                <div style="margin-top:6px;">
                    <span class="cv-badge" style="background:var(--cv-indigo-pale);color:var(--cv-indigo);font-size:11px;font-weight:600;padding:2px 8px;border-radius:12px;">@userRole</span>
                </div>
            </div>
            <div style="padding:6px;">
                <a href="@profileUrl" class="cv-dropdown-item" role="menuitem">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <span>My Profile</span>
                </a>
                <a href="@profileUrl" class="cv-dropdown-item" role="menuitem">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                    <span>Account Settings</span>
                </a>
                <div class="cv-dropdown-divider" style="margin:4px 0;"></div>
                <a href="@Url.Action("Logout", "Account")" class="cv-dropdown-item danger" role="menuitem">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    <span>Logout</span>
                </a>
            </div>
        </div>
    </div>
</header>
